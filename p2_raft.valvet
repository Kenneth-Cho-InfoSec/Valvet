// papers/p2_raft.valvet
// Raft consensus after Ongaro & Ousterhout ("In Search of an
// Understandable Consensus Algorithm", 2014), following
// papers/p2_raft.fs (Flotten: RequestVote / AppendEntries rules, terms,
// voted-for, log matching, commit index). No network or threads in Valvet:
// a deterministic 3-node cluster stepped by a scripted driver (timeouts,
// vote grants, entry replication, leader death, re-election), printing the
// trace. Mirrored by papers/p2_raft_ref.py with identical rules.

struct Entry { term: Int64, cmd: Int64 }

struct Node { id: Int64, state: Int64, term: Int64, voted: Int64, log: Vec<Entry>, commit: Int64, alive: Int64 }

fun mk_node(id: Int64): Node {
    var log: Vec<Entry> = vec![];
    Node { id: id, state: 0 as Int64, term: 0 as Int64, voted: (0 as Int64) - (1 as Int64), log: log, commit: (0 as Int64) - (1 as Int64), alive: 1 as Int64 }
}

fun log_len(n: &Node): Int64 {
    (*n).log.len()
}

fun log_term(n: &Node, i: Int64): Int64 {
    if (i < (0 as Int64)) {
        return (0 as Int64) - (1 as Int64)
    }
    (*n).log[i].term
}

// RequestVote RPC: candidate c asks voter v. Returns grant (1/0); updates v.
struct VoteOut { v: Node, grant: Int64 }

fun req_vote(v: Node, cterm: Int64, cid: Int64, clast: Int64, clastterm: Int64): VoteOut {
    if (v.alive == (0 as Int64)) {
        VoteOut { v: v, grant: 0 as Int64 }
    } else {
        req_vote_live(v, cterm, cid, clast, clastterm)
    }
}

fun req_vote_live(v: Node, cterm: Int64, cid: Int64, clast: Int64, clastterm: Int64): VoteOut {
    if (cterm < v.term) {
        VoteOut { v: v, grant: 0 as Int64 }
    } else {
        req_vote_tally(v, cterm, cid, clast, clastterm)
    }
}

fun req_vote_tally(v: Node, cterm: Int64, cid: Int64, clast: Int64, clastterm: Int64): VoteOut {
    var vv = v;
    if (cterm > vv.term) {
        vv.term = cterm;
        vv.state = 0 as Int64;
        vv.voted = (0 as Int64) - (1 as Int64);
    }
    val vlast = log_len(&vv) - (1 as Int64);
    val vlastterm = log_term(&vv, vlast);
    val uptodate = if (clastterm > vlastterm) {
        1 as Int64
    } else {
        if (clastterm == vlastterm && clast >= vlast) { 1 as Int64 } else { 0 as Int64 }
    };
    if ((vv.voted == (0 as Int64) - (1 as Int64) || vv.voted == cid) && uptodate == (1 as Int64)) {
        vv.voted = cid;
        VoteOut { v: vv, grant: 1 as Int64 }
    } else {
        VoteOut { v: vv, grant: 0 as Int64 }
    }
}

struct AppOut { v: Node, ok: Int64 }

// AppendEntries RPC: leader entries (here: whole suffix from prev+1).
fun app_entries(v: Node, lterm: Int64, lid: Int64, prev: Int64, prevterm: Int64, ents: Vec<Entry>, lcommit: Int64): AppOut {
    if (v.alive == (0 as Int64)) {
        AppOut { v: v, ok: 0 as Int64 }
    } else {
        app_live(v, lterm, lid, prev, prevterm, ents, lcommit)
    }
}

fun app_live(v: Node, lterm: Int64, lid: Int64, prev: Int64, prevterm: Int64, ents: Vec<Entry>, lcommit: Int64): AppOut {
    if (lterm < v.term) {
        AppOut { v: v, ok: 0 as Int64 }
    } else {
        app_apply(v, lterm, lid, prev, prevterm, ents, lcommit)
    }
}

fun app_apply(v: Node, lterm: Int64, lid: Int64, prev: Int64, prevterm: Int64, ents: Vec<Entry>, lcommit: Int64): AppOut {
    var vv = v;
    vv.term = lterm;
    vv.state = 0 as Int64;
    if (prev >= (0 as Int64)) {
        if (log_len(&vv) <= prev || log_term(&vv, prev) != prevterm) {
            AppOut { v: vv, ok: 0 as Int64 }
        } else {
            app_finish(vv, prev, lcommit, ents)
        }
    } else {
        app_finish(vv, prev, lcommit, ents)
    }
}

fun app_finish(vv0: Node, prev: Int64, lcommit: Int64, ents: Vec<Entry>): AppOut {
    // truncate conflicting suffix, append new entries
    var vv = vv0;
    var nl: Vec<Entry> = vec![];
    var i = 0 as Int64;
    while (i < prev + (1 as Int64) && i < vv.log.len()) {
        nl.push(vv.log[i]);
        i = i + (1 as Int64);
    }
    i = 0 as Int64;
    while (i < ents.len()) {
        nl.push(ents[i]);
        i = i + (1 as Int64);
    }
    vv.log = nl;
    if (lcommit > vv.commit) {
        vv.commit = lcommit;
    }
    AppOut { v: vv, ok: 1 as Int64 }
}

fun main() {
    var n0 = mk_node(0 as Int64);
    var n1 = mk_node(1 as Int64);
    var n2 = mk_node(2 as Int64);
    println(n0.term);
    // timeout on node 0: candidate term 1, last (idx -1, term -1)
    n0.state = 1 as Int64;
    n0.term = 1 as Int64;
    n0.voted = 0 as Int64;
    val r1 = req_vote(n1, 1 as Int64, 0 as Int64, (0 as Int64) - (1 as Int64), (0 as Int64) - (1 as Int64));
    val r1_grant = r1.grant;
    n1 = r1.v;
    val r2 = req_vote(n2, 1 as Int64, 0 as Int64, (0 as Int64) - (1 as Int64), (0 as Int64) - (1 as Int64));
    val r2_grant = r2.grant;
    n2 = r2.v;
    println(r1_grant + r2_grant);
    if (r1_grant + r2_grant >= (2 as Int64)) {
        n0.state = 2 as Int64;
    }
    println(n0.state);
    // leader appends 3 client entries (term 1, cmds 11/22/33), replicates
    var e1: Vec<Entry> = vec![];
    e1.push(Entry { term: 1 as Int64, cmd: 11 as Int64 });
    n0.log = e1;
    val a1 = app_entries(n1, 1 as Int64, 0 as Int64, (0 as Int64) - (1 as Int64), (0 as Int64) - (1 as Int64), n0.log.clone(), (0 as Int64) - (1 as Int64));
    val a1_ok = a1.ok;
    n1 = a1.v;
    val a2 = app_entries(n2, 1 as Int64, 0 as Int64, (0 as Int64) - (1 as Int64), (0 as Int64) - (1 as Int64), n0.log.clone(), (0 as Int64) - (1 as Int64));
    val a2_ok = a2.ok;
    n2 = a2.v;
    var e2: Vec<Entry> = vec![];
    e2.push(Entry { term: 1 as Int64, cmd: 11 as Int64 });
    e2.push(Entry { term: 1 as Int64, cmd: 22 as Int64 });
    e2.push(Entry { term: 1 as Int64, cmd: 33 as Int64 });
    n0.log = e2.clone();
    var e2s: Vec<Entry> = vec![];
    e2s.push(Entry { term: 1 as Int64, cmd: 22 as Int64 });
    e2s.push(Entry { term: 1 as Int64, cmd: 33 as Int64 });
    val b1 = app_entries(n1, 1 as Int64, 0 as Int64, 0 as Int64, 1 as Int64, e2s, (0 as Int64) - (1 as Int64));
    val b1_ok = b1.ok;
    n1 = b1.v;
    var e3s: Vec<Entry> = vec![];
    e3s.push(Entry { term: 1 as Int64, cmd: 22 as Int64 });
    e3s.push(Entry { term: 1 as Int64, cmd: 33 as Int64 });
    val b2 = app_entries(n2, 1 as Int64, 0 as Int64, 0 as Int64, 1 as Int64, e3s, (0 as Int64) - (1 as Int64));
    val b2_ok = b2.ok;
    n2 = b2.v;
    println(a1_ok + b1_ok + a2_ok + b2_ok);
    // leader commits idx 2 (majority replicated), broadcasts commit
    n0.commit = 2 as Int64;
    var ec: Vec<Entry> = vec![];
    val c1 = app_entries(n1, 1 as Int64, 0 as Int64, 2 as Int64, 1 as Int64, ec, 2 as Int64);
    val c1_ok = c1.ok;
    n1 = c1.v;
    var ec2: Vec<Entry> = vec![];
    val c2 = app_entries(n2, 1 as Int64, 0 as Int64, 2 as Int64, 1 as Int64, ec2, 2 as Int64);
    val c2_ok = c2.ok;
    n2 = c2.v;
    println(n1.commit + n2.commit);
    // leader 0 dies; timeout on node 1: term 2 election (last idx 2 term 1)
    n0.alive = 0 as Int64;
    n1.state = 1 as Int64;
    n1.term = 2 as Int64;
    n1.voted = 1 as Int64;
    val s2 = req_vote(n2, 2 as Int64, 1 as Int64, 2 as Int64, 1 as Int64);
    val s2_grant = s2.grant;
    n2 = s2.v;
    println(s2_grant);
    // node 0 (dead) must not grant
    val s0 = req_vote(n0, 2 as Int64, 1 as Int64, 2 as Int64, 1 as Int64);
    val s0_grant = s0.grant;
    n0 = s0.v;
    println(s0_grant);
    if (s2_grant >= (1 as Int64)) {
        n1.state = 2 as Int64;
    }
    println(n1.state);
    // final: live logs identical?
    val same = if (n1.log.len() == n2.log.len() && n1.log.len() == (3 as Int64)) {
        if (n1.log[0 as Int64].cmd == n2.log[0 as Int64].cmd && n1.log[2 as Int64].cmd == n2.log[2 as Int64].cmd) { 1 as Int64 } else { 0 as Int64 }
    } else {
        0 as Int64
    };
    println(same);
}
