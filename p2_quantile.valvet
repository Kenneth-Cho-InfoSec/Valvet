// Hyndman & Fan (1996), "Sample Quantiles in Statistical Packages",
// ported from papers/p2_quantile.fs (FSharp.Stats, 557 lines).
// H&F Type mapping to the F# names:
//   kind 1 = H&F Type 1 = F# empiricalInvCdf (inverse ECDF)
//   kind 2 = H&F Type 2 = F# empiricalInvCdfAverage (averaged ECDF)
//   kind 7 = H&F Type 7 = F# mode (R default)
// Deviations from the F# (all disclosed):
// - Fixed dataset of 25 values below instead of caller-supplied data.
// - Own insertion sort on a cloned copy (Valvet has no sort; F# uses
//   quickSelectInPlace, same order statistics on the same multiset).
// - Own ceil for positive floats via `as` truncation (stdlib has no
//   ceil/floor); all ceiled quantities here are positive so truncation
//   is floor. Only + - * / and comparisons on floats otherwise.
// - kind is an Int64 dispatch (1/2/7); Valvet has no function values.
// - Endpoint semantics mirror F# quantileHelper: q=0 -> min, q=1 -> max,
//   out-of-range/empty -> NaN.

fun insertion_sort(v: Vec<Float64>): Vec<Float64> {
    var a = v
    var i = 1 as Int64
    while (i < a.len()) {
        val key = a[i]
        var j = i - (1 as Int64)
        while (j >= (0 as Int64) && a[j] > key) {
            a[j + (1 as Int64)] = a[j]
            j = j - (1 as Int64)
        }
        a[j + (1 as Int64)] = key
        i = i + (1 as Int64)
    }
    a
}

// Ceiling for positive x (truncation `as` is floor for x > 0).
fun ceil_idx(x: Float64): Int64 {
    val t = x as Int64
    if ((t as Float64) == x) { t } else { t + (1 as Int64) }
}

fun vec_min(s: &Vec<Float64>): Float64 {
    var best = (*s)[0]
    var i = 1 as Int64
    while (i < (*s).len()) {
        if ((*s)[i] < best) {
            best = (*s)[i]
        }
        i = i + (1 as Int64)
    }
    best
}

fun vec_max(s: &Vec<Float64>): Float64 {
    var best = (*s)[0]
    var i = 1 as Int64
    while (i < (*s).len()) {
        if ((*s)[i] > best) {
            best = (*s)[i]
        }
        i = i + (1 as Int64)
    }
    best
}

// F# quantileHelper + OfSorted definitions, 0-based indexing:
// Type 1: s[ceil(n*q)-1]; Type 2: (s[ceil(n*q)-1]+s[floor(n*q)])/2;
// Type 7: h=(n-1)*q+1, s[h'-1]+(h-h')*(s[h']-s[h'-1]).
fun quantile(data: &Vec<Float64>, p: Float64, kind: Int64): Float64 {
    val n = (*data).len()
    if (n == (0 as Int64)) {
        return 0.0 / 0.0;
    }
    if (p < 0.0 || p > 1.0) {
        return 0.0 / 0.0;
    }
    if (p == 0.0) {
        return vec_min(data);
    }
    if (p == 1.0) {
        return vec_max(data);
    }
    val s = insertion_sort((*data).clone())
    val nf = n as Float64
    if (kind == (1 as Int64)) {
        return s[ceil_idx(nf * p) - (1 as Int64)];
    }
    if (kind == (2 as Int64)) {
        val nq = nf * p
        val a = s[ceil_idx(nq) - (1 as Int64)]
        val b = s[nq as Int64]
        return (a + b) / 2.0;
    }
    val h = (nf - 1.0) * p + 1.0
    val hp = h as Int64
    val a = s[hp - (1 as Int64)]
    val b = s[hp]
    a + (h - (hp as Float64)) * (b - a)
}

fun main() {
    var data = vec![12.5, 3.1, 7.8, 19.2, 5.5, 8.4, 1.2, 15.6, 9.9, 4.4, 11.1, 6.7, 13.3, 2.8, 17.5, 10.0, 14.2, 0.5, 18.8, 16.1, 7.2, 9.1, 3.9, 20.4]
    val ps = vec![0.0, 0.25, 0.5, 0.75, 1.0]
    var k = 0 as Int64
    val kinds = vec![1 as Int64, 2 as Int64, 7 as Int64]
    while (k < kinds.len()) {
        println("kind=" + to_string(kinds[k]))
        var j = 0 as Int64
        while (j < ps.len()) {
            println("p=" + to_string(ps[j]))
            println(quantile(&data, ps[j], kinds[k]))
            j = j + (1 as Int64)
        }
        k = k + (1 as Int64)
    }
}
