// papers/rbtree.valvet
// Red-black trees after Okasaki ("Red-Black Trees in a Functional Setting",
// JFP 1999): recursive insert with the 4 balance rotations on the return
// path, member lookup, an invariant checker, and inorder traversal.
// Relation to papers/fsharp_map.fs (F# core Map): that implementation is an
// AVL tree (MapTree/mk/rebalance/add keyed on heights); this file ports the
// Okasaki red-black formulation instead (colour-based, 4 cases), as tasked.
//
// Valvet mapping: the persistent tree becomes an arena Vec<Node> threaded
// through functions by value (no user generics/tuples for multi-returns, so
// `Out` carries arena+root); empty is index -1; struct-pattern `match` and
// recursion were verified with tiny probes first. Direct field stores
// through an index (e.g. `(*a)[t].red = ...`) crash the backend, so all
// updates are whole-node read-modify-write (see papers/bug_arena_field_store.valvet).

struct Node { red: Bool, key: Int32, left: Int64, right: Int64 }
struct Out { arena: Vec<Node>, root: Int64 }

fun empty(): Int64 { (0 as Int64) - (1 as Int64) }

fun neg1(): Int64 { (0 as Int64) - (1 as Int64) }

fun mk(a: Vec<Node>, red: Bool, key: Int32, l: Int64, r: Int64): Out {
    var arena = a
    arena.push(Node { red: red, key: key, left: l, right: r })
    val idx = arena.len() - (1 as Int64)
    Out { arena: arena, root: idx }
}

fun getnode(a: &Vec<Node>, t: Int64): Node {
    match ((*a).get(t)) {
        Some(n) -> n,
        None -> Node { red: false, key: 0 - 99999, left: empty(), right: empty() },
    }
}

fun is_red(a: &Vec<Node>, t: Int64): Bool {
    if (t == empty()) { false } else { getnode(a, t).red }
}

fun key_of(a: &Vec<Node>, t: Int64): Int32 {
    getnode(a, t).key
}

fun left_of(a: &Vec<Node>, t: Int64): Int64 {
    getnode(a, t).left
}

fun right_of(a: &Vec<Node>, t: Int64): Int64 {
    getnode(a, t).right
}

fun set_left(a: Vec<Node>, t: Int64, l: Int64): Vec<Node> {
    var arena = a
    val n = getnode(&arena, t)
    arena[t] = Node { red: n.red, key: n.key, left: l, right: n.right }
    arena
}

fun set_right(a: Vec<Node>, t: Int64, r: Int64): Vec<Node> {
    var arena = a
    val n = getnode(&arena, t)
    arena[t] = Node { red: n.red, key: n.key, left: n.left, right: r }
    arena
}

// Balance plan: Okasaki's 4 red-red cases under a black node all rebuild to
// T(R, T(B,kx,a,b), ky, T(B,kz,c,d)); the cases differ only in which keys
// and children fill those slots. `plan` uses `match` over the 4 rotation
// cases and returns plain data (no arena moves: at most one move per
// `match` is accepted, so the single rebuild below owns the arena).
struct Plan { hit: Bool, kx: Int32, a: Int64, b: Int64, ky: Int32, kz: Int32, c: Int64, d: Int64 }

fun noplan(): Plan {
    Plan { hit: false, kx: 0, a: empty(), b: empty(), ky: 0, kz: 0, c: empty(), d: empty() }
}

fun plan(a: &Vec<Node>, t: Int64): Plan {
    val n = getnode(a, t)
    if (n.red) {
        noplan()
    } else {
        // All four patterns are parallel: each side is classified on its own.
        // (Checking the right side only when the left is black misses a
        // right-side violation under a benign red left child.)
        val lt = if (is_red(a, n.left)) {
            val ln = getnode(a, n.left)
            if (is_red(a, ln.left)) { 1 } else {
                if (is_red(a, ln.right)) { 2 } else { 0 }
            }
        } else { 0 }
        val rt = if (is_red(a, n.right)) {
            val rn = getnode(a, n.right)
            if (is_red(a, rn.left)) { 3 } else {
                if (is_red(a, rn.right)) { 4 } else { 0 }
            }
        } else { 0 }
        val tag = if (lt == 0) { rt } else { lt }
        match (tag) {
            1 -> {
                val ln = getnode(a, n.left)
                val lln = getnode(a, ln.left)
                Plan { hit: true, kx: lln.key, a: lln.left, b: lln.right, ky: ln.key, kz: n.key, c: ln.right, d: n.right }
            },
            2 -> {
                val ln = getnode(a, n.left)
                val lrn = getnode(a, ln.right)
                Plan { hit: true, kx: ln.key, a: ln.left, b: lrn.left, ky: lrn.key, kz: n.key, c: lrn.right, d: n.right }
            },
            3 -> {
                val rn = getnode(a, n.right)
                val rln = getnode(a, rn.left)
                Plan { hit: true, kx: n.key, a: n.left, b: rln.left, ky: rln.key, kz: rn.key, c: rln.right, d: rn.right }
            },
            4 -> {
                val rn = getnode(a, n.right)
                val rrn = getnode(a, rn.right)
                Plan { hit: true, kx: n.key, a: n.left, b: rn.left, ky: rn.key, kz: rrn.key, c: rrn.left, d: rrn.right }
            },
            _ -> noplan(),
        }
    }
}

fun balance(a: Vec<Node>, t: Int64): Out {
    var arena = a
    if (t == empty()) {
        Out { arena: arena, root: t }
    } else {
        val pl = plan(&arena, t)
        if (pl.hit) {
            val o1 = mk(arena, false, pl.kx, pl.a, pl.b)
            val nl = o1.root
            val o2 = mk(o1.arena, false, pl.kz, pl.c, pl.d)
            val nr = o2.root
            mk(o2.arena, true, pl.ky, nl, nr)
        } else {
            Out { arena: arena, root: t }
        }
    }
}

fun ins(a: Vec<Node>, t: Int64, key: Int32): Out {
    var arena = a
    if (t == empty()) {
        mk(arena, true, key, empty(), empty())
    } else {
        val k = key_of(&arena, t)
        if (key < k) {
            val l = left_of(&arena, t)
            val o = ins(arena, l, key)
            val rt = o.root
            balance(set_left(o.arena, t, rt), t)
        } else {
            if (key > k) {
                val r = right_of(&arena, t)
                val o2 = ins(arena, r, key)
                val rt2 = o2.root
                balance(set_right(o2.arena, t, rt2), t)
            } else {
                Out { arena: arena, root: t }
            }
        }
    }
}

fun blacken(a: Vec<Node>, t: Int64): Vec<Node> {
    var arena = a
    val n = getnode(&arena, t)
    arena[t] = Node { red: false, key: n.key, left: n.left, right: n.right }
    arena
}

fun members(a: &Vec<Node>, t: Int64, key: Int32): Bool {
    if (t == empty()) { false } else {
        val k = key_of(a, t)
        if (key == k) { true } else {
            if (key < k) { members(a, left_of(a, t), key) } else { members(a, right_of(a, t), key) }
        }
    }
}

// Invariant checker: root must be black (checked by caller), no red node
// may have a red child, all root-to-leaf paths share one black height.
// Returns that black height (empty = 0, black node adds 1), or -1 on any
// violation.
fun check(a: &Vec<Node>, t: Int64): Int64 {
    if (t == empty()) { 0 as Int64 } else {
        val n = getnode(a, t)
        val hl = check(a, left_of(a, t))
        val hr = check(a, right_of(a, t))
        if (hl == neg1()) { neg1() } else {
            if (hr == neg1()) { neg1() } else {
                if (hl == hr) {
                    if (n.red) {
                        if (is_red(a, n.left)) { neg1() } else {
                            if (is_red(a, n.right)) { neg1() } else { hl }
                        }
                    } else { hl + (1 as Int64) }
                } else { neg1() }
            }
        }
    }
}

fun inorder(acc: Vec<Int32>, a: &Vec<Node>, t: Int64): Vec<Int32> {
    var v = acc
    if (t == empty()) { v } else {
        v = inorder(v, a, left_of(a, t))
        v.push(key_of(a, t))
        v = inorder(v, a, right_of(a, t))
        v
    }
}

fun key_at(keys: &Vec<Int32>, i: Int64): Int32 {
    match ((*keys).get(i)) {
        Some(k) -> k,
        None -> 0 - 99999,
    }
}

fun main() {
    var keys: Vec<Int32> = vec![]
    var i = 0
    while (i < 201) {
        keys.push(i)
        i = i + 1
    }
    // Deterministic pseudo-shuffle: fixed Fisher-Yates over a hardcoded
    // LCG (mod 2^31; all state fits Int64, so no wrap is involved).
    var state = 12345 as Int64
    var j = 200 as Int64
    while (j > (0 as Int64)) {
        state = (state * (1103515245 as Int64) + (12345 as Int64)) % (2147483648 as Int64)
        val k = state % (j + (1 as Int64))
        val tmp = keys[j]
        keys[j] = keys[k]
        keys[k] = tmp
        j = j - (1 as Int64)
    }
    var arena: Vec<Node> = vec![]
    var root = empty()
    var idx = 0 as Int64
    while (idx < keys.len()) {
        val o = ins(arena, root, key_at(&keys, idx))
        // Textbook `insert` blackens after EVERY key (ins needs a
        // black-rooted input); a single blacken at the end is wrong.
        root = o.root
        arena = blacken(o.arena, root)
        idx = idx + (1 as Int64)
    }
    val start: Vec<Int32> = vec![]
    val order = inorder(start, &arena, root)
    println("insertions=" + to_string(keys.len()))
    println(order)
    println("nodes=" + to_string(arena.len()))
    println("root_key=" + to_string(key_of(&arena, root)))
    val bh = check(&arena, root)
    println("black_height=" + to_string(bh))
    val rb = is_red(&arena, root)
    val ok = if (rb) { false } else { bh != neg1() }
    println("invariants_ok=" + to_string(ok))
    println("member_0=" + to_string(members(&arena, root, 0)))
    println("member_200=" + to_string(members(&arena, root, 200)))
    println("member_201=" + to_string(members(&arena, root, 201)))
    println("member_42=" + to_string(members(&arena, root, 42)))
}
