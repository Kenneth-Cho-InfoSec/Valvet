// papers/p2_anova.valvet
// One-way ANOVA after Fisher ("Statistical Methods for Research Workers",
// 1925), following papers/p2_anova.fs (FSharp.Stats Testing: group means,
// SSB/SSW, F statistic = (SSB/dfb)/(SSW/dfw)).
// Mirrored by papers/p2_anova_ref.py with identical op order.

fun mean(v: &Vec<Float64>): Float64 {
    var s = 0.0;
    var i = 0 as Int64;
    while (i < (*v).len()) {
        s = s + (*v)[i];
        i = i + (1 as Int64);
    }
    s / ((*v).len() as Float64)
}

fun main() {
    val g1: Vec<Float64> = vec![6.0, 8.0, 4.0, 5.0, 3.0, 4.0];
    val g2: Vec<Float64> = vec![8.0, 12.0, 9.0, 11.0, 6.0, 8.0];
    val g3: Vec<Float64> = vec![13.0, 9.0, 11.0, 8.0, 7.0, 12.0];
    val n1 = g1.len() as Float64;
    val n2 = g2.len() as Float64;
    val n3 = g3.len() as Float64;
    val m1 = mean(&g1);
    val m2 = mean(&g2);
    val m3 = mean(&g3);
    val n = n1 + n2 + n3;
    val grand = (n1 * m1 + n2 * m2 + n3 * m3) / n;
    // between-group sum of squares
    val ssb = n1 * (m1 - grand) * (m1 - grand) + n2 * (m2 - grand) * (m2 - grand) + n3 * (m3 - grand) * (m3 - grand);
    // within-group sum of squares
    var ssw = 0.0;
    var i = 0 as Int64;
    while (i < g1.len()) {
        val d = g1[i] - m1;
        ssw = ssw + d * d;
        i = i + (1 as Int64);
    }
    i = 0 as Int64;
    while (i < g2.len()) {
        val d = g2[i] - m2;
        ssw = ssw + d * d;
        i = i + (1 as Int64);
    }
    i = 0 as Int64;
    while (i < g3.len()) {
        val d = g3[i] - m3;
        ssw = ssw + d * d;
        i = i + (1 as Int64);
    }
    val dfb = 3.0 - 1.0;
    val dfw = n - 3.0;
    val f = (ssb / dfb) / (ssw / dfw);
    println(m1);
    println(m2);
    println(m3);
    println(grand);
    println(ssb);
    println(ssw);
    println(f);
}
