// Needleman-Wunsch (1970) GLOBAL pairwise alignment, after BioFSharp's
// PairwiseAlignment.Global.NeedlemanWunsch (papers/biofsharp_alignment.fs).
//
// The F# version uses an affine gap model (3-submatrix cells with Open /
// Continuation costs). This port uses the classic linear-gap NW formulation
// with match +2, mismatch -1, gap -2: a single (m+1)x(n+1) score table filled
// by dp[i][j] = max(dp[i-1][j-1]+sub, dp[i-1][j]+gap, dp[i][j-1]+gap), then a
// recompute-walk traceback (diagonal preferred, then up, then left).
//
// Valvet strings have no character access, so residues are integer-encoded:
// A=0 C=1 G=2 T=3 (U in GCATGCU is encoded as 3, i.e. treated as T), and
// gaps in the aligned rows are encoded as -1. Only integer arithmetic is
// used, so results match the Python reference bit-for-bit.

struct AlignResult {
    score: Int64,
    r1: Vec<Int32>,
    r2: Vec<Int32>
}

fun sub_score(x: Int32, y: Int32): Int64 {
    if (x == y) {
        return 2 as Int64;
    }
    return 0 as Int64 - (1 as Int64);
}

fun nw(a: Vec<Int32>, b: Vec<Int32>): AlignResult {
    val m = a.len();
    val n = b.len();
    val gap = 0 as Int64 - (2 as Int64);
    var dp: Vec<Vec<Int64>> = vec![];
    var r0: Vec<Int64> = vec![];
    var j = 0 as Int64;
    while (j <= n) {
        r0.push(gap * j);
        j = j + (1 as Int64);
    }
    dp.push(r0);
    var i = 1 as Int64;
    while (i <= m) {
        val prev: Vec<Int64> = dp[i - (1 as Int64)].clone();
        var row: Vec<Int64> = vec![];
        row.push(gap * i);
        var jj = 1 as Int64;
        while (jj <= n) {
            val s = sub_score(a[i - (1 as Int64)], b[jj - (1 as Int64)]);
            val dg = prev[jj - (1 as Int64)] + s;
            val up = prev[jj] + gap;
            val lf = row[jj - (1 as Int64)] + gap;
            var best = dg;
            if (up > best) {
                best = up;
            }
            if (lf > best) {
                best = lf;
            }
            row.push(best);
            jj = jj + (1 as Int64);
        }
        dp.push(row);
        i = i + (1 as Int64);
    }
    val score = dp[m][n];
    // Traceback by recomputing candidate scores; tie-break diagonal, up, left.
    var al1: Vec<Int32> = vec![];
    var al2: Vec<Int32> = vec![];
    var ii = m;
    var kk = n;
    while (ii > (0 as Int64) || kk > (0 as Int64)) {
        if (ii > (0 as Int64) && kk > (0 as Int64)) {
            val cur = dp[ii][kk];
            val s = sub_score(a[ii - (1 as Int64)], b[kk - (1 as Int64)]);
            val dg = dp[ii - (1 as Int64)][kk - (1 as Int64)] + s;
            if (cur == dg) {
                al1.push(a[ii - (1 as Int64)]);
                al2.push(b[kk - (1 as Int64)]);
                ii = ii - (1 as Int64);
                kk = kk - (1 as Int64);
            } else {
                val up = dp[ii - (1 as Int64)][kk] + gap;
                if (cur == up) {
                    al1.push(a[ii - (1 as Int64)]);
                    al2.push(0 - 1);
                    ii = ii - (1 as Int64);
                } else {
                    al1.push(0 - 1);
                    al2.push(b[kk - (1 as Int64)]);
                    kk = kk - (1 as Int64);
                }
            }
        } else {
            if (ii > (0 as Int64)) {
                al1.push(a[ii - (1 as Int64)]);
                al2.push(0 - 1);
                ii = ii - (1 as Int64);
            } else {
                al1.push(0 - 1);
                al2.push(b[kk - (1 as Int64)]);
                kk = kk - (1 as Int64);
            }
        }
    }
    // Rows were built tail-first; reverse them.
    var o1: Vec<Int32> = vec![];
    var o2: Vec<Int32> = vec![];
    var t = al1.len();
    while (t > (0 as Int64)) {
        t = t - (1 as Int64);
        o1.push(al1[t]);
        o2.push(al2[t]);
    }
    AlignResult { score: score, r1: o1, r2: o2 }
}

fun print_row(r: &Vec<Int32>) {
    println((*r).len());
    var i = 0 as Int64;
    while (i < (*r).len()) {
        println((*r)[i]);
        i = i + (1 as Int64);
    }
}

fun main() {
    // Case 1: classic GATTACA vs GCATGCU (U encoded as 3 = T).
    val r1 = nw(vec![2, 0, 3, 3, 0, 1, 0], vec![2, 1, 0, 3, 2, 1, 3]);
    println(r1.score);
    print_row(&r1.r1);
    print_row(&r1.r2);
    // Case 2: perfect 4-match ACGT vs ACGT.
    val r2 = nw(vec![0, 1, 2, 3], vec![0, 1, 2, 3]);
    println(r2.score);
    print_row(&r2.r1);
    print_row(&r2.r2);
    // Case 3: single mismatch A vs C.
    val r3 = nw(vec![0], vec![1]);
    println(r3.score);
    print_row(&r3.r1);
    print_row(&r3.r2);
    // Case 4: empty vs AC.
    val e: Vec<Int32> = vec![];
    val r4 = nw(e, vec![0, 1]);
    println(r4.score);
    print_row(&r4.r1);
    print_row(&r4.r2);
}
