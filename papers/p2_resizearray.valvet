// Resizable array after Brodnik, Carlsson, Demaine, Munro, Sedgewick
// ("Resizable Arrays in Optimal Time and Space", WADS 1999), read via
// papers/p2_resizearray.fs (FSharpx ResizeArray: get/set/add/len over a
// growable store; here the .NET backing vector is replaced by the paper's
// block structure with doubling block sizes).
//
// Layout: block k holds 2^k elements, so m blocks hold 2^m - 1 elements.
// An index is located by a subtraction loop (i -= 2^k while i >= 2^k).
// push appends to the last block, allocating block k (size 2^k) exactly
// when the previous blocks are full.
//
// Valvet notes: first-order free functions over &RArray / &mut RArray (no
// methods on user types). A mutating call through a nested index
// (`a[i].push(v)`) silently drops the write and nested index assignment is
// rejected (see papers/bug_nested_push.valvet), so push/set clone the
// target block, modify the clone, and write it back with a single-index
// store. All integer state is Int64. Only + - * / and comparisons.

struct RArray {
    blocks: Vec<Vec<Int64>>,
    len: Int64
}

struct Loc {
    bi: Int64,
    off: Int64
}

// Capacity of block k: 2^k.
fun bsize(k: Int64): Int64 {
    var s = 1 as Int64;
    var i = 0 as Int64;
    while (i < k) {
        s = s * (2 as Int64);
        i = i + (1 as Int64);
    }
    s
}

fun nblocks(a: &RArray): Int64 {
    (*a).blocks.len()
}

fun rlen(a: &RArray): Int64 {
    // Sum of block lengths (a direct `(*a).len` read would move the field
    // out of the borrow, E0301; the stored field is maintained by rpush).
    var n = 0 as Int64;
    var k = 0 as Int64;
    while (k < (*a).blocks.len()) {
        n = n + (*a).blocks[k].len();
        k = k + (1 as Int64);
    }
    n
}

// Subtraction-loop location: strip whole leading blocks from idx.
fun rlocate(idx: Int64): Loc {
    var i = idx;
    var k = 0 as Int64;
    var s = 1 as Int64;
    while (i >= s) {
        i = i - s;
        k = k + (1 as Int64);
        s = s * (2 as Int64);
    }
    Loc { bi: k, off: i }
}

fun rpush(a: &mut RArray, v: Int64) {
    val old = rlen(&*a);
    if ((*a).blocks.len() == (0 as Int64)) {
        var nb: Vec<Int64> = vec![];
        (*a).blocks.push(nb);
    } else {
        val last = (*a).blocks.len() - (1 as Int64);
        val full = (*a).blocks[last].len() == bsize(last);
        if (full) {
            var nb2: Vec<Int64> = vec![];
            (*a).blocks.push(nb2);
        }
    }
    val dst = (*a).blocks.len() - (1 as Int64);
    var inner = (*a).blocks[dst].clone();
    inner.push(v);
    (*a).blocks[dst] = inner;
    (*a).len = old + (1 as Int64);
}

fun rget(a: &RArray, idx: Int64): Int64 {
    val l = rlocate(idx);
    (*a).blocks[l.bi][l.off]
}

fun rset(a: &mut RArray, idx: Int64, v: Int64) {
    val l = rlocate(idx);
    var inner = (*a).blocks[l.bi].clone();
    inner[l.off] = v;
    (*a).blocks[l.bi] = inner;
}

fun main() {
    var eb: Vec<Vec<Int64>> = vec![];
    var a = RArray { blocks: eb, len: 0 as Int64 };
    // Push 0..199, reporting each block allocation as it happens.
    var i = 0 as Int64;
    while (i < (200 as Int64)) {
        val before = nblocks(&a);
        rpush(&mut a, i);
        val after = nblocks(&a);
        if (after != before) {
            println("newblock");
            println(after - (1 as Int64));
            println(bsize(after - (1 as Int64)));
        }
        i = i + (1 as Int64);
    }
    println("len");
    println(rlen(&a));
    println("nblocks");
    println(nblocks(&a));
    // Samples across block boundaries (blocks hold 1,2,4,8,16,32,64,128).
    println("gets");
    println(rget(&a, 0 as Int64));
    println(rget(&a, 1 as Int64));
    println(rget(&a, 2 as Int64));
    println(rget(&a, 63 as Int64));
    println(rget(&a, 64 as Int64));
    println(rget(&a, 100 as Int64));
    println(rget(&a, 127 as Int64));
    println(rget(&a, 128 as Int64));
    println(rget(&a, 199 as Int64));
    // Full verification: value at j must equal j; count mismatches.
    var err = 0 as Int64;
    var j = 0 as Int64;
    while (j < (200 as Int64)) {
        if (rget(&a, j) != j) {
            err = err + (1 as Int64);
        }
        j = j + (1 as Int64);
    }
    println("errors");
    println(err);
    var sum = 0 as Int64;
    var t = 0 as Int64;
    while (t < (200 as Int64)) {
        sum = sum + rget(&a, t);
        t = t + (1 as Int64);
    }
    println("sum");
    println(sum);
    // Overwrite the first, a middle, and the last element.
    rset(&mut a, 0 as Int64, 1000 as Int64);
    rset(&mut a, 100 as Int64, 2000 as Int64);
    rset(&mut a, 199 as Int64, 3000 as Int64);
    println("gets2");
    println(rget(&a, 0 as Int64));
    println(rget(&a, 100 as Int64));
    println(rget(&a, 199 as Int64));
    var sum2 = 0 as Int64;
    var u = 0 as Int64;
    while (u < (200 as Int64)) {
        sum2 = sum2 + rget(&a, u);
        u = u + (1 as Int64);
    }
    println("sum2");
    println(sum2);
    var err2 = 0 as Int64;
    var w = 0 as Int64;
    while (w < (200 as Int64)) {
        val want = if (w == (0 as Int64)) {
            1000 as Int64
        } else {
            if (w == (100 as Int64)) {
                2000 as Int64
            } else {
                if (w == (199 as Int64)) {
                    3000 as Int64
                } else {
                    w
                }
            }
        };
        if (rget(&a, w) != want) {
            err2 = err2 + (1 as Int64);
        }
        w = w + (1 as Int64);
    }
    println("errors2");
    println(err2);
}
