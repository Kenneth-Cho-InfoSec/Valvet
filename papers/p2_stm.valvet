// papers/p2_stm.valvet
// Composable memory transactions after Harris, Marlow, Peyton Jones,
// Herlihy ("Composable Memory Transactions", PPoPP 2005), following
// papers/p2_stm.fs (FSharpx STM monad: TVar, transaction log with
// read-set/write-set, validate-then-commit, retry/orElse).
//
// Valvet mapping (first-order, single-threaded): TVars are Vec<Int64>
// cells with version stamps; a transaction is an explicit Vec<Int64>
// opcode script (op, var, value): 0=read, 1=write, 2=require-nonzero
// (else RETRY), 3=require-eq(var, value) (else RETRY). atomic() runs the
// script against a private log, validates the read-set, commits or
// reports retry — with all-or-nothing writes. orElse tries a primary
// script, falling back to a secondary on retry. A scripted interleaving
// demonstrates isolation (disclosed: no threads; conflicts are scripted).
// Mirrored by papers/p2_stm_ref.py.

// vars: parallel value + version vecs
struct Store { vals: Vec<Int64>, vers: Vec<Int64> }

struct Log { rvars: Vec<Int64>, rvals: Vec<Int64>, rvers: Vec<Int64>, wvars: Vec<Int64>, wvals: Vec<Int64> }

fun new_log(): Log {
    var a: Vec<Int64> = vec![];
    var b: Vec<Int64> = vec![];
    var c: Vec<Int64> = vec![];
    var d: Vec<Int64> = vec![];
    var e: Vec<Int64> = vec![];
    Log { rvars: a, rvals: b, rvers: c, wvars: d, wvals: e }
}

fun log_find(v: &Vec<Int64>, x: Int64): Int64 {
    var i = 0 as Int64;
    while (i < (*v).len()) {
        if ((*v)[i] == x) {
            return i
        }
        i = i + (1 as Int64);
    }
    (0 as Int64) - (1 as Int64)
}

// read var through the log (read-your-writes + read-set record)
struct ReadOut { log: Log, val_: Int64 }

fun log_read(s: &Store, l: Log, v: Int64): ReadOut {
    val wi = log_find(&l.wvars, v);
    if (wi >= (0 as Int64)) {
        val vv = l.wvals[wi];
        ReadOut { log: l, val_: vv }
    } else {
        log_read_miss(s, l, v)
    }
}

fun log_read_miss(s: &Store, l: Log, v: Int64): ReadOut {
    val ri = log_find(&l.rvars, v);
    if (ri >= (0 as Int64)) {
        val rv = l.rvals[ri];
        ReadOut { log: l, val_: rv }
    } else {
        log_read_fill(s, l, v)
    }
}

fun log_read_fill(s: &Store, l: Log, v: Int64): ReadOut {
    var nl = l;
    nl.rvars.push(v);
    nl.rvals.push((*s).vals[v]);
    nl.rvers.push((*s).vers[v]);
    ReadOut { log: nl, val_: (*s).vals[v] }
}

fun log_write(l: Log, v: Int64, x: Int64): Log {
    var nl = l;
    val wi = log_find(&nl.wvars, v);
    if (wi >= (0 as Int64)) {
        nl.wvals = vec_set(nl.wvals, wi, x);
    } else {
        nl.wvars.push(v);
        nl.wvals.push(x);
    }
    nl
}

fun vec_set(v: Vec<Int64>, at: Int64, x: Int64): Vec<Int64> {
    var out: Vec<Int64> = vec![];
    var i = 0 as Int64;
    while (i < v.len()) {
        if (i == at) {
            out.push(x)
        } else {
            out.push(v[i])
        }
        i = i + (1 as Int64);
    }
    out
}

// validate read-set against store versions
fun log_valid(s: &Store, l: &Log): Bool {
    var i = 0 as Int64;
    while (i < (*l).rvars.len()) {
        if ((*s).vers[(*l).rvars[i]] != (*l).rvers[i]) {
            return false
        }
        i = i + (1 as Int64);
    }
    true
}

// run one op script; returns (ok, new-log). Bitmap ops encoded flat:
// (op, var, value?) with op 0=read(pushes value to `seen`), 1=write,
// 2=require-nonzero(var), 3=require-eq(var,value). Retry = ok false.
struct RunOut { log: Log, ok: Bool, seen: Vec<Int64> }

fun run_script(s: &Store, l: Log, ops: Vec<Int64>): RunOut {
    var log = l;
    var seen: Vec<Int64> = vec![];
    var i = 0 as Int64;
    var ok = true;
    while (i < ops.len() && ok) {
        val op = ops[i];
        if (op == (0 as Int64)) {
            val r = log_read(s, log, ops[i + (1 as Int64)]);
            val rv = r.val_;
            log = r.log;
            seen.push(rv);
            i = i + (2 as Int64);
        } else {
            if (op == (1 as Int64)) {
                log = log_write(log, ops[i + (1 as Int64)], ops[i + (2 as Int64)]);
                i = i + (3 as Int64);
            } else {
                if (op == (2 as Int64)) {
                    val r = log_read(s, log, ops[i + (1 as Int64)]);
                    val rv = r.val_;
                    log = r.log;
                    if (rv == (0 as Int64)) {
                        ok = false;
                    }
                    i = i + (2 as Int64);
                } else {
                    val r = log_read(s, log, ops[i + (1 as Int64)]);
                    val rv = r.val_;
                    log = r.log;
                    if (rv != ops[i + (2 as Int64)]) {
                        ok = false;
                    }
                    i = i + (3 as Int64);
                }
            }
        }
    }
    RunOut { log: log, ok: ok, seen: seen }
}

// atomic: run script on fresh log, validate, commit writes (bump versions).
struct AtomOut { store: Store, ok: Bool, seen: Vec<Int64> }

fun atomic(s: Store, ops: Vec<Int64>): AtomOut {
    val r = run_script(&s, new_log(), ops);
    val rok = r.ok;
    if (!rok) {
        AtomOut { store: s, ok: false, seen: r.seen }
    } else {
        atomic_commit(s, r)
    }
}

fun atomic_commit(s: Store, r: RunOut): AtomOut {
    if (!log_valid(&s, &r.log)) {
        AtomOut { store: s, ok: false, seen: r.seen }
    } else {
        atomic_do_commit(s, r)
    }
}

fun atomic_do_commit(s: Store, r: RunOut): AtomOut {
    // Single-partial-move rule: clone the vectors out (borrow, no moves).
    val wvars = r.log.wvars.clone();
    val wvals = r.log.wvals.clone();
    val seen = r.seen.clone();
    var vals = s.vals.clone();
    var vers = s.vers.clone();
    var i = 0 as Int64;
    while (i < wvars.len()) {
        vals = vec_set(vals, wvars[i], wvals[i]);
        val old = vers[wvars[i]];
        vers = vec_set(vers, wvars[i], old + (1 as Int64));
        i = i + (1 as Int64);
    }
    AtomOut { store: Store { vals: vals, vers: vers }, ok: true, seen: seen }
}

// orElse: primary, else secondary (fresh log).
fun or_else(s: Store, p: Vec<Int64>, q: Vec<Int64>): AtomOut {
    val r = atomic(s, p);
    if (r.ok) {
        r
    } else {
        atomic(r.store, q)
    }
}

fun mk_store(): Store {
    // vars: 0 = balance A (100), 1 = balance B (50), 2 = flag (0)
    var vals: Vec<Int64> = vec![(100 as Int64), (50 as Int64), (0 as Int64)];
    var vers: Vec<Int64> = vec![(0 as Int64), (0 as Int64), (0 as Int64)];
    Store { vals: vals, vers: vers }
}

fun print_store(s: &Store) {
    println((*s).vals[(0 as Int64)]);
    println((*s).vals[(1 as Int64)]);
    println((*s).vals[(2 as Int64)]);
}

fun main() {
    var s = mk_store();
    // 1. atomic increment of A by 10: read A, write A+10.
    // (expressed with concrete values: read, then write literal 110)
    var t1: Vec<Int64> = vec![(0 as Int64), (0 as Int64), (1 as Int64), (0 as Int64), (110 as Int64)];
    val r1 = atomic(s, t1);
    val r1_ok = r1.ok;
    s = r1.store;
    println(r1_ok);
    print_store(&s);
    // 2. transfer 30 A->B atomically: require A==110, write A=80, B=80.
    var t2: Vec<Int64> = vec![
        (3 as Int64), (0 as Int64), (110 as Int64),
        (1 as Int64), (0 as Int64), (80 as Int64),
        (1 as Int64), (1 as Int64), (80 as Int64)
    ];
    val r2 = atomic(s, t2);
    val r2_ok = r2.ok;
    s = r2.store;
    println(r2_ok);
    print_store(&s);
    // 3. overdraft: require A==999 (fails) then write — must abort with
    // state unchanged (all-or-nothing).
    var t3: Vec<Int64> = vec![
        (3 as Int64), (0 as Int64), (999 as Int64),
        (1 as Int64), (0 as Int64), (0 as Int64)
    ];
    val r3 = atomic(s, t3);
    val r3_ok = r3.ok;
    s = r3.store;
    println(r3_ok);
    print_store(&s);
    // 4. orElse: primary waits on flag==1 (retry), secondary sets flag=7.
    var p4: Vec<Int64> = vec![(3 as Int64), (2 as Int64), (1 as Int64)];
    var q4: Vec<Int64> = vec![(1 as Int64), (2 as Int64), (7 as Int64)];
    val r4 = or_else(s, p4, q4);
    val r4_ok = r4.ok;
    s = r4.store;
    println(r4_ok);
    print_store(&s);
    // 5. scripted conflict: build a read log, let an outside writer bump
    // A, then validation must fail (stale snapshot cannot commit).
    var t5: Vec<Int64> = vec![(0 as Int64), (0 as Int64)];
    val r5 = run_script(&s, new_log(), t5);
    var tw: Vec<Int64> = vec![(0 as Int64), (0 as Int64), (1 as Int64), (0 as Int64), (81 as Int64)];
    val w = atomic(s, tw);
    s = w.store;
    println(log_valid(&s, &r5.log));
    println(s.vers[(0 as Int64)]);
}
