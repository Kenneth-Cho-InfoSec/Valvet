// B2: DiffSharp (Baydin / Pearlmutter / Siskind, arXiv:1511.07727) grad API
// (Table 1), forward-mode dual-number concept (the paper's tensor type
// supports forward AD alongside reverse). Source read:
// papers/diffsharp_tensor.fs, selective (forwardDiff/forward-mode
// propagation rules, differentiable-op structure).
//
// Valvet mapping: stdlib/autodiff.valvet provides forward-mode Dual only
// (no closures/function values, so no `grad(f)` operator): the loss is
// written once over Dual, then seeded once per dimension and `.d` read.
// Rosenbrock f(x,y) = (1-x)^2 + 100 (y-x^2)^2 uses only + - * / so results
// match the Python reference bit-for-bit. Gradient descent from
// (-1.2, 1.0), lr 0.001, 2000 iters; prints initial gradient (checked
// against the analytic values in the reference script), final (x, y, f).
import std::autodiff::Dual;
import std::autodiff::dual_const;
import std::autodiff::dual_add;
import std::autodiff::dual_sub;
import std::autodiff::dual_mul;
import std::autodiff::seed;

fun rosen(p: Vec<Dual>): Dual {
    val one = dual_const(1.0);
    val c100 = dual_const(100.0);
    val x = p[0];
    val y = p[1];
    val t1 = dual_sub(one, x);
    val a = dual_mul(t1, t1);
    val xsq = dual_mul(x, x);
    val t2 = dual_sub(y, xsq);
    val b = dual_mul(dual_mul(c100, t2), t2);
    dual_add(a, b)
}

fun rosen_f(x: Float64, y: Float64): Float64 {
    val t1 = 1.0 - x;
    val a = t1 * t1;
    val t2 = y - x * x;
    a + 100.0 * t2 * t2
}

fun main() {
    var w = vec![0.0 - 1.2, 1.0];
    println(rosen(seed(w.clone(), 0 as Int64)).d);
    println(rosen(seed(w.clone(), 1 as Int64)).d);
    var it = 0 as Int64
    while (it < 2000 as Int64) {
        val g0 = rosen(seed(w.clone(), 0 as Int64)).d;
        val g1 = rosen(seed(w.clone(), 1 as Int64)).d;
        w[0] = w[0] - 0.001 * g0;
        w[1] = w[1] - 0.001 * g1;
        it += 1 as Int64
    }
    println(w[0]);
    println(w[1]);
    println(rosen_f(w[0], w[1]));
}
