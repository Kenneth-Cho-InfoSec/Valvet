// B1: Shape inference after Petricek / Syme / Guerra, "Types from Data"
// (PLDI 2016), Section 3. F# Data infers a shape for each sample document
// and folds them with a preferred-shape relation into one shape describing
// all samples. Source read: papers/fsharpdata_jsongenerator.fs (the
// `InferedType` cases Primitive/Record/Collection/Heterogeneous/Null/Top
// with optional flags and multiplicity choice types).
//
// Valvet mapping (first-order, move semantics):
// - `Shape` enum: Int/Float/String/Bool/Null/Record/Array/Any. Recursive
//   data uses an ARENA: `Arena { nodes: Vec<Shape> }`, children are Int64
//   indices (-1 = none), since Valvet has no Box/owned recursion.
// - JSON text parsing is ASSUMED (Valvet strings have no char access, no
//   indexing, no length): sample docs mirroring the paper's people.json
//   example are hand-built as arena values:
//     doc1 = {name: string, age: int}, doc2 = {name: string},
//     doc3 = {name: string, age: float}.
// - Inference works on flat pre-order `ShapeVal` encodings extracted from
//   the arena. This split is forced by Valvet's ownership rule: an owned
//   value cannot be consumed in two exclusive branches (the checker unions
//   moves across `match`/`if` arms, and `&mut` parameters cannot be
//   reborrowed since parameters are immutable bindings). So `merge` takes
//   only shared (`&`, Copy) references plus Int64 positions and returns a
//   freshly built value; every branch builds its own locals.
// - Merge rules (paper Sec. 3, mirrored EXACTLY by shape_infer_ref.py):
//   same primitives -> same; int+float -> float (either order);
//   null+X -> X (null absorbed); missing record field -> optional;
//   common field -> recursive merge, optional if optional on either side;
//   heterogeneous shapes -> Any(options), deduplicated structurally
//   (labelled top type any<s1..sn>); records preferred over Any.
// - Output is plain strings only (no floats), so the differential test
//   compares EXACTLY.

struct Field { name: String, shape: Int64, optional: Bool }

enum Shape {
    SInt,
    SFloat,
    SString,
    SBool,
    SNull,
    SRecord(Vec<Field>),
    SArray(Int64),
    SAny(Vec<Int64>)
}

struct Arena { nodes: Vec<Shape> }

struct AOut { arena: Arena, idx: Int64 }

// Flat pre-order shape value. kinds tags: 0=int 1=float 2=string 3=bool
// 4=null 5=record 6=array 7=any 8=field. aux: record->nfields,
// any->nopts, field->optional(0/1), else 0. names: field name per
// field-header entry, "" elsewhere.
struct ShapeVal { kinds: Vec<Int64>, aux: Vec<Int64>, names: Vec<String> }

fun new_val(): ShapeVal {
    val k: Vec<Int64> = vec![]
    val u: Vec<Int64> = vec![]
    val n: Vec<String> = vec![]
    ShapeVal { kinds: k, aux: u, names: n }
}

fun alloc(a: Arena, n: Shape): AOut {
    var nodes = a.nodes
    nodes.push(n)
    val idx = nodes.len() - 1 as Int64
    AOut { arena: Arena { nodes: nodes }, idx: idx }
}

// ---- leaf builders (shared borrows only; callable from any branch) ----

fun push_tok(o: &mut ShapeVal, k: Int64, u: Int64, nm: String) {
    o.kinds.push(k)
    o.aux.push(u)
    o.names.push(nm)
}

fun vsize(v: &ShapeVal, pos: Int64): Int64 {
    val k: Int64 = v.kinds[pos]
    if (k == 5 as Int64) {
        val n: Int64 = v.aux[pos]
        var c = pos + 1 as Int64
        var f = 0 as Int64
        while (f < n) {
            c = c + 1 as Int64 + vsize(v, c + 1 as Int64)
            f += 1 as Int64
        }
        return c - pos;
    }
    if (k == 6 as Int64) {
        return 1 as Int64 + vsize(v, pos + 1 as Int64);
    }
    if (k == 7 as Int64) {
        val n: Int64 = v.aux[pos]
        var c = pos + 1 as Int64
        var f = 0 as Int64
        while (f < n) {
            c = c + vsize(v, c)
            f += 1 as Int64
        }
        return c - pos;
    }
    if (k == 8 as Int64) {
        return 1 as Int64 + vsize(v, pos + 1 as Int64);
    }
    1 as Int64
}

fun append_into(o: &mut ShapeVal, s: &ShapeVal, pos: Int64) {
    val n = vsize(s, pos)
    var e = pos
    while (e < pos + n) {
        o.kinds.push(s.kinds[e])
        o.aux.push(s.aux[e])
        o.names.push(s.names[e])
        e += 1 as Int64
    }
}

fun prim_val(k: Int64): ShapeVal {
    var o = new_val()
    push_tok(&mut o, k, 0 as Int64, "")
    o
}

fun copy_val(v: &ShapeVal, pos: Int64): ShapeVal {
    var o = new_val()
    append_into(&mut o, v, pos)
    o
}

// ---- pure readers ----

fun find_header(v: &ShapeVal, root: Int64, want: String): Int64 {
    var c = root + 1 as Int64
    var f = 0 as Int64
    val n: Int64 = v.aux[root]
    while (f < n) {
        val nm: String = v.names[c]
        if (nm == want) {
            return c;
        }
        c = c + 1 as Int64 + vsize(v, c + 1 as Int64)
        f += 1 as Int64
    }
    0 as Int64 - 1 as Int64
}

fun shape_eq(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): Bool {
    val kx: Int64 = x.kinds[xp]
    val ky: Int64 = y.kinds[yp]
    if (kx != ky) {
        return false;
    }
    if (kx == 5 as Int64) {
        return eq_records(x, xp, y, yp);
    }
    if (kx == 6 as Int64) {
        return shape_eq(x, xp + 1 as Int64, y, yp + 1 as Int64);
    }
    if (kx == 7 as Int64) {
        return eq_anys(x, xp, y, yp);
    }
    if (kx == 8 as Int64) {
        if (x.names[xp] != y.names[yp]) {
            return false;
        }
        if (x.aux[xp] != y.aux[yp]) {
            return false;
        }
        return shape_eq(x, xp + 1 as Int64, y, yp + 1 as Int64);
    }
    true
}

fun eq_records(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): Bool {
    if (x.aux[xp] != y.aux[yp]) {
        return false;
    }
    var c = xp + 1 as Int64
    var d = yp + 1 as Int64
    var f = 0 as Int64
    val n: Int64 = x.aux[xp]
    while (f < n) {
        if (x.names[c] != y.names[d]) {
            return false;
        }
        if (x.aux[c] != y.aux[d]) {
            return false;
        }
        if (!shape_eq(x, c + 1 as Int64, y, d + 1 as Int64)) {
            return false;
        }
        c = c + 1 as Int64 + vsize(x, c + 1 as Int64)
        d = d + 1 as Int64 + vsize(y, d + 1 as Int64)
        f += 1 as Int64
    }
    true
}

fun eq_anys(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): Bool {
    if (x.aux[xp] != y.aux[yp]) {
        return false;
    }
    var c = xp + 1 as Int64
    var d = yp + 1 as Int64
    var f = 0 as Int64
    val n: Int64 = x.aux[xp]
    while (f < n) {
        if (!shape_eq(x, c, y, d)) {
            return false;
        }
        c = c + vsize(x, c)
        d = d + vsize(y, d)
        f += 1 as Int64
    }
    true
}

fun opt_member(a: &ShapeVal, ap: Int64, b: &ShapeVal, bp: Int64): Bool {
    var c = ap + 1 as Int64
    var f = 0 as Int64
    val n: Int64 = a.aux[ap]
    while (f < n) {
        if (shape_eq(a, c, b, bp)) {
            return true;
        }
        c = c + vsize(a, c)
        f += 1 as Int64
    }
    false
}

fun count_merged(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): Int64 {
    var n: Int64 = x.aux[xp]
    var d = yp + 1 as Int64
    var f = 0 as Int64
    val nb: Int64 = y.aux[yp]
    while (f < nb) {
        val nm: String = y.names[d]
        val hb = find_header(x, xp, nm.clone())
        if (hb == 0 as Int64 - 1 as Int64) {
            n += 1 as Int64
        }
        d = d + 1 as Int64 + vsize(y, d + 1 as Int64)
        f += 1 as Int64
    }
    n
}

fun count_union(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): Int64 {
    var n: Int64 = x.aux[xp]
    var d = yp + 1 as Int64
    var f = 0 as Int64
    val ny: Int64 = y.aux[yp]
    while (f < ny) {
        if (!opt_member(x, xp, y, d)) {
            n += 1 as Int64
        }
        d = d + vsize(y, d)
        f += 1 as Int64
    }
    n
}

// ---- common preferred shape (paper Sec. 3, Fig. preferred relation) ----

fun merge(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    val kx: Int64 = x.kinds[xp]
    val ky: Int64 = y.kinds[yp]
    if (kx == ky) {
        if (kx == 5 as Int64) {
            return merge_records(x, xp, y, yp);
        }
        if (kx == 6 as Int64) {
            return merge_arrays(x, xp, y, yp);
        }
        if (kx == 7 as Int64) {
            return merge_anys(x, xp, y, yp);
        }
        return prim_val(kx);
    }
    if (kx == 0 as Int64 && ky == 1 as Int64) {
        return prim_val(1 as Int64);
    }
    if (kx == 1 as Int64 && ky == 0 as Int64) {
        return prim_val(1 as Int64);
    }
    if (kx == 4 as Int64) {
        return copy_val(y, yp);
    }
    if (ky == 4 as Int64) {
        return copy_val(x, xp);
    }
    if (kx == 7 as Int64) {
        return any_add_left(x, xp, y, yp);
    }
    if (ky == 7 as Int64) {
        return any_add_right(x, xp, y, yp);
    }
    return hetero(x, xp, y, yp);
}

fun merge_records(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    var o = new_val()
    val nf = count_merged(x, xp, y, yp)
    push_tok(&mut o, 5 as Int64, nf, "")
    var c = xp + 1 as Int64
    var fa = 0 as Int64
    val na: Int64 = x.aux[xp]
    while (fa < na) {
        val nm: String = x.names[c]
        val oo: Int64 = x.aux[c]
        val hb = find_header(y, yp, nm.clone())
        if (hb == 0 as Int64 - 1 as Int64) {
            push_tok(&mut o, 8 as Int64, 1 as Int64, nm)
            append_into(&mut o, x, c + 1 as Int64)
        } else {
            val ob: Int64 = y.aux[hb]
            val mo = if (oo == 1 as Int64 || ob == 1 as Int64) { 1 as Int64 } else { 0 as Int64 }
            push_tok(&mut o, 8 as Int64, mo, nm)
            val s = merge(x, c + 1 as Int64, y, hb + 1 as Int64)
            append_into(&mut o, &s, 0 as Int64)
        }
        c = c + 1 as Int64 + vsize(x, c + 1 as Int64)
        fa += 1 as Int64
    }
    var d = yp + 1 as Int64
    var fb = 0 as Int64
    val nb: Int64 = y.aux[yp]
    while (fb < nb) {
        val nm: String = y.names[d]
        val ha = find_header(x, xp, nm.clone())
        if (ha == 0 as Int64 - 1 as Int64) {
            push_tok(&mut o, 8 as Int64, 1 as Int64, nm)
            append_into(&mut o, y, d + 1 as Int64)
        }
        d = d + 1 as Int64 + vsize(y, d + 1 as Int64)
        fb += 1 as Int64
    }
    o
}

fun merge_arrays(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    var o = new_val()
    push_tok(&mut o, 6 as Int64, 0 as Int64, "")
    val s = merge(x, xp + 1 as Int64, y, yp + 1 as Int64)
    append_into(&mut o, &s, 0 as Int64)
    o
}

fun merge_anys(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    var o = new_val()
    push_tok(&mut o, 7 as Int64, count_union(x, xp, y, yp), "")
    var c = xp + 1 as Int64
    var f = 0 as Int64
    val nx: Int64 = x.aux[xp]
    while (f < nx) {
        append_into(&mut o, x, c)
        c = c + vsize(x, c)
        f += 1 as Int64
    }
    var d = yp + 1 as Int64
    var g = 0 as Int64
    val ny: Int64 = y.aux[yp]
    while (g < ny) {
        if (!opt_member(x, xp, y, d)) {
            append_into(&mut o, y, d)
        }
        d = d + vsize(y, d)
        g += 1 as Int64
    }
    o
}

fun any_add_left(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    if (opt_member(x, xp, y, yp)) {
        return copy_val(x, xp);
    }
    var o = new_val()
    val n: Int64 = x.aux[xp]
    push_tok(&mut o, 7 as Int64, n + 1 as Int64, "")
    var c = xp + 1 as Int64
    var f = 0 as Int64
    while (f < n) {
        append_into(&mut o, x, c)
        c = c + vsize(x, c)
        f += 1 as Int64
    }
    append_into(&mut o, y, yp)
    o
}

fun any_add_right(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    if (opt_member(y, yp, x, xp)) {
        return copy_val(y, yp);
    }
    var o = new_val()
    val n: Int64 = y.aux[yp]
    push_tok(&mut o, 7 as Int64, n + 1 as Int64, "")
    append_into(&mut o, x, xp)
    var d = yp + 1 as Int64
    var g = 0 as Int64
    while (g < n) {
        append_into(&mut o, y, d)
        d = d + vsize(y, d)
        g += 1 as Int64
    }
    o
}

fun hetero(x: &ShapeVal, xp: Int64, y: &ShapeVal, yp: Int64): ShapeVal {
    var o = new_val()
    push_tok(&mut o, 7 as Int64, 2 as Int64, "")
    append_into(&mut o, x, xp)
    append_into(&mut o, y, yp)
    o
}

// ---- arena -> flat value ----

fun extract(a: &Arena, idx: Int64): ShapeVal {
    val n: Shape = a.nodes[idx]
    match (n) {
        Shape::SInt -> prim_val(0 as Int64),
        Shape::SFloat -> prim_val(1 as Int64),
        Shape::SString -> prim_val(2 as Int64),
        Shape::SBool -> prim_val(3 as Int64),
        Shape::SNull -> prim_val(4 as Int64),
        Shape::SArray(e) -> extract_array(a, e),
        Shape::SRecord(ff) -> extract_record(a, ff),
        Shape::SAny(oo) -> extract_any(a, oo),
    }
}

fun extract_array(a: &Arena, e: Int64): ShapeVal {
    var o = new_val()
    push_tok(&mut o, 6 as Int64, 0 as Int64, "")
    val c = extract(a, e)
    append_into(&mut o, &c, 0 as Int64)
    o
}

fun extract_record(a: &Arena, ff: Vec<Field>): ShapeVal {
    var o = new_val()
    push_tok(&mut o, 5 as Int64, ff.len(), "")
    var i = 0 as Int64
    while (i < ff.len()) {
        val fd: Field = ff[i]
        val opt: Int64 = if (fd.optional) { 1 as Int64 } else { 0 as Int64 }
        push_tok(&mut o, 8 as Int64, opt, fd.name)
        val c = extract(a, fd.shape)
        append_into(&mut o, &c, 0 as Int64)
        i += 1 as Int64
    }
    o
}

fun extract_any(a: &Arena, oo: Vec<Int64>): ShapeVal {
    var o = new_val()
    push_tok(&mut o, 7 as Int64, oo.len(), "")
    var i = 0 as Int64
    while (i < oo.len()) {
        val c = extract(a, oo[i])
        append_into(&mut o, &c, 0 as Int64)
        i += 1 as Int64
    }
    o
}

// ---- canonical text rendering (exact-match output) ----

fun describe(v: &ShapeVal, pos: Int64): String {
    val k: Int64 = v.kinds[pos]
    if (k == 0 as Int64) {
        return "int";
    }
    if (k == 1 as Int64) {
        return "float";
    }
    if (k == 2 as Int64) {
        return "string";
    }
    if (k == 3 as Int64) {
        return "bool";
    }
    if (k == 4 as Int64) {
        return "null";
    }
    if (k == 5 as Int64) {
        return describe_record(v, pos);
    }
    if (k == 6 as Int64) {
        return "array(" + describe(v, pos + 1 as Int64) + ")";
    }
    if (k == 7 as Int64) {
        return describe_any(v, pos);
    }
    return "?";
}

fun describe_record(v: &ShapeVal, root: Int64): String {
    var acc = "record("
    var c = root + 1 as Int64
    var f = 0 as Int64
    val n: Int64 = v.aux[root]
    while (f < n) {
        val nm: String = v.names[c]
        val mark = if (v.aux[c] == 1 as Int64) { "?" } else { "" }
        val sep = if (f == 0 as Int64) { "" } else { "," }
        acc = acc + sep + nm + mark + "=" + describe(v, c + 1 as Int64)
        c = c + 1 as Int64 + vsize(v, c + 1 as Int64)
        f += 1 as Int64
    }
    acc + ")"
}

fun describe_any(v: &ShapeVal, root: Int64): String {
    var acc = "any("
    var c = root + 1 as Int64
    var f = 0 as Int64
    val n: Int64 = v.aux[root]
    while (f < n) {
        val sep = if (f == 0 as Int64) { "" } else { "|" }
        acc = acc + sep + describe(v, c)
        c = c + vsize(v, c)
        f += 1 as Int64
    }
    acc + ")"
}

fun main() {
    val e0: Vec<Shape> = vec![]
    var cur = Arena { nodes: e0 }
    val a1 = alloc(cur, Shape::SInt)
    val si = a1.idx
    cur = a1.arena
    val a2 = alloc(cur, Shape::SString)
    val ss = a2.idx
    cur = a2.arena
    val a3 = alloc(cur, Shape::SFloat)
    val sf = a3.idx
    cur = a3.arena
    val a4 = alloc(cur, Shape::SNull)
    val sn = a4.idx
    cur = a4.arena
    // doc1 = {name: string, age: int}
    var f1: Vec<Field> = vec![]
    f1.push(Field { name: "name", shape: ss, optional: false })
    f1.push(Field { name: "age", shape: si, optional: false })
    val a5 = alloc(cur, Shape::SRecord(f1))
    val d1 = a5.idx
    cur = a5.arena
    // doc2 = {name: string}
    var f2: Vec<Field> = vec![]
    f2.push(Field { name: "name", shape: ss, optional: false })
    val a6 = alloc(cur, Shape::SRecord(f2))
    val d2 = a6.idx
    cur = a6.arena
    // doc3 = {name: string, age: float}
    var f3: Vec<Field> = vec![]
    f3.push(Field { name: "name", shape: ss, optional: false })
    f3.push(Field { name: "age", shape: sf, optional: false })
    val a7 = alloc(cur, Shape::SRecord(f3))
    val d3 = a7.idx
    cur = a7.arena
    // hetero docs: {id: int} vs {id: string}
    var g1: Vec<Field> = vec![]
    g1.push(Field { name: "id", shape: si, optional: false })
    val a8 = alloc(cur, Shape::SRecord(g1))
    val e1 = a8.idx
    cur = a8.arena
    var g2: Vec<Field> = vec![]
    g2.push(Field { name: "id", shape: ss, optional: false })
    val a9 = alloc(cur, Shape::SRecord(g2))
    val e2 = a9.idx
    cur = a9.arena
    // null-field docs: {nick: null} vs {nick: string}
    var h1: Vec<Field> = vec![]
    h1.push(Field { name: "nick", shape: sn, optional: false })
    val a10 = alloc(cur, Shape::SRecord(h1))
    val q1 = a10.idx
    cur = a10.arena
    var h2: Vec<Field> = vec![]
    h2.push(Field { name: "nick", shape: ss, optional: false })
    val a11 = alloc(cur, Shape::SRecord(h2))
    val q2 = a11.idx
    cur = a11.arena
    // arrays of int vs float
    val a12 = alloc(cur, Shape::SArray(si))
    val ar1 = a12.idx
    cur = a12.arena
    val a13 = alloc(cur, Shape::SArray(sf))
    val ar2 = a13.idx
    cur = a13.arena
    // paper Sec. 3 demos
    val v1 = extract(&cur, d1)
    val v2 = extract(&cur, d2)
    val v3 = extract(&cur, d3)
    val m12 = merge(&v1, 0 as Int64, &v2, 0 as Int64)
    println(describe(&m12, 0 as Int64))
    val m123 = merge(&m12, 0 as Int64, &v3, 0 as Int64)
    println(describe(&m123, 0 as Int64))
    val u1 = extract(&cur, e1)
    val u2 = extract(&cur, e2)
    val mu = merge(&u1, 0 as Int64, &u2, 0 as Int64)
    println(describe(&mu, 0 as Int64))
    val w1 = extract(&cur, ar1)
    val w2 = extract(&cur, ar2)
    val ma = merge(&w1, 0 as Int64, &w2, 0 as Int64)
    println(describe(&ma, 0 as Int64))
    val z1 = extract(&cur, q1)
    val z2 = extract(&cur, q2)
    val mz = merge(&z1, 0 as Int64, &z2, 0 as Int64)
    println(describe(&mz, 0 as Int64))
    val vi = prim_val(0 as Int64)
    val vf = prim_val(1 as Int64)
    val mif = merge(&vi, 0 as Int64, &vf, 0 as Int64)
    println(describe(&mif, 0 as Int64))
    val vn = prim_val(4 as Int64)
    val vs = prim_val(2 as Int64)
    val mns = merge(&vn, 0 as Int64, &vs, 0 as Int64)
    println(describe(&mns, 0 as Int64))
}
