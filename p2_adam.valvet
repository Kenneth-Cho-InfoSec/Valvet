// P2: Adam optimizer (Kingma & Ba, "Adam: A Method for Stochastic
// Optimization", arXiv:1412.6980). Source read: papers/p2_adam.fs
// (DiffSharp Optim) — the Adam type IS present (lines 67-92, plus the
// functional optim.adam at lines 248-267, which is what is ported here).
//
// F# update rule per step (t = stateStep, starting at 1):
//   m  <- m*b1 + g*(1-b1);  v <- v*b2 + g*g*(1-b2)
//   bc1 = 1 - b1^t;          bc2 = 1 - b2^t
//   denom = sqrt(v)/sqrt(bc2) + eps;  p = m/denom;  ss = lr/bc1
//   x <- x - ss*p
// Valvet mapping: 2D Rosenbrock f(x,y) = (1-x)^2 + 100(y-x^2)^2 from
// (-1.2, 1.0) with hand-derived analytic gradient
// (df/dx = -2(1-x) - 400x(y-x^2), df/dy = 200(y-x^2), using +-*/ only),
// lr 0.001, betas 0.9/0.999, eps 1e-8, 1500 iters.
// Bias powers b1^t/b2^t are kept as running products (identical op order
// in the Python reference, bit-identical to repeated multiplication).
// sqrt comes from the Valvet stdlib (stdlib/math.valvet, Newton iteration);
// the reference re-implements that exact loop, so both sides agree
// bit-for-bit (Python math.sqrt is correctly rounded and would NOT match
// the stdlib approximation — hence the shared-loop scheme). Prints final
// x, y, f.
import std::math::sqrt;

fun rosen_f(x: Float64, y: Float64): Float64 {
    val t1 = 1.0 - x;
    val a = t1 * t1;
    val t2 = y - x * x;
    a + 100.0 * t2 * t2
}

fun main() {
    var x = 0.0 - 1.2;
    var y = 1.0;
    val lr = 0.001;
    val beta1 = 0.9;
    val beta2 = 0.999;
    val eps = 0.00000001;
    val omb1 = 1.0 - beta1;
    val omb2 = 1.0 - beta2;
    var m0 = 0.0;
    var m1 = 0.0;
    var v0 = 0.0;
    var v1 = 0.0;
    var b1p = 1.0;
    var b2p = 1.0;
    var step = 0;
    while (step < 1500) {
        step += 1;
        val t1 = 1.0 - x;
        val xsq = x * x;
        val t2 = y - xsq;
        val g0 = 0.0 - 2.0 * t1 - 400.0 * x * t2;
        val g1 = 200.0 * t2;
        m0 = m0 * beta1 + g0 * omb1;
        m1 = m1 * beta1 + g1 * omb1;
        v0 = v0 * beta2 + g0 * g0 * omb2;
        v1 = v1 * beta2 + g1 * g1 * omb2;
        b1p = b1p * beta1;
        b2p = b2p * beta2;
        val bc1 = 1.0 - b1p;
        val bc2 = 1.0 - b2p;
        val d0 = sqrt(v0) / sqrt(bc2) + eps;
        val d1 = sqrt(v1) / sqrt(bc2) + eps;
        val p0 = m0 / d0;
        val p1 = m1 / d1;
        val ss = lr / bc1;
        x = x - ss * p0;
        y = y - ss * p1;
    }
    println(x);
    println(y);
    println(rosen_f(x, y));
}
