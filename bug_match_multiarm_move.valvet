// Minimal repro: moving an owned value in more than one `match` arm is
// rejected with E0301, although the equivalent if/else chain is accepted.
// This file fails `valvet check` with:
//   error[E0301]: use of moved value `x` --> ...:6:22 (second arm)
// The if/else version below (commented) checks and runs clean:
//   fun f(a: Vec<Int64>, tag: Int32): Vec<Int64> {
//       var x = a
//       if (tag == 1) { consume(x) } else {
//           if (tag == 2) { consume(x) } else { x }
//       }
//   }
// Match arms are exclusive, so the rejection looks like a borrowck
// limitation rather than a soundness rule (nothing in README.md or
// docs/implementation documents it; PLAN-0.1.0-REMAINING.md only notes
// "conservative scrutinee moves on owned bindings").

fun consume(a: Vec<Int64>): Vec<Int64> { a }

fun f(a: Vec<Int64>, tag: Int32): Vec<Int64> {
    var x = a
    match (tag) {
        1 -> consume(x),
        2 -> consume(x),
        _ -> x,
    }
}

fun main() {
    var v: Vec<Int64> = vec![1 as Int64]
    v = f(v, 1)
    println(v.len())
}
