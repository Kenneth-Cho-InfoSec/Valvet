{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valvet.dev/schemas/oracle-manifest-v1.json",
  "title": "Valvet oracle manifest",
  "type": "object",
  "required": ["ports"],
  "properties": {
    "schema": { "const": "valvet-oracle-manifest-v1" },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["expected", "actual"],
        "properties": {
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "one_ulp_allowed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
