// Heat cells are stored column-major in `xs`: cell (row i, col j) is
// `xs[j * rows + i]`, row 0 at the bottom (the y axis points up).
pub fun plot_heatmap(m: Mat): PlotBuilder {
    val rows = m.rows()
    val cols = m.cols()
    var vals: Vec<Float64> = vec![];
    var j = 0 as Int64;
    while (j < cols) {
        val col = m.mat_col(j);
        var i = 0 as Int64;
        while (i < rows) {
            vals.push(col[i]);
            i = i + (1 as Int64);
        }
        j = j + (1 as Int64);
    }
    val labels: Vec<String> = vec![];
    val ys: Vec<Float64> = vec![];
    val errs: Vec<Float64> = vec![];
    PlotBuilder {
        kind: "heatmap",
        xs: vals,
        ys: ys,
        labels: labels,
        bins: 10 as Int64,
        title: "",
        width: 400 as Int64,
        height: 300 as Int64,
        errs: errs,
        bandwidth: 0.0,
        theme: plot_theme_default(),
        grid_rows: rows,
        grid_cols: cols,
    }
}

