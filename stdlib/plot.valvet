// Theme: colors, optional grid, and font size for one plot. Kept as a
// value carried by the builder; `plot_theme` swaps it in.
pub struct PlotTheme {
    accent: String,
    fg: String,
    grid: Bool,
    font_size: Int64,
}

pub fun plot_theme_default(): PlotTheme {
    PlotTheme { accent: "#524ce9", fg: "black", grid: false, font_size: 10 as Int64 }
}

pub fun plot_theme_make(accent: String, fg: String, grid: Bool, font_size: Int64): PlotTheme {
    PlotTheme { accent: accent, fg: fg, grid: grid, font_size: font_size }
}

pub struct PlotBuilder {
    kind: String,
    xs: Vec<Float64>,
    ys: Vec<Float64>,
    labels: Vec<String>,
    bins: Int64,
    title: String,
    width: Int64,
    height: Int64,
    errs: Vec<Float64>,
    bandwidth: Float64,
    theme: PlotTheme,
    grid_rows: Int64,
    grid_cols: Int64,
}

pub fun plot_points(xs: Vec<Float64>, ys: Vec<Float64>): PlotBuilder {
    val labels: Vec<String> = vec![];
    val errs: Vec<Float64> = vec![];
    PlotBuilder {
        kind: "points",
        xs: xs,
        ys: ys,
        labels: labels,
        bins: 10 as Int64,
        title: "",
        width: 400 as Int64,
        height: 300 as Int64,
        errs: errs,
        bandwidth: 0.0,
        theme: plot_theme_default(),
        grid_rows: 0 as Int64,
        grid_cols: 0 as Int64,
    }
}

