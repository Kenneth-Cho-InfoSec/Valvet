        grid_cols: p.grid_cols,
    }
}

fun esc(s: String): String {
    val parts = s.split("&");
    var out = "";
    var i = 0 as Int64
    while (i < parts.len()) {
        if (i > (0 as Int64)) {
            out = out + "&amp;";
        }
        out = out + parts[i];
        i += 1 as Int64
    }
    val lt = out.split("<");
    var o2 = "";
    var j = 0 as Int64
    while (j < lt.len()) {
        if (j > (0 as Int64)) {
            o2 = o2 + "&lt;";
        }
        o2 = o2 + lt[j];
        j += 1 as Int64
    }
    o2
}

fun fmin(v: Vec<Float64>): Float64 {
    var best = v[0]
    var i = 1 as Int64
    while (i < v.len()) {
        if (v[i] < best) {
            best = v[i];
        }
        i += 1 as Int64
    }
    best
}

fun fmax(v: Vec<Float64>): Float64 {
    var best = v[0]
    var i = 1 as Int64
    while (i < v.len()) {
        if (v[i] > best) {
            best = v[i];
        }
        i += 1 as Int64
    }
    best
}

fun fmin2(a: Float64, b: Float64): Float64 {
    if (a < b) {
        return a;
    }
    b
}

fun has_nan(v: Vec<Float64>): Bool {
    var i = 0 as Int64
    var found = false
    while (i < v.len()) {
        if (v[i] != v[i]) {
            found = true;
        }
        i += 1 as Int64
    }
    found
}

fun fmean(v: Vec<Float64>): Float64 {
    var s = 0.0
    var i = 0 as Int64
    while (i < v.len()) {
        s = s + v[i]
        i += 1 as Int64
    }
    s / (v.len() as Float64)
}

// Sample standard deviation (ddof = 1); 0.0 below n = 2.
fun fsd(v: Vec<Float64>): Float64 {
    val n = v.len()
    if (n < (2 as Int64)) {
        return 0.0;
    }
    val m = fmean(v.clone())
    var s = 0.0
    var i = 0 as Int64
    while (i < n) {
        s = s + (v[i] - m) * (v[i] - m)
        i += 1 as Int64
    }
    sqrt(s / ((n - (1 as Int64)) as Float64))
}

// Type-7 (R default, numpy `linear`) quantile of an ASCENDING-sorted vec.
fun plot_quantile(s: Vec<Float64>, q: Float64): Float64 {
    val n = s.len()
    if (n == (0 as Int64)) {
        return 0.0;
    }
    if (n == (1 as Int64)) {
        return s[0];
    }
    val h = q * ((n - (1 as Int64)) as Float64)
    val lo = h as Int64
    val frac = h - (lo as Float64)
    if (frac == 0.0) {
        return s[lo];
    }
    s[lo] + frac * (s[lo + (1 as Int64)] - s[lo])
}

// Silverman's rule of thumb, floored at 1.0 so degenerate samples
// (all-equal, n = 1) still give a usable kernel.
pub fun kde_auto_bandwidth(vals: Vec<Float64>): Float64 {
    val n = vals.len()
    var h = 1.0
    if (n >= (2 as Int64)) {
        var s = vals.clone()
        s.sort()
        val iqr = plot_quantile(s.clone(), 0.75) - plot_quantile(s, 0.25)
        val sd = fsd(vals.clone())
        h = 0.9 * fmin2(sd, iqr / 1.34) * pow(n as Float64, 0.0 - 0.2)
    }
    if (is_nan_f(h) || h < 1.0) {
        h = 1.0;
    }
    h
}

// Gaussian KDE at `x`; non-positive/non-finite bandwidth falls back to
// the Silverman rule. Empty data gives NaN.
pub fun kde_density(vals: Vec<Float64>, bandwidth: Float64, x: Float64): Float64 {
    val n = vals.len()
    if (n == (0 as Int64)) {
        return 0.0 / 0.0;
    }
    var h = bandwidth
    if (is_nan_f(h) || h <= 0.0) {
        h = kde_auto_bandwidth(vals.clone())
    }
    var acc = 0.0
    var i = 0 as Int64
    while (i < n) {
        val z = (x - vals[i]) / h
        acc = acc + exp(0.0 - 0.5 * z * z)
        i += 1 as Int64
    }
    acc / ((n as Float64) * h * 2.5066282746310002)
}

// Ascending z-scores of the data (ddof = 1). sd = 0 gives inf/NaN, so
// `plot_qq` validates variance before drawing.
pub fun qq_standardized(vals: Vec<Float64>): Vec<Float64> {
    var s = vals.clone()
    s.sort()
    val m = fmean(vals.clone())
    val sd = fsd(vals)
    var out: Vec<Float64> = vec![]
    var i = 0 as Int64
    while (i < s.len()) {
        out.push((s[i] - m) / sd)
        i += 1 as Int64
    }
    out
}

// Theoretical normal quantiles at (i + 0.5) / n, i = 0..n-1 (Blom).
pub fun qq_theoretical(n: Int64): Vec<Float64> {
    var out: Vec<Float64> = vec![]
    var i = 0 as Int64
    while (i < n) {
        val p = ((i as Float64) + 0.5) / (n as Float64)
        out.push(normal_quantile(p, 0.0, 1.0))
        i += 1 as Int64
    }
    out
}

fun hex_digit(d: Int64): String {
    if (d == (0 as Int64)) {
        return "0";
    }
    if (d == (1 as Int64)) {
        return "1";
    }
    if (d == (2 as Int64)) {
        return "2";
    }
    if (d == (3 as Int64)) {
        return "3";
    }
    if (d == (4 as Int64)) {
        return "4";
    }
    if (d == (5 as Int64)) {
        return "5";
    }
    if (d == (6 as Int64)) {
        return "6";
    }
    if (d == (7 as Int64)) {
        return "7";
    }
    if (d == (8 as Int64)) {
        return "8";
    }
    if (d == (9 as Int64)) {
        return "9";
    }
    if (d == (10 as Int64)) {
        return "a";
    }
    if (d == (11 as Int64)) {
        return "b";
    }
    if (d == (12 as Int64)) {
        return "c";
    }
    if (d == (13 as Int64)) {
        return "d";
    }
    if (d == (14 as Int64)) {
        return "e";
    }
    "f"
}

fun hex2(v: Int64): String {
    var x = v
    if (x < (0 as Int64)) {
        x = 0 as Int64;
    }
    if (x > (255 as Int64)) {
        x = 255 as Int64;
    }
    val hi = x / (16 as Int64)
    val lo = x - hi * (16 as Int64)
    var s = ""
    s = s + hex_digit(hi)
    s = s + hex_digit(lo)
    s
}

// White-to-accent-blue ramp on [0, 1]: t = 0 gives #ffffff, t = 1 gives
// #2828ff; NaN and out-of-range clamp to the low end. +0.5 before the
// integer cast is a deliberate rounding bias (documented, pinned).
pub fun heat_color(t: Float64): String {
    var c = t
    if (is_nan_f(c)) {
        c = 0.0;
    }
    if (c < 0.0) {
        c = 0.0;
    }
    if (c > 1.0) {
        c = 1.0;
    }
    val i = (c * 215.0 + 0.5) as Int64
    val v = (255 as Int64) - i
    var s = "#"
    s = s + hex2(v)
    s = s + hex2(v)
    s = s + "ff"
    s
}

fun xmap(x: Float64, lo: Float64, hi: Float64, w: Float64): Float64 {
    val pad = 40.0
    if (hi == lo) {
        return w / 2.0;
    }
    pad + (x - lo) / (hi - lo) * (w - pad * 2.0)
}

fun ymap(y: Float64, lo: Float64, hi: Float64, h: Float64): Float64 {
    val pad = 30.0
    if (hi == lo) {
        return h / 2.0;
    }
    h - pad - (y - lo) / (hi - lo) * (h - pad * 2.0)
}

fun head(p: &PlotBuilder): String {
    var s = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"";
    s = s + to_string(p.width);
    s = s + "\" height=\"";
    s = s + to_string(p.height);
    s = s + "\">";
    if (p.title == "") {
        s = s + "";
    } else {
        s = s + "<text x=\"20\" y=\"22\" font-size=\"14\">" + esc(p.title.clone()) + "</text>";
    }
    s
}

fun frame_axes(p: &PlotBuilder, xlo: Float64, xhi: Float64, ylo: Float64, yhi: Float64, w: Float64, h: Float64): String {
    var s = "<line x1=\"";
    s = s + to_string(xmap(xlo, xlo, xhi, w));
    s = s + "\" y1=\"";
    s = s + to_string(ymap(ylo, ylo, yhi, h));
    s = s + "\" x2=\"";
    s = s + to_string(xmap(xhi, xlo, xhi, w));
    s = s + "\" y2=\"";
    s = s + to_string(ymap(ylo, ylo, yhi, h));
    s = s + "\" stroke=\"";
    s = s + p.theme.fg.clone();
    s = s + "\"/>";
    s = s + "<line x1=\"";
    s = s + to_string(xmap(xlo, xlo, xhi, w));
    s = s + "\" y1=\"";
    s = s + to_string(ymap(ylo, ylo, yhi, h));
    s = s + "\" x2=\"";
    s = s + to_string(xmap(xlo, xlo, xhi, w));
    s = s + "\" y2=\"";
    s = s + to_string(ymap(yhi, ylo, yhi, h));
    s = s + "\" stroke=\"";
    s = s + p.theme.fg.clone();
    s = s + "\"/>";
    if (p.theme.grid) {
        var gi = 1 as Int64
        while (gi < (5 as Int64)) {
            val gx = xlo + (xhi - xlo) * (gi as Float64) / 5.0
            s = s + "<line x1=\"";
            s = s + to_string(xmap(gx, xlo, xhi, w));
            s = s + "\" y1=\"";
            s = s + to_string(ymap(ylo, ylo, yhi, h));
            s = s + "\" x2=\"";
            s = s + to_string(xmap(gx, xlo, xhi, w));
            s = s + "\" y2=\"";
            s = s + to_string(ymap(yhi, ylo, yhi, h));
            s = s + "\" stroke=\"#dddddd\"/>";
            gi += 1 as Int64
        }
        var gj = 1 as Int64
        while (gj < (5 as Int64)) {
            val gy = ylo + (yhi - ylo) * (gj as Float64) / 5.0
            s = s + "<line x1=\"";
            s = s + to_string(xmap(xlo, xlo, xhi, w));
            s = s + "\" y1=\"";
            s = s + to_string(ymap(gy, ylo, yhi, h));
            s = s + "\" x2=\"";
            s = s + to_string(xmap(xhi, xlo, xhi, w));
            s = s + "\" y2=\"";
            s = s + to_string(ymap(gy, ylo, yhi, h));
            s = s + "\" stroke=\"#dddddd\"/>";
            gj += 1 as Int64
        }
    }
    s = s + "<text x=\"";
    s = s + to_string(xmap(xlo, xlo, xhi, w));
    s = s + "\" y=\"";
    s = s + to_string(ymap(ylo, ylo, yhi, h) + 14.0);
    s = s + "\" font-size=\"";
    s = s + to_string(p.theme.font_size);
    s = s + "\">";
    s = s + to_string(xlo);
    s = s + "</text>";
    s = s + "<text x=\"";
    s = s + to_string(xmap(xhi, xlo, xhi, w) - 30.0);
    s = s + "\" y=\"";
    s = s + to_string(ymap(ylo, ylo, yhi, h) + 14.0);
    s = s + "\" font-size=\"";
    s = s + to_string(p.theme.font_size);
    s = s + "\">";
    s = s + to_string(xhi);
    s = s + "</text>";
    s
}

fun draw_points(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val xlo = fmin(p.xs.clone())
    val xhi = fmax(p.xs.clone())
    val ylo = fmin(p.ys.clone())
    val yhi = fmax(p.ys.clone())
    var s = frame_axes(p, xlo, xhi, ylo, yhi, w, h);
    var i = 0 as Int64
    while (i < p.xs.len()) {
        s = s + "<circle cx=\"";
        s = s + to_string(xmap(p.xs[i], xlo, xhi, w));
        s = s + "\" cy=\"";
        s = s + to_string(ymap(p.ys[i], ylo, yhi, h));
        s = s + "\" r=\"3\" fill=\"";
        s = s + p.theme.accent.clone();
        s = s + "\"/>";
        i += 1 as Int64
    }
    s
}

fun draw_line(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val xlo = fmin(p.xs.clone())
    val xhi = fmax(p.xs.clone())
    val ylo = fmin(p.ys.clone())
    val yhi = fmax(p.ys.clone())
    var s = frame_axes(p, xlo, xhi, ylo, yhi, w, h);
    var pts = "";
    var i = 0 as Int64
    while (i < p.xs.len()) {
        if (i > (0 as Int64)) {
            pts = pts + " ";
        }
        pts = pts + to_string(xmap(p.xs[i], xlo, xhi, w));
        pts = pts + ",";
        pts = pts + to_string(ymap(p.ys[i], ylo, yhi, h));
        i += 1 as Int64
    }
    s = s + "<polyline points=\"";
    s = s + pts;
    s = s + "\" fill=\"none\" stroke=\"";
    s = s + p.theme.accent.clone();
    s = s + "\" stroke-width=\"2\"/>";
    s
}

fun draw_bar(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val ylo = 0.0
    val yhi = fmax(p.ys.clone())
    var s = frame_axes(p, 0.0, p.labels.len() as Float64, ylo, yhi, w, h);
    val n = p.labels.len()
    var i = 0 as Int64
    while (i < n) {
        val bx = xmap(i as Float64, 0.0, n as Float64, w);
        val bw = (w - 80.0) / (n as Float64);
        val by = ymap(p.ys[i], ylo, yhi, h);
        val base = ymap(ylo, ylo, yhi, h);
        s = s + "<rect x=\"";
        s = s + to_string(bx);
        s = s + "\" y=\"";
        s = s + to_string(by);
        s = s + "\" width=\"";
        s = s + to_string(bw);
        s = s + "\" height=\"";
        s = s + to_string(base - by);
        s = s + "\" fill=\"";
        s = s + p.theme.accent.clone();
        s = s + "\"/>";
        s = s + "<text x=\"";
        s = s + to_string(bx);
        s = s + "\" y=\"";
        s = s + to_string(base + 14.0);
        s = s + "\" font-size=\"";
        s = s + to_string(p.theme.font_size);
        s = s + "\">";
        s = s + esc(p.labels[i]);
        s = s + "</text>";
        i += 1 as Int64
    }
    s
}

fun draw_hist(p: &PlotBuilder): String {
    val lo = fmin(p.xs.clone())
    val hi = fmax(p.xs.clone())
    val nb = p.bins
    val span = hi - lo
    val wdt = if (span == 0.0) { 1.0 } else { span / (nb as Float64) };
    var counts: Vec<Int64> = vec![]
    var b = 0 as Int64
    while (b < nb) {
        counts.push(0 as Int64);
        b += 1 as Int64
    }
    var i = 0 as Int64
    while (i < p.xs.len()) {
        var bi = ((p.xs[i] - lo) / wdt) as Int64;
        if (bi >= nb) {
            bi = nb - (1 as Int64);
        }
        if (bi >= (0 as Int64)) {
            counts[bi] = counts[bi] + (1 as Int64);
        }
        i += 1 as Int64
    }
    var top = 0 as Int64
    var k = 0 as Int64
    while (k < nb) {
        if (counts[k] > top) {
            top = counts[k];
        }
        k += 1 as Int64
    }
    val w = p.width as Float64
    val h = p.height as Float64
    var s = frame_axes(p, lo, hi, 0.0, top as Float64, w, h);
    var j = 0 as Int64
    while (j < nb) {
        val bx = xmap(lo + (j as Float64) * wdt, lo, hi, w);
        val bw = (w - 80.0) / (nb as Float64);
        val by = ymap(counts[j] as Float64, 0.0, top as Float64, h);
        val base = ymap(0.0, 0.0, top as Float64, h);
        s = s + "<rect x=\"";
        s = s + to_string(bx);
        s = s + "\" y=\"";
        s = s + to_string(by);
        s = s + "\" width=\"";
        s = s + to_string(bw);
        s = s + "\" height=\"";
        s = s + to_string(base - by);
        s = s + "\" fill=\"";
        s = s + p.theme.accent.clone();
        s = s + "\"/>";
        j += 1 as Int64
    }
    s
}

fun draw_box(p: &PlotBuilder): String {
    var mv: Vec<Missing<Float64>> = vec![]
    var i = 0 as Int64
    while (i < p.xs.len()) {
        mv.push(Missing::Present(p.xs[i]));
        i += 1 as Int64
    }
    val q1 = match (quantile(mv.clone(), MissingPolicy::Skip, 0.25)) { Some(x) -> x, None -> 0.0, };
    val med = match (quantile(mv.clone(), MissingPolicy::Skip, 0.5)) { Some(x) -> x, None -> 0.0, };
    val q3 = match (quantile(mv, MissingPolicy::Skip, 0.75)) { Some(x) -> x, None -> 0.0, };
    val w = p.width as Float64
    val h = p.height as Float64
    val lo = fmin(p.xs.clone())
    val hi = fmax(p.xs.clone())
    var s = frame_axes(p, lo, hi, lo, hi, w, h);
    val cx = w / 2.0
    val y0 = ymap(lo, lo, hi, h);
    val y1 = ymap(q1, lo, hi, h);
    val y2 = ymap(med, lo, hi, h);
    val y3 = ymap(q3, lo, hi, h);
    val y4 = ymap(hi, lo, hi, h);
    s = s + "<line x1=\"";
    s = s + to_string(cx);
    s = s + "\" y1=\"";
    s = s + to_string(y0);
    s = s + "\" x2=\"";
    s = s + to_string(cx);
    s = s + "\" y2=\"";
    s = s + to_string(y4);
    s = s + "\" stroke=\"";
    s = s + p.theme.fg.clone();
    s = s + "\"/>";
    s = s + "<rect x=\"";
    s = s + to_string(cx - 30.0);
    s = s + "\" y=\"";
    s = s + to_string(y3);
    s = s + "\" width=\"60\" height=\"";
    s = s + to_string(y1 - y3);
    s = s + "\" fill=\"";
    s = s + p.theme.accent.clone();
    s = s + "\" stroke=\"";
    s = s + p.theme.fg.clone();
    s = s + "\"/>";
    s = s + "<line x1=\"";
    s = s + to_string(cx - 30.0);
    s = s + "\" y1=\"";
    s = s + to_string(y2);
    s = s + "\" x2=\"";
    s = s + to_string(cx + 30.0);
    s = s + "\" y2=\"";
    s = s + to_string(y2);
    s = s + "\" stroke=\"white\" stroke-width=\"2\"/>";
    s
}

// KDE evaluation grid shared by violin/density: 100 points from lo to
// hi (all at lo when constant), densities, and the max for scaling.
struct KdeGrid {
    gx: Vec<Float64>,
    gd: Vec<Float64>,
    dmax: Float64,
}

fun kde_h(p: &PlotBuilder): Float64 {
    var hb = p.bandwidth
    if (is_nan_f(hb) || hb <= 0.0) {
        hb = kde_auto_bandwidth(p.xs.clone());
    }
    hb
}

fun kde_grid(p: &PlotBuilder, hb: Float64, lo: Float64, hi: Float64): KdeGrid {
    var gx: Vec<Float64> = vec![]
    var gd: Vec<Float64> = vec![]
    var dmax = 0.0
    var i = 0 as Int64
    while (i < (100 as Int64)) {
        val g = if (hi == lo) { lo } else { lo + ((i as Float64) / 99.0) * (hi - lo) }
        val d = kde_density(p.xs.clone(), hb, g)
        gx.push(g)
        gd.push(d)
        if (d > dmax) {
            dmax = d;
        }
        i += 1 as Int64
    }
    if (dmax <= 0.0) {
        dmax = 1.0;
    }
    KdeGrid { gx: gx, gd: gd, dmax: dmax }
}

fun draw_violin(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val lo = fmin(p.xs.clone())
    val hi = fmax(p.xs.clone())
    val grid = kde_grid(p, kde_h(p), lo, hi)
    var s = frame_axes(p, lo, hi, lo, hi, w, h);
    var pts = ""
    var k = 0 as Int64
    while (k < (100 as Int64)) {
        if (k > (0 as Int64)) {
            pts = pts + " ";
        }
        val half = (grid.gd[k] / grid.dmax) * 40.0
        pts = pts + to_string((w / 2.0) + half)
        pts = pts + ","
        pts = pts + to_string(ymap(grid.gx[k], lo, hi, h))
        k += 1 as Int64
    }
    var kk = 99 as Int64
    while (kk >= (0 as Int64)) {
        val half = (grid.gd[kk] / grid.dmax) * 40.0
        pts = pts + " "
        pts = pts + to_string((w / 2.0) - half)
        pts = pts + ","
        pts = pts + to_string(ymap(grid.gx[kk], lo, hi, h))
        kk = kk - (1 as Int64)
    }
    s = s + "<polygon points=\""
    s = s + pts
    s = s + "\" fill=\""
    s = s + p.theme.accent.clone()
    s = s + "\" stroke=\""
    s = s + p.theme.fg.clone()
    s = s + "\" stroke-width=\"1\"/>"
    s
}

fun draw_density(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val lo = fmin(p.xs.clone())
    val hi = fmax(p.xs.clone())
    val grid = kde_grid(p, kde_h(p), lo, hi)
    var s = frame_axes(p, lo, hi, 0.0, grid.dmax, w, h);
    var pts = ""
    var k = 0 as Int64
    while (k < (100 as Int64)) {
        if (k > (0 as Int64)) {
            pts = pts + " ";
        }
        pts = pts + to_string(xmap(grid.gx[k], lo, hi, w))
        pts = pts + ","
        pts = pts + to_string(ymap(grid.gd[k], 0.0, grid.dmax, h))
        k += 1 as Int64
    }
    s = s + "<polyline points=\""
    s = s + pts
    s = s + "\" fill=\"none\" stroke=\""
    s = s + p.theme.accent.clone()
    s = s + "\" stroke-width=\"2\"/>"
    s
}

fun draw_qq(p: &PlotBuilder): String {
    val z = qq_standardized(p.xs.clone())
    val t = qq_theoretical(z.len())
    val w = p.width as Float64
    val h = p.height as Float64
    val tlo = fmin(t.clone())
    val thi = fmax(t.clone())
    val zlo = fmin(z.clone())
    val zhi = fmax(z.clone())
    var s = frame_axes(p, tlo, thi, zlo, zhi, w, h);
    var i = 0 as Int64
    while (i < z.len()) {
        s = s + "<circle cx=\""
        s = s + to_string(xmap(t[i], tlo, thi, w))
        s = s + "\" cy=\""
        s = s + to_string(ymap(z[i], zlo, zhi, h))
        s = s + "\" r=\"3\" fill=\""
        s = s + p.theme.accent.clone()
        s = s + "\"/>"
        i += 1 as Int64
    }
    // Reference line through the type-7 quartiles of both axes.
    val tq1 = plot_quantile(t.clone(), 0.25)
    val tq3 = plot_quantile(t.clone(), 0.75)
    val zq1 = plot_quantile(z.clone(), 0.25)
    val zq3 = plot_quantile(z, 0.75)
    s = s + "<line x1=\""
    s = s + to_string(xmap(tq1, tlo, thi, w))
    s = s + "\" y1=\""
    s = s + to_string(ymap(zq1, zlo, zhi, h))
    s = s + "\" x2=\""
    s = s + to_string(xmap(tq3, tlo, thi, w))
    s = s + "\" y2=\""
    s = s + to_string(ymap(zq3, zlo, zhi, h))
    s = s + "\" stroke=\""
    s = s + p.theme.fg.clone()
    s = s + "\" stroke-width=\"2\"/>"
    s
}

fun draw_heatmap(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val rows = p.grid_rows
    val cols = p.grid_cols
    val cw = cols as Float64
    val rh = rows as Float64
    var vmin = p.xs[0]
    var vmax = p.xs[0]
    var i = 0 as Int64
    while (i < p.xs.len()) {
        if (p.xs[i] < vmin) {
            vmin = p.xs[i];
        }
        if (p.xs[i] > vmax) {
            vmax = p.xs[i];
        }
        i += 1 as Int64
    }
    var s = frame_axes(p, 0.0, cw, 0.0, rh, w, h);
    var ii = 0 as Int64
    while (ii < rows) {
        var jj = 0 as Int64
        while (jj < cols) {
            val v = p.xs[jj * rows + ii]
            val t = if (vmax == vmin) { 0.5 } else { (v - vmin) / (vmax - vmin) }
            val x0 = xmap(jj as Float64, 0.0, cw, w)
            val x1 = xmap((jj + (1 as Int64)) as Float64, 0.0, cw, w)
            val y0 = ymap(ii as Float64, 0.0, rh, h)
            val y1 = ymap((ii + (1 as Int64)) as Float64, 0.0, rh, h)
            s = s + "<rect x=\""
            s = s + to_string(x0)
            s = s + "\" y=\""
            s = s + to_string(y1)
            s = s + "\" width=\""
            s = s + to_string(x1 - x0)
            s = s + "\" height=\""
            s = s + to_string(y0 - y1)
            s = s + "\" fill=\""
            s = s + heat_color(t)
            s = s + "\"/>"
            jj += 1 as Int64
        }
        ii += 1 as Int64
    }
    s
}

fun draw_errorbar(p: &PlotBuilder): String {
    val w = p.width as Float64
    val h = p.height as Float64
    val xlo = fmin(p.xs.clone())
    val xhi = fmax(p.xs.clone())
    var ylo = p.ys[0] - p.errs[0]
    var yhi = p.ys[0] + p.errs[0]
    var i = 0 as Int64
    while (i < p.ys.len()) {
        val a = p.ys[i] - p.errs[i]
        val b = p.ys[i] + p.errs[i]
        if (a < ylo) {
            ylo = a;
        }
        if (b > yhi) {
            yhi = b;
        }
        i += 1 as Int64
    }
    var s = frame_axes(p, xlo, xhi, ylo, yhi, w, h);
    val cap = 4.0
    var k = 0 as Int64
    while (k < p.xs.len()) {
        val xp = xmap(p.xs[k], xlo, xhi, w)
        val yt = ymap(p.ys[k] + p.errs[k], ylo, yhi, h)
        val yb = ymap(p.ys[k] - p.errs[k], ylo, yhi, h)
        s = s + "<line x1=\""
        s = s + to_string(xp)
        s = s + "\" y1=\""
        s = s + to_string(yt)
        s = s + "\" x2=\""
        s = s + to_string(xp)
        s = s + "\" y2=\""
        s = s + to_string(yb)
        s = s + "\" stroke=\""
        s = s + p.theme.accent.clone()
        s = s + "\" stroke-width=\"1.5\"/>"
        s = s + "<line x1=\""
        s = s + to_string(xp - cap)
        s = s + "\" y1=\""
        s = s + to_string(yt)
        s = s + "\" x2=\""
        s = s + to_string(xp + cap)
        s = s + "\" y2=\""
        s = s + to_string(yt)
        s = s + "\" stroke=\""
        s = s + p.theme.accent.clone()
        s = s + "\"/>"
        s = s + "<line x1=\""
        s = s + to_string(xp - cap)
        s = s + "\" y1=\""
        s = s + to_string(yb)
        s = s + "\" x2=\""
        s = s + to_string(xp + cap)
        s = s + "\" y2=\""
        s = s + to_string(yb)
        s = s + "\" stroke=\""
        s = s + p.theme.accent.clone()
        s = s + "\"/>"
        k += 1 as Int64
    }
    s
}

pub fun plot_svg(p: PlotBuilder): Result<String, String> {
    if (p.kind != "points" && p.kind != "line" && p.kind != "bar" && p.kind != "hist" && p.kind != "box" && p.kind != "violin" && p.kind != "density" && p.kind != "qq" && p.kind != "heatmap" && p.kind != "errorbar") {
        return Err("unknown plot kind");
    }
    if (p.kind == "bar") {
        if (p.labels.len() != p.ys.len() || p.ys.len() == (0 as Int64)) {
            return Err("bar needs matching non-empty labels and values");
        }
    }
    if (p.kind == "violin") {
        if (p.xs.len() == (0 as Int64)) {
            return Err("violin needs non-empty data");
        }
        if (has_nan(p.xs.clone())) {
            return Err("plot data must not contain NaN");
        }
    }
    if (p.kind == "density") {
        if (p.xs.len() == (0 as Int64)) {
            return Err("density needs non-empty data");
        }
        if (has_nan(p.xs.clone())) {
            return Err("plot data must not contain NaN");
        }
    }
    if (p.kind == "qq") {
        if (p.xs.len() < (2 as Int64)) {
            return Err("qq needs at least two values");
        }
        if (has_nan(p.xs.clone())) {
            return Err("plot data must not contain NaN");
        }
        if (fsd(p.xs.clone()) == 0.0) {
            return Err("qq needs varying data");
        }
    }
    if (p.kind == "heatmap") {
        if (p.grid_rows <= (0 as Int64) || p.grid_cols <= (0 as Int64)) {
            return Err("heatmap needs positive rows and cols");
        }
        if (p.xs.len() != p.grid_rows * p.grid_cols) {
            return Err("heatmap data must match rows times cols");
        }
        if (has_nan(p.xs.clone())) {
            return Err("plot data must not contain NaN");
        }
    }
    if (p.kind == "errorbar") {
        if (p.xs.len() != p.ys.len() || p.ys.len() != p.errs.len() || p.xs.len() == (0 as Int64)) {
            return Err("errorbar needs matching non-empty xs, ys, and errs");
        }
        val nx = has_nan(p.xs.clone());
        val ny = has_nan(p.ys.clone());
        val ne = has_nan(p.errs.clone());
        if (nx || ny || ne) {
            return Err("plot data must not contain NaN");
        }
        var ei = 0 as Int64
        while (ei < p.errs.len()) {
            if (p.errs[ei] < 0.0) {
                return Err("errorbar needs non-negative errors");
            }
            ei += 1 as Int64
        }
    }
    if (p.kind == "points" || p.kind == "line" || p.kind == "hist" || p.kind == "box") {
        if (p.xs.len() != p.ys.len() || p.xs.len() == (0 as Int64)) {
            return Err("plot needs matching non-empty x and y");
        }
    }
    if (p.kind == "hist" && p.bins <= (0 as Int64)) {
        return Err("hist needs positive bins");
    }
    var s = head(&p);
    if (p.kind == "points") {
        s = s + draw_points(&p);
    }
    if (p.kind == "line") {
        s = s + draw_line(&p);
    }
    if (p.kind == "bar") {
        s = s + draw_bar(&p);
    }
    if (p.kind == "hist") {
        s = s + draw_hist(&p);
    }
    if (p.kind == "box") {
        s = s + draw_box(&p);
    }
    if (p.kind == "violin") {
        s = s + draw_violin(&p);
    }
    if (p.kind == "density") {
        s = s + draw_density(&p);
    }
    if (p.kind == "qq") {
        s = s + draw_qq(&p);
    }
    if (p.kind == "heatmap") {
        s = s + draw_heatmap(&p);
    }
    if (p.kind == "errorbar") {
        s = s + draw_errorbar(&p);
    }
    s = s + "</svg>";
    return Ok(s);
}

pub fun plot_save(p: PlotBuilder, path: String): Result<Int64, String> {
    val svg = plot_svg(p)?;
    return write_file(path, svg);
}

// D2 grammar: a `Plot` holds data plus a layer list (layers are DATA:
// kind + column-name mappings, never functions). Builders compose with
// `|>` (Valvet has no operator overloading, so `|>` is the honest form
// of the `+` chaining in the plan); one SVG comes out of `plot_render`.
// Scales are per-panel (each panel autoscales its own data, documented);
// facets stack vertically with one panel per facet value.

pub struct Plot {
    frame: DynamicFrame,
    kinds: Vec<String>,
    xcols: Vec<String>,
    ycols: Vec<String>,
    title: String,
    width: Int64,
    height: Int64,
    log_x: Bool,
    facet: String,
}

pub fun plot_new(f: DynamicFrame): Plot {
    val kinds: Vec<String> = vec![];
    val xcols: Vec<String> = vec![];
    val ycols: Vec<String> = vec![];
    Plot { frame: f, kinds: kinds, xcols: xcols, ycols: ycols, title: "", width: 400 as Int64, height: 300 as Int64, log_x: false, facet: "" }
}

fun plot_push_layer(p: Plot, kind: String, x: String, y: String): Plot {
    var kinds = p.kinds.clone();
    var xcols = p.xcols.clone();
    var ycols = p.ycols.clone();
    kinds.push(kind);
    xcols.push(x);
    ycols.push(y);
    val f = DynamicFrame { names: p.frame.names.clone(), cols: p.frame.cols.clone(), nrows: p.frame.nrows };
    Plot { frame: f, kinds: kinds, xcols: xcols, ycols: ycols, title: p.title.clone(), width: p.width, height: p.height, log_x: p.log_x, facet: p.facet.clone() }
}

pub fun plot_add_points(p: Plot, x: String, y: String): Plot {
    return plot_push_layer(p, "points", x, y);
}

pub fun plot_add_line(p: Plot, x: String, y: String): Plot {
    return plot_push_layer(p, "line", x, y);
}

pub fun plot_add_bar(p: Plot, labels: String, values: String): Plot {
    return plot_push_layer(p, "bar", labels, values);
}

pub fun plot_log_x(p: Plot): Plot {
    val f = DynamicFrame { names: p.frame.names.clone(), cols: p.frame.cols.clone(), nrows: p.frame.nrows };
    Plot { frame: f, kinds: p.kinds.clone(), xcols: p.xcols.clone(), ycols: p.ycols.clone(), title: p.title.clone(), width: p.width, height: p.height, log_x: true, facet: p.facet.clone() }
}

pub fun plot_facet(p: Plot, col: String): Plot {
    val f = DynamicFrame { names: p.frame.names.clone(), cols: p.frame.cols.clone(), nrows: p.frame.nrows };
    Plot { frame: f, kinds: p.kinds.clone(), xcols: p.xcols.clone(), ycols: p.ycols.clone(), title: p.title.clone(), width: p.width, height: p.height, log_x: p.log_x, facet: col }
}

pub fun plot_heading(p: Plot, t: String): Plot {
    val f = DynamicFrame { names: p.frame.names.clone(), cols: p.frame.cols.clone(), nrows: p.frame.nrows };
    Plot { frame: f, kinds: p.kinds.clone(), xcols: p.xcols.clone(), ycols: p.ycols.clone(), title: t, width: p.width, height: p.height, log_x: p.log_x, facet: p.facet.clone() }
}

fun plot_numcol(frame: &DynamicFrame, col: String, rows: Vec<Int64>): Vec<Float64> {
    val empty: Vec<String> = vec![];
    val c = match (frame_col(frame, col)) { Some(v) -> v, None -> empty, };
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < rows.len()) {
        val r = rows[i];
        if (r >= (0 as Int64) && r < c.len()) {
            val v = match (c[r].parse_float()) { Some(x) -> x, None -> 0.0 / 0.0, };
            out.push(v);
        }
        i = i + (1 as Int64);
    }
    return out;
}

fun plot_strcol(frame: &DynamicFrame, col: String, rows: Vec<Int64>): Vec<String> {
    val empty: Vec<String> = vec![];
    val c = match (frame_col(frame, col)) { Some(v) -> v, None -> empty, };
    var out: Vec<String> = vec![];
    var i = 0 as Int64;
    while (i < rows.len()) {
        val r = rows[i];
        if (r >= (0 as Int64) && r < c.len()) {
            out.push(c[r]);
        }
        i = i + (1 as Int64);
    }
    return out;
}

fun is_nan_f(x: Float64): Bool {
    return x != x;
}

fun log10_f(x: Float64): Float64 {
    return log(x) / log(10.0);
}

// One panel body for one layer over a row subset (empty when the layer
// has no drawable data: unparseable cells and non-positive log-x values
// are dropped, ggplot-style).
fun plot_layer_body(kind: String, xnums: Vec<Float64>, ystrs: Vec<String>, vals: Vec<Float64>, labels: Vec<String>, w: Int64, h: Int64, ptitle: String, log_x: Bool): String {
    var out = "";
    if (kind == "bar") {
        var fy: Vec<Float64> = vec![];
        var fl: Vec<String> = vec![];
        var i = 0 as Int64;
        while (i < labels.len() && i < vals.len()) {
            if (!is_nan_f(vals[i])) {
                fl.push(labels[i]);
                fy.push(vals[i]);
            }
            i = i + (1 as Int64);
        }
        if (fl.len() != (0 as Int64)) {
            val b = plot_size(plot_title(plot_bar(fl, fy), ptitle), w, h);
            out = draw_bar(&b);
        }
    } else {
        var fx: Vec<Float64> = vec![];
        var fy2: Vec<Float64> = vec![];
        var i = 0 as Int64;
        while (i < xnums.len() && i < ystrs.len()) {
            val xv = xnums[i];
            val yv = match (ystrs[i].parse_float()) { Some(y) -> y, None -> 0.0 / 0.0, };
            if (!is_nan_f(xv) && !is_nan_f(yv)) {
                if (log_x) {
                    if (xv > 0.0) {
                        fx.push(log10_f(xv));
                        fy2.push(yv);
                    }
                } else {
                    fx.push(xv);
                    fy2.push(yv);
                }
            }
            i = i + (1 as Int64);
        }
        if (fx.len() != (0 as Int64)) {
            if (kind == "line") {
                val b = plot_size(plot_title(plot_line(fx.clone(), fy2.clone()), ptitle.clone()), w, h);
                out = draw_line(&b);
            } else {
                val b = plot_size(plot_title(plot_points(fx, fy2), ptitle), w, h);
                out = draw_points(&b);
            }
        }
    }
    return out;
}

pub fun plot_render(p: Plot): Result<String, String> {
    val kinds = p.kinds.clone();
    val xcols = p.xcols.clone();
    val ycols = p.ycols.clone();
    val ptitle_main = p.title.clone();
    val pw = p.width;
    val ph = p.height;
    val plogx = p.log_x;
    val pfacet = p.facet.clone();
    val frame = DynamicFrame { names: p.frame.names.clone(), cols: p.frame.cols.clone(), nrows: p.frame.nrows };
    if (kinds.len() == (0 as Int64)) {
        return Err("plot has no layers");
    }
    // Facet values in first-appearance order; "" or a missing column
    // means one panel over all rows.
    var panels: Vec<String> = vec![];
    var all_rows: Vec<Int64> = vec![];
    var r = 0 as Int64;
    while (r < frame.nrows) {
        all_rows.push(r);
        r = r + (1 as Int64);
    }
    if (pfacet == "") {
        panels.push("");
    } else {
        val fc = plot_strcol(&frame, pfacet.clone(), all_rows.clone());
        var i = 0 as Int64;
        while (i < fc.len()) {
            var seen = false;
            var j = 0 as Int64;
            while (j < panels.len()) {
                if (panels[j] == fc[i]) {
                    seen = true;
                }
                j = j + (1 as Int64);
            }
            if (!seen) {
                panels.push(fc[i]);
            }
            i = i + (1 as Int64);
        }
        if (panels.len() == (0 as Int64)) {
            panels.push("");
        }
    }
    val d_errs: Vec<Float64> = vec![];
    val dummy = PlotBuilder { kind: "points", xs: vec![0.0], ys: vec![0.0], labels: vec![""], bins: 10 as Int64, title: ptitle_main, width: pw, height: ph * panels.len(), errs: d_errs, bandwidth: 0.0, theme: plot_theme_default(), grid_rows: 0 as Int64, grid_cols: 0 as Int64 };
    var st = head(&dummy);
    var pi = 0 as Int64;
    while (pi < panels.len()) {
        val pv = panels[pi].clone();
        var rows: Vec<Int64> = vec![];
        if (pfacet == "" || pv == "") {
            rows = all_rows.clone();
        } else {
            val fc = plot_strcol(&frame, pfacet.clone(), all_rows.clone());
            var i = 0 as Int64;
            while (i < fc.len() && i < all_rows.len()) {
                if (fc[i] == pv) {
                    rows.push(all_rows[i]);
                }
                i = i + (1 as Int64);
            }
        }
        var body = "";
        var li = 0 as Int64;
        while (li < kinds.len()) {
            val kind = kinds[li].clone();
            val xc = xcols[li].clone();
            val yc = ycols[li].clone();
            var ptitle = "";
            if (pv != "") {
                ptitle = pv.clone();
            }
            if (kind == "bar") {
                val labels = plot_strcol(&frame, xc, rows.clone());
                val vals = plot_numcol(&frame, yc, rows.clone());
                val ex: Vec<Float64> = vec![];
                body = body + plot_layer_body(kind, ex, labels.clone(), vals, labels, pw, ph, ptitle, plogx);
            } else {
                val ys = plot_strcol(&frame, yc, rows.clone());
                val xnums = plot_numcol(&frame, xc, rows.clone());
                val ev: Vec<Float64> = vec![];
                val es: Vec<String> = vec![];
                body = body + plot_layer_body(kind, xnums, ys, ev, es, pw, ph, ptitle, plogx);
            }
            li = li + (1 as Int64);
        }
        st = st + "<g transform=\"translate(0,";
        st = st + to_string(pi * ph);
        st = st + ")\">";
        st = st + body;
        st = st + "</g>";
        pi = pi + (1 as Int64);
    }
    st = st + "</svg>";
    return Ok(st);
}

pub fun plot_pairs(df: &DynamicFrame, cols: Vec<String>): PlotBuilder {
    var xs: Vec<Float64> = vec![];
    var ys: Vec<Float64> = vec![];
    val e_pp: Vec<String> = vec![];
    var ci = 0 as Int64;
    while (ci < cols.len()) {
        val col = match (frame_col(df, cols[ci].clone())) { Some(v) -> v, None -> e_pp.clone(), };
        var i = 0 as Int64;
        while (i < col.len()) {
            val v = match (col[i].parse_float()) { Some(x) -> x, None -> 0.0 / 0.0, };
            if (v == v) {
                if (ci % (2 as Int64) == (0 as Int64)) {
                    xs.push(v);
                } else {
                    ys.push(v);
                }
            }
            i = i + (1 as Int64);
        }
        ci = ci + (1 as Int64);
    }
    while (ys.len() < xs.len()) {
        ys.push(0.0);
    }
    return plot_points(xs, ys);
}

pub fun plot_ecdf(vals: Vec<Float64>): PlotBuilder {
    var s = vals.clone();
    s.sort();
    var xs: Vec<Float64> = vec![];
    var ys: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < s.len()) {
        xs.push(s[i]);
        ys.push(((i + (1 as Int64)) as Float64) / (s.len() as Float64));
        i = i + (1 as Int64);
    }
    return plot_line(xs, ys);
}

pub fun plot_correlogram(v: Vec<Float64>, max_lag: Int64): PlotBuilder {
    var xs: Vec<Float64> = vec![];
    var ys: Vec<Float64> = vec![];
    var m = 0.0;
    var i = 0 as Int64;
    while (i < v.len()) {
        m = m + v[i];
        i = i + (1 as Int64);
    }
    m = m / (v.len() as Float64);
    var den = 0.0;
    var j = 0 as Int64;
    while (j < v.len()) {
        den = den + (v[j] - m) * (v[j] - m);
        j = j + (1 as Int64);
    }
    var lag = 0 as Int64;
    while (lag <= max_lag && lag < v.len()) {
        var num = 0.0;
        var k = 0 as Int64;
        while (k + lag < v.len()) {
            num = num + (v[k] - m) * (v[k + lag] - m);
            k = k + (1 as Int64);
        }
        xs.push(lag as Float64);
        ys.push(if (den == 0.0) { 0.0 / 0.0 } else { num / den });
        lag = lag + (1 as Int64);
    }
    var labels: Vec<String> = vec![];
    var li = 0 as Int64;
    while (li < ys.len()) {
        labels.push(to_string(li));
        li = li + (1 as Int64);
    }
    return plot_bar(labels, ys);
}
