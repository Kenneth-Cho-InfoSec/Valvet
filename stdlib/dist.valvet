// D3 distributions: Normal/Exponential/Uniform/Binomial/Poisson with
// pdf/pmf/cdf/quantile/sample. Pure Valvet over `std::math` plus the
// seeded `Rng` (Marsaglia-Bray for normals, inversion elsewhere).
//
// Accuracy: `erf` is Taylor (|x| <= 1.5) plus a Lentz continued fraction
// tail (first principles, no fitted constants); fixtures pin it against
// Python `math.erf` to 1e-9. Quantiles bisect the cdf (100 iterations).
// Sampling funs take `Rng` by value (fork semantics): the batch draws
// from the caller's current stream, and the caller's stream is unchanged
// afterward (advance it with `rng.next_f64()` between batches for
// distinct batches from one seed).
//
// Totality: out-of-domain parameters yield NaN (never traps); quantile
// edges yield infinities exactly like R (`qnorm(0)` is `-Inf`).

module std.dist;

import std::math::sqrt;
import std::math::exp;
import std::math::log;
import std::math::pow;

fun is_nan_d(x: Float64): Bool {
    return x != x;
}

fun pos_inf(): Float64 {
    return 1.0 / 0.0;
}

fun neg_inf(): Float64 {
    return 0.0 - 1.0 / 0.0;
}

fun nan(): Float64 {
    return 0.0 / 0.0;
}

// erf by Taylor (|x| <= 1.5, 60 terms) or Lentz tail (above).
fun erf_taylor(x: Float64): Float64 {
    val c = 1.1283791670955126;
    val x2 = x * x;
    var term = x;
    var sum = x;
    var n = 1 as Int64;
    while (n < (60 as Int64)) {
        val fn = n as Float64;
        term = term * (0.0 - x2) * ((2.0 * fn - 1.0) / (fn * (2.0 * fn + 1.0)));
        sum = sum + term;
        n = n + (1 as Int64);
    }
    return c * sum;
}

fun erfc_lentz(x: Float64): Float64 {
    // erfc(27) is ~1e-318: beyond this the true value is zero to Float64
    // (and the fraction converges poorly), so cut off exactly.
    if (x > 27.0) {
        return 0.0;
    }
    val tiny = 0.000000000000000000000000000001;
    var f = x;
    if (f == 0.0) {
        f = tiny;
    }
    var c = f;
    var d = 0.0;
    var j = 1 as Int64;
    while (j < (100 as Int64)) {
        val fj = j as Float64;
        val a = fj / 2.0;
        d = x + a * d;
        if (d == 0.0) {
            d = tiny;
        }
        c = x + a / c;
        if (c == 0.0) {
            c = tiny;
        }
        d = 1.0 / d;
        val cd = c * d;
        f = f * cd;
        j = j + (1 as Int64);
    }
    val inv_sqrt_pi = 0.5641895835477563;
    return exp(0.0 - x * x) * inv_sqrt_pi / f;
}

pub fun erf(x: Float64): Float64 {
    if (x < 0.0) {
        return 0.0 - erf(0.0 - x);
    }
    if (x > 1.5) {
        return 1.0 - erfc_lentz(x);
    }
    return erf_taylor(x);
}

pub fun normal_pdf(x: Float64, mu: Float64, sigma: Float64): Float64 {
    if (sigma <= 0.0) {
        return nan();
    }
    val z = (x - mu) / sigma;
    return exp(0.0 - z * z / 2.0) / (sigma * 2.5066282746310002);
}

pub fun normal_cdf(x: Float64, mu: Float64, sigma: Float64): Float64 {
    if (sigma <= 0.0) {
        return nan();
    }
    val z = (x - mu) / (sigma * 1.4142135623730951);
    return 0.5 * (1.0 - erf(0.0 - z));
}

pub fun normal_quantile(p: Float64, mu: Float64, sigma: Float64): Float64 {
    if (sigma <= 0.0 || is_nan_d(p)) {
        return nan();
    }
    if (p <= 0.0) {
        return neg_inf();
    }
    if (p >= 1.0) {
        return pos_inf();
    }
    var lo = mu - 10.0 * sigma;
    var hi = mu + 10.0 * sigma;
    var i = 0 as Int64;
    while (i < (100 as Int64)) {
        val mid = (lo + hi) / 2.0;
        if (normal_cdf(mid, mu, sigma) < p) {
            lo = mid;
        } else {
            hi = mid;
        }
        i = i + (1 as Int64);
    }
    return (lo + hi) / 2.0;
}

pub fun normal_sample(rng: Rng, mu: Float64, sigma: Float64, n: Int64): Vec<Float64> {
    var out: Vec<Float64> = vec![];
    while (out.len() < n) {
        val v1 = rng.next_f64() * 2.0 - 1.0;
        val v2 = rng.next_f64() * 2.0 - 1.0;
        val s = v1 * v1 + v2 * v2;
        if (s < 1.0 && s > 0.0) {
            val mult = sqrt((0.0 - 2.0 * log(s)) / s);
            out.push(mu + sigma * v1 * mult);
            if (out.len() < n) {
                out.push(mu + sigma * v2 * mult);
            }
        }
    }
    return out;
}

pub fun exp_pdf(x: Float64, lambda: Float64): Float64 {
    if (lambda <= 0.0) {
        return nan();
    }
    if (x < 0.0) {
        return 0.0;
    }
    return lambda * exp(0.0 - lambda * x);
}

pub fun exp_cdf(x: Float64, lambda: Float64): Float64 {
    if (lambda <= 0.0) {
        return nan();
    }
    if (x <= 0.0) {
        return 0.0;
    }
    return 1.0 - exp(0.0 - lambda * x);
}

pub fun exp_quantile(p: Float64, lambda: Float64): Float64 {
    if (lambda <= 0.0 || is_nan_d(p)) {
        return nan();
    }
    if (p <= 0.0) {
        return 0.0;
    }
    if (p >= 1.0) {
        return pos_inf();
    }
    return (0.0 - log(1.0 - p)) / lambda;
}

pub fun exp_sample(rng: Rng, lambda: Float64, n: Int64): Vec<Float64> {
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < n) {
        out.push(exp_quantile(rng.next_f64(), lambda));
        i = i + (1 as Int64);
    }
    return out;
}

pub fun uniform_pdf(x: Float64, a: Float64, b: Float64): Float64 {
    if (b <= a) {
        return nan();
    }
    if (x < a || x > b) {
        return 0.0;
    }
    return 1.0 / (b - a);
}

pub fun uniform_cdf(x: Float64, a: Float64, b: Float64): Float64 {
    if (b <= a) {
        return nan();
    }
    if (x <= a) {
        return 0.0;
    }
    if (x >= b) {
        return 1.0;
    }
    return (x - a) / (b - a);
}

pub fun uniform_quantile(p: Float64, a: Float64, b: Float64): Float64 {
    if (b <= a || is_nan_d(p)) {
        return nan();
    }
    if (p <= 0.0) {
        return a;
    }
    if (p >= 1.0) {
        return b;
    }
    return a + p * (b - a);
}

pub fun uniform_sample(rng: Rng, a: Float64, b: Float64, n: Int64): Vec<Float64> {
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < n) {
        out.push(a + rng.next_f64() * (b - a));
        i = i + (1 as Int64);
    }
    return out;
}

fun binom_edge(p: Float64, k: Int64, n: Int64): Float64 {
    if (p <= 0.0) {
        if (k == (0 as Int64)) {
            return 1.0;
        }
        return 0.0;
    }
    if (k == n) {
        return 1.0;
    }
    return 0.0;
}

pub fun binom_pmf(k: Int64, n: Int64, p: Float64): Float64 {
    if (n < (0 as Int64) || is_nan_d(p)) {
        return nan();
    }
    if (p <= 0.0 || p >= 1.0) {
        return binom_edge(p, k, n);
    }
    if (k < (0 as Int64) || k > n) {
        return 0.0;
    }
    var t = exp(n as Float64 * log(1.0 - p));
    var j = 0 as Int64;
    while (j < k) {
        val fj = j as Float64;
        t = t * ((n as Float64) - fj) / (fj + 1.0) * (p / (1.0 - p));
        j = j + (1 as Int64);
    }
    return t;
}

pub fun binom_cdf(k: Int64, n: Int64, p: Float64): Float64 {
    if (n < (0 as Int64) || is_nan_d(p)) {
        return nan();
    }
    if (p <= 0.0 || p >= 1.0) {
        if (p <= 0.0) {
            if (k >= (0 as Int64)) {
                return 1.0;
            }
            return 0.0;
        }
        if (k >= n) {
            return 1.0;
        }
        return 0.0;
    }
    if (k < (0 as Int64)) {
        return 0.0;
    }
    var kk = k;
    if (kk > n) {
        kk = n;
    }
    var s = 0.0;
    var j = 0 as Int64;
    while (j <= kk) {
        s = s + binom_pmf(j, n, p);
        j = j + (1 as Int64);
    }
    return s;
}

pub fun binom_quantile(q: Float64, n: Int64, p: Float64): Int64 {
    if (n < (0 as Int64) || is_nan_d(q)) {
        return 0 as Int64 - 1 as Int64;
    }
    if (q <= 0.0) {
        return 0 as Int64;
    }
    if (q >= 1.0) {
        return n;
    }
    var k = 0 as Int64;
    while (k < n) {
        if (binom_cdf(k, n, p) >= q) {
            return k;
        }
        k = k + (1 as Int64);
    }
    return n;
}

pub fun binom_sample(rng: Rng, n: Int64, p: Float64, m: Int64): Vec<Int64> {
    var out: Vec<Int64> = vec![];
    var i = 0 as Int64;
    while (i < m) {
        var c = 0 as Int64;
        var j = 0 as Int64;
        while (j < n) {
            if (rng.next_f64() < p) {
                c = c + (1 as Int64);
            }
            j = j + (1 as Int64);
        }
        out.push(c);
        i = i + (1 as Int64);
    }
    return out;
}

pub fun poisson_pmf(k: Int64, lambda: Float64): Float64 {
    if (lambda < 0.0 || is_nan_d(lambda)) {
        return nan();
    }
    if (k < (0 as Int64)) {
        return 0.0;
    }
    var t = exp(0.0 - lambda);
    var j = 0 as Int64;
    while (j < k) {
        t = t * lambda / ((j as Float64) + 1.0);
        j = j + (1 as Int64);
    }
    return t;
}

pub fun poisson_cdf(k: Int64, lambda: Float64): Float64 {
    if (lambda < 0.0 || is_nan_d(lambda)) {
        return nan();
    }
    if (k < (0 as Int64)) {
        return 0.0;
    }
    var s = 0.0;
    var j = 0 as Int64;
    while (j <= k) {
        s = s + poisson_pmf(j, lambda);
        j = j + (1 as Int64);
    }
    return s;
}

pub fun poisson_quantile(q: Float64, lambda: Float64): Int64 {
    if (lambda < 0.0 || is_nan_d(q)) {
        return 0 as Int64 - 1 as Int64;
    }
    if (q <= 0.0) {
        return 0 as Int64;
    }
    var k = 0 as Int64;
    while (k < (1000000 as Int64)) {
        if (poisson_cdf(k, lambda) >= q) {
            return k;
        }
        k = k + (1 as Int64);
    }
    return k;
}

pub fun poisson_sample(rng: Rng, lambda: Float64, m: Int64): Vec<Int64> {
    var out: Vec<Int64> = vec![];
    var i = 0 as Int64;
    while (i < m) {
        val l = exp(0.0 - lambda);
        var k = 0 as Int64;
        var t = rng.next_f64();
        while (t > l) {
            t = t * rng.next_f64();
            k = k + (1 as Int64);
        }
        out.push(k);
        i = i + (1 as Int64);
    }
    return out;
}

fun ln_fact(n: Int64): Float64 {
    if (n <= (1 as Int64)) {
        return 0.0;
    }
    var s = 0.0;
    var i = 2 as Int64;
    while (i <= n) {
        s = s + ((i as Float64)).log();
        i = i + (1 as Int64);
    }
    return s;
}

fun ln_comb(n: Int64, k: Int64): Float64 {
    if (k < (0 as Int64) || k > n) {
        return 0.0 / 0.0;
    }
    return ln_fact(n) - ln_fact(k) - ln_fact(n - k);
}

pub fun hypergeom_pmf(k: Int64, N: Int64, K: Int64, n: Int64): Float64 {
    if (k < (0 as Int64) || K < (0 as Int64) || n < (0 as Int64) || N <= (0 as Int64)) {
        return 0.0 / 0.0;
    }
    val lc = ln_comb(K, k) + ln_comb(N - K, n - k) - ln_comb(N, n);
    if (lc != lc) {
        return 0.0;
    }
    return lc.exp();
}

pub fun hypergeom_cdf(k: Int64, N: Int64, K: Int64, n: Int64): Float64 {
    var s = 0.0;
    var i = 0 as Int64;
    while (i <= k) {
        s = s + hypergeom_pmf(i, N, K, n);
        i = i + (1 as Int64);
    }
    return s;
}

pub fun nbinom_pmf(k: Int64, r: Int64, p: Float64): Float64 {
    if (k < (0 as Int64) || r <= (0 as Int64) || p <= 0.0 || p > 1.0) {
        return 0.0 / 0.0;
    }
    val lc = ln_comb(k + r - (1 as Int64), k);
    return (lc + (k as Float64) * (1.0 - p).log() + (r as Float64) * p.log()).exp();
}

pub fun lognormal_pdf(x: Float64, mu: Float64, sig: Float64): Float64 {
    if (x <= 0.0 || sig <= 0.0) {
        return 0.0 / 0.0;
    }
    val z = ((x.log() - mu) / sig);
    return (0.0 - z * z / 2.0).exp() / (x * sig * 2.5066282746310002);
}

pub fun weibull_pdf(x: Float64, k: Float64, lam: Float64): Float64 {
    if (x < 0.0 || k <= 0.0 || lam <= 0.0) {
        return 0.0 / 0.0;
    }
    if (x == 0.0) {
        return if (k == 1.0) { 1.0 / lam } else { if (k < 1.0) { 1.0 / 0.0 } else { 0.0 } };
    }
    return k / lam * pow(x / lam, k - 1.0) * (0.0 - pow(x / lam, k)).exp();
}

pub fun logistic_cdf(x: Float64, mu: Float64, s: Float64): Float64 {
    if (s <= 0.0) {
        return 0.0 / 0.0;
    }
    return 1.0 / (1.0 + ((mu - x) / s).exp());
}

pub fun cauchy_pdf(x: Float64, mu: Float64, gam: Float64): Float64 {
    if (gam <= 0.0) {
        return 0.0 / 0.0;
    }
    return 1.0 / (3.141592653589793 * gam * (1.0 + ((x - mu) / gam) * ((x - mu) / gam)));
}

pub fun gumbel_pdf(x: Float64, mu: Float64, b: Float64): Float64 {
    if (b <= 0.0) {
        return 0.0 / 0.0;
    }
    val z = (x - mu) / b;
    return (0.0 - z - (0.0 - z).exp()).exp() / b;
}

pub fun mvn_sample(rng: Rng, mu: Vec<Float64>, chol: Mat, n: Int64): Vec<Vec<Float64>> {
    var out: Vec<Vec<Float64>> = vec![];
    var r = 0 as Int64;
    while (r < n) {
        var z: Vec<Float64> = vec![];
        var i = 0 as Int64;
        while (i < mu.len()) {
            val adv = rng.next_f64();
            val zs = normal_sample(rng, 0.0, 1.0, 1 as Int64);
            z.push(zs[0 as Int64] + adv * 0.0);
            i = i + (1 as Int64);
        }
        val xz = match (chol.clone().mat_vec(z)) { Ok(v) -> v, Err(_) -> z.clone(), };
        var row: Vec<Float64> = vec![];
        var k = 0 as Int64;
        while (k < mu.len() && k < xz.len()) {
            row.push(mu[k] + xz[k]);
            k = k + (1 as Int64);
        }
        out.push(row);
        r = r + (1 as Int64);
    }
    return out;
}

pub fun gamma_sample(rng: Rng, a: Float64): Float64 {
    // Marsaglia-Tsang (2000) first principles over normal_sample and
    // uniform draws; shape boost for a < 1. Total: NaN for a <= 0.
    if (a != a || a <= 0.0) {
        return 0.0 / 0.0;
    }
    if (a < 1.0) {
        val g = gamma_sample(rng, a + 1.0);
        val u = rng.next_f64();
        val uu = if (u <= 0.0) { 1e-12 } else { if (u >= 1.0) { 1.0 - 1e-12 } else { u } };
        return g * pow(uu, 1.0 / a);
    }
    val d = a - 1.0 / 3.0;
    val c = 1.0 / sqrt(9.0 * d);
    var it = 0 as Int64;
    while (it < (1000 as Int64)) {
        val step = rng.next_f64();
        val zs = normal_sample(rng, 0.0, 1.0, 1 as Int64);
        val x = zs[0 as Int64] + step * 0.0;
        val v = (1.0 + c * x) * (1.0 + c * x) * (1.0 + c * x);
        if (v > 0.0) {
            val u = rng.next_f64();
            val uu = if (u <= 0.0) { 1e-12 } else { if (u >= 1.0) { 1.0 - 1e-12 } else { u } };
            if (uu.log() < 0.5 * x * x + d - d * v + d * v.log()) {
                return d * v;
            }
        }
        it = it + (1 as Int64);
    }
    return d;
}

pub fun dirichlet_sample(rng: Rng, alpha: Vec<Float64>, n: Int64): Vec<Vec<Float64>> {
    var out: Vec<Vec<Float64>> = vec![];
    var r = 0 as Int64;
    while (r < n) {
        var gs: Vec<Float64> = vec![];
        var tot = 0.0;
        var i = 0 as Int64;
        while (i < alpha.len()) {
            val adv = rng.next_f64();
            val g = gamma_sample(rng, alpha[i]) + adv * 0.0;
            gs.push(g);
            tot = tot + g;
            i = i + (1 as Int64);
        }
        var row: Vec<Float64> = vec![];
        var k = 0 as Int64;
        while (k < gs.len()) {
            row.push(gs[k] / tot);
            k = k + (1 as Int64);
        }
        out.push(row);
        r = r + (1 as Int64);
    }
    return out;
}
