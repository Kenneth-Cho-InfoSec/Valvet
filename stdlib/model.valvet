// S1 formulas + lm/glm: R-style modeling over frames, in pure Valvet on
// the M1 matrix kernels. `Formula` is data (constructor or `"y ~ x1+x2"`
// strings via split/trim); `model_frame` builds the intercept design
// matrix, dropping rows with unparseable cells (R `na.omit` semantics;
// wholly missing COLUMNS are `Err`). `lm` solves the normal equations
// with `lu_solve`; `glm_binomial` runs IRLS. Standard errors come from
// the covariance diagonal; p-values are z-approximations through D3
// (R uses t for lm; documented, conservative for large n).
//
// Fallible kernels return `Result`, and `return` is rejected inside
// match value-arms, so every unwrap below is check-then-unwrap: probe
// the result with a bool match, early-return on failure, then unwrap
// with a provably-dead dummy arm.

module std.model;

import std::frame::DynamicFrame;
import std::frame::frame_col;
import std::frame::frame_names;
import std::math::sqrt;
import std::math::exp;
import std::dist::normal_cdf;
import std::infer::f_p;
import std::infer::chisq_p;

fun vec_add(a: Vec<Float64>, b: Vec<Float64>): Vec<Float64> {
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < a.len() && i < b.len()) {
        out.push(a[i] + b[i]);
        i = i + (1 as Int64);
    }
    return out;
}

pub struct Formula { response: String, terms: Vec<String>, interactions: Vec<Interaction> }

pub struct Interaction { terms: Vec<String> }

pub fun formula_new(response: String, terms: Vec<String>): Formula {
    return Formula { response: response, terms: terms, interactions: no_inter() };
}

fun has_star(t: String): Bool {
    return t.split("*").len() != (1 as Int64);
}

fun has_colon(t: String): Bool {
    return t.split(":").len() != (1 as Int64);
}

fun strip_i_call(t: String): String {
    if (t.len() > (3 as Int64)) {
        val head = t.slice(0 as Int64, 2 as Int64);
        val tail = t.slice(t.len() - (1 as Int64), t.len());
        if (head == "I(" && tail == ")") {
            return t.slice(2 as Int64, t.len() - (1 as Int64)).trim();
        }
    }
    return t;
}

fun split_trim(s: String, sep: String): Vec<String> {
    val parts = s.split(sep);
    var out: Vec<String> = vec![];
    var i = 0 as Int64;
    while (i < parts.len()) {
        out.push(parts[i].trim());
        i = i + (1 as Int64);
    }
    return out;
}

fun has_empty(v: Vec<String>): Bool {
    var i = 0 as Int64;
    while (i < v.len()) {
        if (v[i] == "") {
            return true;
        }
        i = i + (1 as Int64);
    }
    return false;
}

fun push_unique(v: Vec<String>, t: String): Vec<String> {
    var out = v.clone();
    var i = 0 as Int64;
    var seen = false;
    while (i < out.len()) {
        if (out[i] == t) {
            seen = true;
        }
        i = i + (1 as Int64);
    }
    if (!seen) {
        out.push(t);
    }
    return out;
}

fun same_terms(a: Vec<String>, b: Vec<String>): Bool {
    if (a.len() != b.len()) {
        return false;
    }
    var i = 0 as Int64;
    while (i < a.len()) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + (1 as Int64);
    }
    return true;
}

fun push_unique_inter(v: Vec<Interaction>, t: Vec<String>): Vec<Interaction> {
    var out = v.clone();
    var i = 0 as Int64;
    var seen = false;
    while (i < out.len()) {
        if (same_terms(out[i].terms.clone(), t.clone())) {
            seen = true;
        }
        i = i + (1 as Int64);
    }
    if (!seen) {
        out.push(Interaction { terms: t });
    }
    return out;
}

fun pow2(n: Int64): Int64 {
    var r = 1 as Int64;
    var i = 0 as Int64;
    while (i < n) {
        r = r * (2 as Int64);
        i = i + (1 as Int64);
    }
    return r;
}

fun bit_set(m: Int64, b: Int64): Bool {
    return (m / pow2(b)) % (2 as Int64) == (1 as Int64);
}

fun mask_terms(parts: Vec<String>, m: Int64): Vec<String> {
    var out: Vec<String> = vec![];
    var b = 0 as Int64;
    while (b < parts.len()) {
        if (bit_set(m, b)) {
            out.push(parts[b].clone());
        }
        b = b + (1 as Int64);
    }
    return out;
}

pub fun formula_parse(s: String): Option<Formula> {
    val sides = s.split("~");
    if (sides.len() != (2 as Int64)) {
        return None;
    }
    val lhs = sides[0 as Int64].trim();
    if (lhs == "") {
        return None;
    }
    val rhs = sides[1 as Int64].clone();
    val raw = split_trim(rhs, "+");
    if (raw.len() == (0 as Int64) || has_empty(raw.clone())) {
        return None;
    }
    var terms: Vec<String> = vec![];
    var interactions: Vec<Interaction> = vec![];
    var i = 0 as Int64;
    while (i < raw.len()) {
        val t = raw[i].clone();
        val dot = t == ".";
        if (dot) {
            terms = push_unique(terms, t.clone());
        }
        if (!dot) {
            val m_ok = match (term_mains(t.clone())) { Some(_) -> true, None -> false, };
            if (!m_ok) {
                return None;
            }
            val ms = match (term_mains(t.clone())) { Some(v) -> v, None -> no_strs(), };
            var mi = 0 as Int64;
            while (mi < ms.len()) {
                terms = push_unique(terms, ms[mi].clone());
                mi = mi + (1 as Int64);
            }
            val q_ok = match (term_inters(t.clone())) { Some(_) -> true, None -> false, };
            if (!q_ok) {
                return None;
            }
            val qs = match (term_inters(t.clone())) { Some(v) -> v, None -> no_inter(), };
            var qi = 0 as Int64;
            while (qi < qs.len()) {
                interactions = push_unique_inter(interactions, qs[qi].terms.clone());
                qi = qi + (1 as Int64);
            }
        }
        i = i + (1 as Int64);
    }
    if (terms.len() == (0 as Int64) && interactions.len() == (0 as Int64)) {
        return None;
    }
    return Some(Formula { response: lhs, terms: terms, interactions: interactions });
}

fun no_inter(): Vec<Interaction> {
    var e: Vec<Interaction> = vec![];
    return e;
}

fun term_mains(t: String): Option<Vec<String>> {
    val inner = strip_i_call(t);
    if (inner == "") {
        return None;
    }
    val star = has_star(inner.clone());
    val colon = has_colon(inner.clone());
    if (star) {
        val parts = split_trim(inner.clone(), "*");
        if (has_empty(parts.clone())) {
            return None;
        }
        var bad = false;
        var k = 0 as Int64;
        while (k < parts.len()) {
            if (has_colon(parts[k].clone())) {
                bad = true;
            }
            k = k + (1 as Int64);
        }
        if (bad) {
            return None;
        }
        var out: Vec<String> = vec![];
        var j = 0 as Int64;
        while (j < parts.len()) {
            out = push_unique(out, parts[j].clone());
            j = j + (1 as Int64);
        }
        return Some(out);
    }
    if (!star && colon) {
        var e: Vec<String> = vec![];
        return Some(e);
    }
    if (!star && !colon) {
        var out: Vec<String> = vec![];
        out.push(inner.clone());
        return Some(out);
    }
    var e2: Vec<String> = vec![];
    return Some(e2);
}

fun term_inters(t: String): Option<Vec<Interaction>> {
    val inner = strip_i_call(t);
    if (inner == "") {
        return None;
    }
    val star = has_star(inner.clone());
    val colon = has_colon(inner.clone());
    if (star) {
        val parts = split_trim(inner.clone(), "*");
        if (has_empty(parts.clone())) {
            return None;
        }
        var bad = false;
        var k = 0 as Int64;
        while (k < parts.len()) {
            if (has_colon(parts[k].clone())) {
                bad = true;
            }
            k = k + (1 as Int64);
        }
        if (bad) {
            return None;
        }
        var out: Vec<Interaction> = vec![];
        var m = 0 as Int64;
        val total = pow2(parts.len());
        while (m < total) {
            val sub = mask_terms(parts.clone(), m);
            if (sub.len() >= (2 as Int64)) {
                out = push_unique_inter(out, sub);
            }
            m = m + (1 as Int64);
        }
        return Some(out);
    }
    if (!star && colon) {
        val parts = split_trim(inner.clone(), ":");
        if (parts.len() < (2 as Int64) || has_empty(parts.clone())) {
            return None;
        }
        var out: Vec<Interaction> = vec![];
        return Some(push_unique_inter(out, parts));
    }
    var e: Vec<Interaction> = vec![];
    return Some(e);
}

pub struct ModelFrame { x: Mat, y: Vec<Float64>, names: Vec<String> }

fun no_mat(): Mat {
    return mat_zeros(0 as Int64, 0 as Int64);
}

fun no_vec(): Vec<Float64> {
    return vec![0.0];
}

fun no_strs(): Vec<String> {
    return vec![""];
}

fun no_mf(): ModelFrame {
    return ModelFrame { x: no_mat(), y: no_vec(), names: no_strs() };
}

fun need_col(f: &DynamicFrame, name: String): Vec<String> {
    return match (frame_col(f, name)) { Some(v) -> v, None -> no_strs(), };
}

fun has_col(f: &DynamicFrame, name: String): Bool {
    return match (frame_col(f, name)) { Some(_) -> true, None -> false, };
}

pub fun model_frame(f: &DynamicFrame, fo: Formula): Result<ModelFrame, String> {
    if (!has_col(f, fo.response.clone())) {
        return Err("missing column: " + fo.response.clone());
    }
    val yc = need_col(f, fo.response.clone());
    // Expand `.` to every column but the response; dedupe defensively
    // (`formula_new` callers bypass the parser).
    var mains: Vec<String> = vec![];
    var ti = 0 as Int64;
    while (ti < fo.terms.len()) {
        val t = fo.terms[ti].clone();
        if (t == ".") {
            val all = frame_names(f);
            var ai = 0 as Int64;
            while (ai < all.len()) {
                if (all[ai] != fo.response) {
                    mains = push_unique(mains, all[ai].clone());
                }
                ai = ai + (1 as Int64);
            }
        } else {
            mains = push_unique(mains, t);
        }
        ti = ti + (1 as Int64);
    }
    var tcs: Vec<Vec<String>> = vec![];
    var mi = 0 as Int64;
    while (mi < mains.len()) {
        if (!has_col(f, mains[mi].clone())) {
            return Err("missing column: " + mains[mi].clone());
        }
        tcs.push(need_col(f, mains[mi].clone()));
        mi = mi + (1 as Int64);
    }
    // Interaction inputs: one string column per crossed term.
    // Empty term lists (hand-built `Formula`s only; the parser never
    // emits them) are filtered first: `if`/`else` is a value position,
    // so the skip cannot live inside the work loops below.
    var inters: Vec<Interaction> = vec![];
    var fi = 0 as Int64;
    while (fi < fo.interactions.len()) {
        val ts = fo.interactions[fi].terms.clone();
        if (ts.len() != (0 as Int64)) {
            inters.push(Interaction { terms: ts });
        }
        fi = fi + (1 as Int64);
    }
    var ics: Vec<Vec<Vec<String>>> = vec![];
    var ii = 0 as Int64;
    while (ii < inters.len()) {
        val inter = inters[ii].terms.clone();
        var cols: Vec<Vec<String>> = vec![];
        var ki = 0 as Int64;
        while (ki < inter.len()) {
            if (!has_col(f, inter[ki].clone())) {
                return Err("missing column: " + inter[ki].clone());
            }
            cols.push(need_col(f, inter[ki].clone()));
            ki = ki + (1 as Int64);
        }
        ics.push(cols);
        ii = ii + (1 as Int64);
    }
    // na.omit: keep rows where the response, every main, and every
    // interaction input parse.
    var rows: Vec<Vec<Float64>> = vec![];
    var ys: Vec<Float64> = vec![];
    var r = 0 as Int64;
    while (r < f.nrows) {
        val yv = match (yc[r].parse_float()) { Some(x) -> x, None -> 0.0 / 0.0, };
        if (yv == yv) {
            var row: Vec<Float64> = vec![];
            row.push(1.0);
            var ok = true;
            var vals: Vec<Float64> = vec![];
            var k = 0 as Int64;
            while (k < tcs.len()) {
                val xv = match (tcs[k][r].parse_float()) { Some(x) -> x, None -> 0.0 / 0.0, };
                if (xv != xv) {
                    ok = false;
                }
                vals.push(xv);
                k = k + (1 as Int64);
            }
            var q = 0 as Int64;
            while (q < ics.len()) {
                val cols = ics[q].clone();
                var prod = 1.0;
                var j = 0 as Int64;
                while (j < cols.len()) {
                    val xv = match (cols[j][r].parse_float()) { Some(x) -> x, None -> 0.0 / 0.0, };
                    if (xv != xv) {
                        ok = false;
                    }
                    prod = prod * xv;
                    j = j + (1 as Int64);
                }
                vals.push(prod);
                q = q + (1 as Int64);
            }
            if (ok) {
                var c = 0 as Int64;
                while (c < vals.len()) {
                    row.push(vals[c]);
                    c = c + (1 as Int64);
                }
                rows.push(row);
                ys.push(yv);
            }
        }
        r = r + (1 as Int64);
    }
    if (rows.len() == (0 as Int64)) {
        return Err("no complete rows");
    }
    var names: Vec<String> = vec![];
    names.push("(Intercept)");
    var ni = 0 as Int64;
    while (ni < mains.len()) {
        names.push(mains[ni]);
        ni = ni + (1 as Int64);
    }
    var qi = 0 as Int64;
    while (qi < inters.len()) {
        val iterms = inters[qi].terms.clone();
        var label = iterms[0 as Int64].clone();
        var li = 1 as Int64;
        while (li < iterms.len()) {
            label = label + ":" + iterms[li].clone();
            li = li + (1 as Int64);
        }
        names.push(label);
        qi = qi + (1 as Int64);
    }
    var ragged = false;
    var w = rows[0 as Int64].len();
    var ri = 1 as Int64;
    while (ri < rows.len()) {
        if (rows[ri].len() != w) {
            ragged = true;
        }
        ri = ri + (1 as Int64);
    }
    if (ragged) {
        return Err("design matrix failed");
    }
    val m = match (mat_from_rows(rows)) { Ok(v) -> v, Err(_) -> no_mat(), };
    return Ok(ModelFrame { x: m, y: ys, names: names });
}

pub struct LmFit {
    coef: Vec<Float64>,
    se: Vec<Float64>,
    fitted: Vec<Float64>,
    resid: Vec<Float64>,
    r2: Float64,
    sigma: Float64,
    names: Vec<String>,
}

fun vec_sub(a: Vec<Float64>, b: Vec<Float64>): Vec<Float64> {
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < a.len() && i < b.len()) {
        out.push(a[i] - b[i]);
        i = i + (1 as Int64);
    }
    return out;
}

fun vec_mean(v: Vec<Float64>): Float64 {
    if (v.len() == (0 as Int64)) {
        return 0.0 / 0.0;
    }
    var s = 0.0;
    var i = 0 as Int64;
    while (i < v.len()) {
        s = s + v[i];
        i = i + (1 as Int64);
    }
    return s / (v.len() as Float64);
}

fun sum_sq(v: Vec<Float64>, c: Float64): Float64 {
    var s = 0.0;
    var i = 0 as Int64;
    while (i < v.len()) {
        val d = v[i] - c;
        s = s + d * d;
        i = i + (1 as Int64);
    }
    return s;
}

pub fun lm(mf: ModelFrame): Result<LmFit, String> {
    val xt = mf.x.transpose();
    if (xt.cols() != mf.x.rows()) {
        return Err("X'X failed");
    }
    val xtx = match (xt.clone().matmul(mf.x.clone())) { Ok(v) -> v, Err(_) -> no_mat(), };
    if (xt.cols() != mf.y.len()) {
        return Err("X'y failed");
    }
    val xty = match (xt.clone().mat_vec(mf.y.clone())) { Ok(v) -> v, Err(_) -> no_vec(), };
    if (xtx.rows() != xtx.cols() || xtx.rows() != xty.len() || xtx.det() == 0.0) {
        return Err("singular design");
    }
    val beta = match (xtx.clone().lu_solve(xty)) { Ok(v) -> v, Err(_) -> no_vec(), };
    if (mf.x.cols() != beta.len()) {
        return Err("fitted failed");
    }
    val fitted = match (mf.x.clone().mat_vec(beta.clone())) { Ok(v) -> v, Err(_) -> no_vec(), };
    val resid = vec_sub(mf.y.clone(), fitted.clone());
    val n = mf.y.len();
    val p = beta.len();
    val rss = sum_sq(resid.clone(), 0.0);
    val tss = sum_sq(mf.y.clone(), vec_mean(mf.y.clone()));
    var r2 = 0.0 / 0.0;
    if (tss != 0.0) {
        r2 = 1.0 - rss / tss;
    }
    var sigma = 0.0;
    if (n > p) {
        sigma = sqrt(rss / ((n - p) as Float64));
    }
    if (xtx.rows() != xtx.cols() || xtx.det() == 0.0) {
        return Err("singular design");
    }
    val xtx_inv = match (xtx.clone().inverse()) { Ok(v) -> v, Err(_) -> no_mat(), };
    val dg = xtx_inv.mat_diag();
    var se: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < dg.len()) {
        se.push(sigma * sqrt(dg[i]));
        i = i + (1 as Int64);
    }
    return Ok(LmFit { coef: beta, se: se, fitted: fitted, resid: resid, r2: r2, sigma: sigma, names: mf.names.clone() });
}

pub fun lm_p(fit: &LmFit, j: Int64): Float64 {
    if (j < (0 as Int64) || j >= fit.coef.len() || j >= fit.se.len()) {
        return 0.0 / 0.0;
    }
    val z = fit.coef[j] / fit.se[j];
    val az = if (z < 0.0) { 0.0 - z } else { z };
    return 2.0 * (1.0 - normal_cdf(az, 0.0, 1.0));
}

pub struct GlmFit {
    coef: Vec<Float64>,
    se: Vec<Float64>,
    iters: Int64,
    converged: Bool,
    names: Vec<String>,
}

fun sigmoid(x: Float64): Float64 {
    return 1.0 / (1.0 + exp(0.0 - x));
}

pub fun glm_binomial(mf: ModelFrame, max_iter: Int64): Result<GlmFit, String> {
    if (max_iter < (1 as Int64)) {
        return Err("max_iter must be positive");
    }
    var i = 0 as Int64;
    while (i < mf.y.len()) {
        if (mf.y[i] != 0.0 && mf.y[i] != 1.0) {
            return Err("response must be 0/1");
        }
        i = i + (1 as Int64);
    }
    val n = mf.y.len();
    val p = mf.x.cols();
    var beta: Vec<Float64> = vec![];
    var b = 0 as Int64;
    while (b < p) {
        beta.push(0.0);
        b = b + (1 as Int64);
    }
    var it = 0 as Int64;
    var done = 0 as Int64;
    var converged = false;
    while (it < max_iter) {
        if (mf.x.cols() != beta.len()) {
            return Err("eta failed");
        }
        val eta = match (mf.x.clone().mat_vec(beta.clone())) { Ok(v) -> v, Err(_) -> no_vec(), };
        var w: Vec<Float64> = vec![];
        var wz: Vec<Float64> = vec![];
        var k = 0 as Int64;
        while (k < n) {
            var m = sigmoid(eta[k]);
            if (m < 0.000000000001) {
                m = 0.000000000001;
            }
            if (m > 0.999999999999) {
                m = 0.999999999999;
            }
            val wk = m * (1.0 - m);
            w.push(wk);
            wz.push(wk * eta[k] + (mf.y[k] - m));
            k = k + (1 as Int64);
        }
        val xt = mf.x.transpose();
        if (mf.x.rows() != w.len()) {
            return Err("X'WX failed");
        }
        val xw = match (mf.x.clone().mat_scale_rows(w.clone())) { Ok(v) -> v, Err(_) -> no_mat(), };
        if (xt.cols() != xw.rows()) {
            return Err("X'WX failed");
        }
        val xtwx = match (xt.clone().matmul(xw)) { Ok(v) -> v, Err(_) -> no_mat(), };
        if (xt.cols() != wz.len()) {
            return Err("X'Wz failed");
        }
        val xtwz = match (xt.clone().mat_vec(wz)) { Ok(v) -> v, Err(_) -> no_vec(), };
        if (xtwx.rows() != xtwx.cols() || xtwx.rows() != xtwz.len() || xtwx.det() == 0.0) {
            return Err("singular IRLS step");
        }
        val fresh = match (xtwx.clone().lu_solve(xtwz)) { Ok(v) -> v, Err(_) -> no_vec(), };
        var delta = 0.0;
        var q = 0 as Int64;
        while (q < p) {
            val d = fresh[q] - beta[q];
            val ad = if (d < 0.0) { 0.0 - d } else { d };
            if (ad > delta) {
                delta = ad;
            }
            q = q + (1 as Int64);
        }
        beta = fresh;
        done = done + (1 as Int64);
        it = it + (1 as Int64);
        if (delta < 0.00000001) {
            converged = true;
            it = max_iter;
        }
    }
    // Standard errors from the final IRLS weights.
    if (mf.x.cols() != beta.len()) {
        return Err("eta failed");
    }
    val eta2 = match (mf.x.clone().mat_vec(beta.clone())) { Ok(v) -> v, Err(_) -> no_vec(), };
    var w2: Vec<Float64> = vec![];
    var k2 = 0 as Int64;
    while (k2 < n) {
        var m = sigmoid(eta2[k2]);
        if (m < 0.000000000001) {
            m = 0.000000000001;
        }
        if (m > 0.999999999999) {
            m = 0.999999999999;
        }
        w2.push(m * (1.0 - m));
        k2 = k2 + (1 as Int64);
    }
    val xt2 = mf.x.transpose();
    if (mf.x.rows() != w2.len()) {
        return Err("X'WX failed");
    }
    val xw2 = match (mf.x.clone().mat_scale_rows(w2)) { Ok(v) -> v, Err(_) -> no_mat(), };
    if (xt2.cols() != xw2.rows()) {
        return Err("X'WX failed");
    }
    val xtwx2 = match (xt2.clone().matmul(xw2)) { Ok(v) -> v, Err(_) -> no_mat(), };
    if (xtwx2.rows() != xtwx2.cols() || xtwx2.det() == 0.0) {
        return Err("singular IRLS step");
    }
    val cov = match (xtwx2.clone().inverse()) { Ok(v) -> v, Err(_) -> no_mat(), };
    val dg = cov.mat_diag();
    var se: Vec<Float64> = vec![];
    var s2 = 0 as Int64;
    while (s2 < dg.len()) {
        se.push(sqrt(dg[s2]));
        s2 = s2 + (1 as Int64);
    }
    return Ok(GlmFit { coef: beta, se: se, iters: done, converged: converged, names: mf.names.clone() });
}

pub fun predict_lm(fit: &LmFit, mf: ModelFrame): Result<Vec<Float64>, String> {
    if (mf.x.cols() != fit.coef.len()) {
        return Err("design columns do not match fit");
    }
    val pred = match (mf.x.clone().mat_vec(fit.coef.clone())) { Ok(v) -> v, Err(_) -> no_vec(), };
    return Ok(pred);
}

pub fun predict_lm_frame(fit: &LmFit, f: &DynamicFrame, fo: Formula): Result<Vec<Float64>, String> {
    val mfo = model_frame(f, fo);
    val ok = match (mfo) { Ok(_) -> true, Err(_) -> false, };
    if (!ok) {
        return Err("model frame failed");
    }
    val mf = match (mfo) { Ok(v) -> v, Err(_) -> no_mf(), };
    return predict_lm(fit, mf);
}

pub fun predict_glm(fit: &GlmFit, mf: ModelFrame): Result<Vec<Float64>, String> {
    if (mf.x.cols() != fit.coef.len()) {
        return Err("design columns do not match fit");
    }
    val eta = match (mf.x.clone().mat_vec(fit.coef.clone())) { Ok(v) -> v, Err(_) -> no_vec(), };
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < eta.len()) {
        out.push(sigmoid(eta[i]));
        i = i + (1 as Int64);
    }
    return Ok(out);
}

pub struct AnovaLm {
    ss_reg: Float64,
    ss_res: Float64,
    df_reg: Float64,
    df_res: Float64,
    f: Float64,
    p: Float64,
    r2: Float64,
}

pub fun anova_lm(fit: &LmFit): AnovaLm {
    val n = fit.resid.len();
    val p = fit.coef.len();
    val ss_res = sum_sq(fit.resid.clone(), 0.0);
    val ybar = vec_mean(vec_add(fit.fitted.clone(), fit.resid.clone()));
    val tss = sum_sq(vec_add(fit.fitted.clone(), fit.resid.clone()), ybar);
    val ss_reg = tss - ss_res;
    val df_reg = ((p - (1 as Int64)) as Float64);
    val df_res = ((n - p) as Float64);
    if (df_res <= 0.0 || ss_res == 0.0) {
        return AnovaLm { ss_reg: ss_reg, ss_res: ss_res, df_reg: df_reg, df_res: df_res, f: 0.0 / 0.0, p: 0.0 / 0.0, r2: fit.r2 };
    }
    val f = (ss_reg / df_reg) / (ss_res / df_res);
    return AnovaLm { ss_reg: ss_reg, ss_res: ss_res, df_reg: df_reg, df_res: df_res, f: f, p: f_p(f, df_reg, df_res), r2: fit.r2 };
}

pub fun summary_lm(fit: &LmFit): String {
    var out = "n=" + to_string(fit.resid.len()) + " r2=" + to_string(fit.r2) + " sigma=" + to_string(fit.sigma) + "\n";
    out = out + "term coef se z p\n";
    var j = 0 as Int64;
    while (j < fit.coef.len() && j < fit.se.len() && j < fit.names.len()) {
        val z = fit.coef[j] / fit.se[j];
        val az = if (z < 0.0) { 0.0 - z } else { z };
        val p = 2.0 * (1.0 - normal_cdf(az, 0.0, 1.0));
        out = out + fit.names[j] + " " + to_string(fit.coef[j]) + " " + to_string(fit.se[j]) + " " + to_string(z) + " " + to_string(p) + "\n";
        j = j + (1 as Int64);
    }
    out = out + "(z approximations, not t; see module header)\n";
    return out;
}

fun cor_plain(x: Vec<Float64>, y: Vec<Float64>): Float64 {
    val n = x.len();
    if (n != y.len() || n < (2 as Int64)) {
        return 0.0 / 0.0;
    }
    val mx = vec_mean(x.clone());
    val my = vec_mean(y.clone());
    var sxy = 0.0;
    var sxx = 0.0;
    var syy = 0.0;
    var i = 0 as Int64;
    while (i < n) {
        val dx = x[i] - mx;
        val dy = y[i] - my;
        sxy = sxy + dx * dy;
        sxx = sxx + dx * dx;
        syy = syy + dy * dy;
        i = i + (1 as Int64);
    }
    if (sxx == 0.0 || syy == 0.0) {
        return 0.0 / 0.0;
    }
    return sxy / sqrt(sxx * syy);
}

pub fun cooks_distance(mf: &ModelFrame, fit: &LmFit): Result<Vec<Float64>, String> {
    if (mf.x.cols() != fit.coef.len()) {
        return Err("design columns do not match fit");
    }
    val xt = mf.x.transpose();
    val xtx = match (xt.clone().matmul(mf.x.clone())) { Ok(v) -> v, Err(_) -> no_mat(), };
    if (xtx.rows() != xtx.cols() || xtx.det() == 0.0) {
        return Err("singular design");
    }
    val inv = match (xtx.clone().inverse()) { Ok(v) -> v, Err(_) -> no_mat(), };
    // Hat diagonal without cell reads: H = X inv X', then mat_diag.
    val xt2 = mf.x.transpose();
    val hmat = match (mf.x.clone().matmul(inv.clone())) { Ok(v) -> v, Err(_) -> no_mat(), };
    val hfull = match (hmat.matmul(xt2)) { Ok(v) -> v, Err(_) -> no_mat(), };
    val h = hfull.mat_diag();
    val p = fit.coef.len();
    val n = mf.y.len();
    val s2 = fit.sigma * fit.sigma;
    var out: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < n) {
        val hii = h[i];
        if (hii == 1.0 || s2 == 0.0) {
            out.push(0.0 / 0.0);
        } else {
            val e = fit.resid[i];
            out.push(e * e / ((p as Float64) * s2) * hii / ((1.0 - hii) * (1.0 - hii)));
        }
        i = i + (1 as Int64);
    }
    return Ok(out);
}

pub fun vif(mf: &ModelFrame): Result<Vec<Float64>, String> {
    // Constant columns (e.g. the intercept) carry no variance and would
    // singular-fail below; R drops them from VIF output, and so do we.
    val p = mf.x.cols();
    var keep: Vec<Int64> = vec![];
    var a = 0 as Int64;
    while (a < p) {
        val ca = mf.x.mat_col(a);
        var constant = true;
        var i = 1 as Int64;
        while (i < ca.len()) {
            if (ca[i] != ca[0 as Int64]) {
                constant = false;
            }
            i = i + (1 as Int64);
        }
        if (!constant) {
            keep.push(a);
        }
        a = a + (1 as Int64);
    }
    if (keep.len() == (0 as Int64)) {
        return Err("no varying columns");
    }
    var rm: Vec<Vec<Float64>> = vec![];
    var ai = 0 as Int64;
    while (ai < keep.len()) {
        val ca = mf.x.mat_col(keep[ai]);
        var row: Vec<Float64> = vec![];
        var bi = 0 as Int64;
        while (bi < keep.len()) {
            val cb = mf.x.mat_col(keep[bi]);
            row.push(cor_plain(ca.clone(), cb.clone()));
            bi = bi + (1 as Int64);
        }
        rm.push(row);
        ai = ai + (1 as Int64);
    }
    val rmat = match (mat_from_rows(rm)) { Ok(v) -> v, Err(_) -> no_mat(), };
    if (rmat.rows() != rmat.cols() || rmat.det() == 0.0) {
        return Err("singular correlation");
    }
    val inv = match (rmat.clone().inverse()) { Ok(v) -> v, Err(_) -> no_mat(), };
    val dg = inv.mat_diag();
    return Ok(dg);
}


pub fun durbin_watson(fit: &LmFit): Float64 {
    val n = fit.resid.len();
    if (n < (2 as Int64)) {
        return 0.0 / 0.0;
    }
    var num = 0.0;
    var den = 0.0;
    var i = 0 as Int64;
    while (i < n) {
        den = den + fit.resid[i] * fit.resid[i];
        if (i > (0 as Int64)) {
            val d = fit.resid[i] - fit.resid[i - (1 as Int64)];
            num = num + d * d;
        }
        i = i + (1 as Int64);
    }
    if (den == 0.0) {
        return 0.0 / 0.0;
    }
    return num / den;
}

pub struct BpTest { statistic: Float64, df: Float64, p: Float64 }

pub fun breusch_pagan(mf: &ModelFrame, fit: &LmFit): Result<BpTest, String> {
    if (mf.x.cols() != fit.coef.len()) {
        return Err("design columns do not match fit");
    }
    val n = mf.y.len();
    val p = fit.coef.len();
    var e2: Vec<Float64> = vec![];
    var i = 0 as Int64;
    while (i < n) {
        e2.push(fit.resid[i] * fit.resid[i]);
        i = i + (1 as Int64);
    }
    // Auxiliary regression of squared residuals on the design (mirrors
    // `lm`'s solve chain; see that function if this diverges).
    val xt = mf.x.transpose();
    val xtx = match (xt.clone().matmul(mf.x.clone())) { Ok(v) -> v, Err(_) -> no_mat(), };
    val xty = match (xt.clone().mat_vec(e2)) { Ok(v) -> v, Err(_) -> no_vec(), };
    if (xtx.rows() != xtx.cols() || xtx.rows() != xty.len() || xtx.det() == 0.0) {
        return Err("singular design");
    }
    val beta = match (xtx.clone().lu_solve(xty)) { Ok(v) -> v, Err(_) -> no_vec(), };
    val fitted = match (mf.x.clone().mat_vec(beta)) { Ok(v) -> v, Err(_) -> no_vec(), };
    val m = vec_mean(e2.clone());
    var sst = 0.0;
    var ssr = 0.0;
    var k = 0 as Int64;
    while (k < n) {
        val d = e2[k] - m;
        sst = sst + d * d;
        val f = fitted[k] - m;
        ssr = ssr + f * f;
        k = k + (1 as Int64);
    }
    if (sst == 0.0) {
        return Err("constant residuals");
    }
    val r2 = ssr / sst;
    val stat = (n as Float64) * r2;
    val df = ((p - (1 as Int64)) as Float64);
    return Ok(BpTest { statistic: stat, df: df, p: chisq_p(stat, df) });
}
