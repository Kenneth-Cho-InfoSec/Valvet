// std::sys: scripting runtime (imp mode). Subprocess spawns are gated to
// imp (`mode exp` is hermetic); environment reads and `cwd` are also denied
// under `valvet run --hermetic`. `--hermetic` is a compile-time policy gate,
// not an OS sandbox. `run` inherits stdio and returns the exit status;
// `capture` returns stdout up to 1MB (stderr inherits, exit status dropped).

module std.sys;

pub fun run(cmd: String): Int64 {
return sys_run(cmd)
}

pub fun capture(cmd: String): String {
return sys_capture(cmd)
}

pub fun getenv(name: String): Option<String> {
return sys_getenv(name)
}

pub fun cwd(): String {
return sys_cwd()
}
