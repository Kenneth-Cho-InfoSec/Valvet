// QuickCheck (Claessen & Hughes, ICFP 2000) — port of papers/quickcheck_runner.fs (FsCheck).
//
// The F# file implements the Gen concept (sized generators: choose/elements/oneof/
// frequency/vector) and the Runner (run N random cases, report OK/counterexample).
// Valvet has no closures, no function values and no user generics, so every
// higher-order idea is specialized by hand (first-order): generators are pure
// state-passing functions over an Int64 seed (Gen specialized to Int/Vec<Int32>),
// and each property gets its own explicit 100-case loop.
//
// NOTE on RNG: Valvet's builtin Rng (`rng_seeded`) cannot be named in a function
// signature, so it cannot be threaded through generator combinators. The seed is
// therefore drawn once from `rng_seeded` and from then on a hand-rolled LCG
// (Knuth MMIX constants, wrapping Int64 arithmetic) is threaded explicitly.

// Gen specialized to Int32: new seed + drawn value (no tuples in Valvet).
struct Gen { s: Int64, v: Int32 }
// Gen specialized to Vec<Int32>.
struct GenList { s: Int64, v: Vec<Int32> }

fun lcg_next(s: Int64): Int64 {
    s * (6364136223846793005 as Int64) + (1442695040888963407 as Int64)
}

// Non-negative roll in [0, bound); bound must be > 0.
fun nonneg(r: Int64, bound: Int64): Int64 {
    var q = r % bound;
    if (q < (0 as Int64)) {
        q = q + bound
    }
    q
}

// choose: uniform in [lo, hi].
fun gen_choose(st: Int64, lo: Int32, hi: Int32): Gen {
    val ns = lcg_next(st);
    val span = (hi - lo + 1) as Int64;
    Gen { s: ns, v: (lo as Int64 + nonneg(ns, span)) as Int32 }
}

// Sized generator: uniform in [-size, size]; callers grow `size` 1..100.
fun gen_sized(st: Int64, size: Int32): Gen {
    gen_choose(st, 0 - size, size)
}

// elements: uniform pick from a fixed pool, specialized to Int.
fun gen_elements(st: Int64, pool: &Vec<Int32>): Gen {
    val ns = lcg_next(st);
    val idx = nonneg(ns, (*pool).len());
    val pick = match ((*pool).get(idx)) {
        Some(x) -> x,
        None -> 0,
    };
    Gen { s: ns, v: pick }
}

// oneof: uniform pick among three fixed strategies (first-order: no fn values).
fun gen_oneof(st: Int64, size: Int32): Gen {
    val ns = lcg_next(st);
    val tag = nonneg(ns, 3 as Int64);
    if (tag == (0 as Int64)) {
        gen_choose(ns, 0 - 5, 5)
    } else {
        if (tag == (1 as Int64)) {
            val pool = vec![0, 1, 42];
            gen_elements(ns, &pool)
        } else {
            gen_sized(ns, size)
        }
    }
}

// frequency: weighted pick [(1, const 0), (3, small -10..10), (6, sized)].
fun gen_freq(st: Int64, size: Int32): Gen {
    val ns = lcg_next(st);
    val r = nonneg(ns, 10 as Int64);
    if (r < (1 as Int64)) {
        Gen { s: ns, v: 0 }
    } else {
        if (r < (4 as Int64)) {
            gen_choose(ns, 0 - 10, 10)
        } else {
            gen_sized(ns, size)
        }
    }
}

// vector (sized int-list generator): length in [0, size], elements via frequency.
fun gen_list(st: Int64, size: Int32): GenList {
    val n0 = lcg_next(st);
    val n = nonneg(n0, (size as Int64) + (1 as Int64));
    var cur = n0;
    var out: Vec<Int32> = vec![];
    var i = 0 as Int64;
    while (i < n) {
        val g = gen_freq(cur, size);
        cur = g.s;
        out.push(g.v);
        i += 1 as Int64
    }
    GenList { s: cur, v: out }
}

fun rev(v: Vec<Int32>): Vec<Int32> {
    var out: Vec<Int32> = vec![];
    var i = v.len();
    while (i > (0 as Int64)) {
        i -= 1 as Int64;
        val x = match (v.get(i)) {
            Some(q) -> q,
            None -> 0,
        };
        out.push(x);
    }
    out
}

fun append(a: Vec<Int32>, b: Vec<Int32>): Vec<Int32> {
    var out: Vec<Int32> = vec![];
    var i = 0 as Int64;
    while (i < a.len()) {
        val x = match (a.get(i)) {
            Some(q) -> q,
            None -> 0,
        };
        out.push(x);
        i += 1 as Int64
    }
    var j = 0 as Int64;
    while (j < b.len()) {
        val y = match (b.get(j)) {
            Some(q) -> q,
            None -> 0,
        };
        out.push(y);
        j += 1 as Int64
    }
    out
}

fun veq(a: &Vec<Int32>, b: &Vec<Int32>): Bool {
    if ((*a).len() != (*b).len()) {
        return false
    }
    var i = 0 as Int64;
    while (i < (*a).len()) {
        val x = match ((*a).get(i)) {
            Some(q) -> q,
            None -> 0,
        };
        val y = match ((*b).get(i)) {
            Some(q) -> q,
            None -> 0,
        };
        if (x != y) {
            return false
        }
        i += 1 as Int64
    }
    true
}

fun max2(x: Int32, y: Int32): Int32 {
    if (x >= y) { x } else { y }
}

// Section 2 properties, hardcoded.
fun prop_rev_unit(x: Int32): Bool {
    var a: Vec<Int32> = vec![];
    a.push(x);
    val r = rev(a.clone());
    veq(&r, &a)
}

fun prop_rev_app(xs: &Vec<Int32>, ys: &Vec<Int32>): Bool {
    val lhs = rev(append((*xs).clone(), (*ys).clone()));
    val rxs = rev((*xs).clone());
    val rys = rev((*ys).clone());
    val rhs = append(rys, rxs);
    veq(&lhs, &rhs)
}

fun prop_rev_rev(xs: &Vec<Int32>): Bool {
    val r = rev((*xs).clone());
    val rr = rev(r);
    veq(&rr, xs)
}

// (x <= y) ==> max x y == y
fun prop_max_le(x: Int32, y: Int32): Bool {
    if (x <= y) { max2(x, y) == y } else { true }
}

// The paper's mistaken revApp variant: reverse(xs++ys) == reverse xs ++ reverse ys.
fun prop_rev_app_wrong(xs: &Vec<Int32>, ys: &Vec<Int32>): Bool {
    val lhs = rev(append((*xs).clone(), (*ys).clone()));
    val rxs = rev((*xs).clone());
    val rys = rev((*ys).clone());
    val rhs = append(rxs, rys);
    veq(&lhs, &rhs)
}

fun main() {
    println("QuickCheck (Claessen & Hughes 2000): sized generators + 100-case runner");
    val r = rng_seeded(2000);
    val st0 = r.next_int(1000000 as Int64);
    println("seed: " + to_string(st0));
    var st = st0;
    // Demonstrate each combinator with one draw.
    val c0 = gen_choose(st, 1, 6);
    st = c0.s;
    println("choose(1,6) sample: " + to_string(c0.v));
    val pool = vec![10, 20, 30];
    val e0 = gen_elements(st, &pool);
    st = e0.s;
    println("elements([10,20,30]) sample: " + to_string(e0.v));
    val o0 = gen_oneof(st, 5);
    st = o0.s;
    println("oneof sample: " + to_string(o0.v));
    val f0 = gen_freq(st, 5);
    st = f0.s;
    println("frequency sample: " + to_string(f0.v));
    val l0 = gen_list(st, 5);
    st = l0.s;
    println("vector sample: " + to_string(l0.v.len()) + " elems");
    // prop_RevUnit
    var p1 = 0;
    var f1 = false;
    var x1 = 0;
    for (i in 0..100) {
        val size = i + 1;
        val g = gen_sized(st, size);
        st = g.s;
        if (prop_rev_unit(g.v)) {
            p1 += 1
        } else {
            f1 = true;
            x1 = g.v;
            break
        }
    }
    if (f1) {
        println("prop_RevUnit: *** FAILED *** counterexample x=" + to_string(x1))
    } else {
        println("prop_RevUnit: OK, passed " + to_string(p1) + " tests")
    }
    // prop_RevApp
    var p2 = 0;
    var f2 = false;
    var cx2: Vec<Int32> = vec![];
    var cy2: Vec<Int32> = vec![];
    for (i in 0..100) {
        val size = i + 1;
        val gx = gen_list(st, size);
        st = gx.s;
        val gy = gen_list(st, size);
        st = gy.s;
        if (prop_rev_app(&gx.v, &gy.v)) {
            p2 += 1
        } else {
            f2 = true;
            cx2 = gx.v.clone();
            cy2 = gy.v.clone();
            break
        }
    }
    if (f2) {
        println("prop_RevApp: *** FAILED *** counterexample xs= (see next) ys= (see after)");
        println(cx2);
        println(cy2)
    } else {
        println("prop_RevApp: OK, passed " + to_string(p2) + " tests")
    }
    // prop_RevRev
    var p3 = 0;
    var f3 = false;
    var cx3: Vec<Int32> = vec![];
    for (i in 0..100) {
        val size = i + 1;
        val gx = gen_list(st, size);
        st = gx.s;
        if (prop_rev_rev(&gx.v)) {
            p3 += 1
        } else {
            f3 = true;
            cx3 = gx.v.clone();
            break
        }
    }
    if (f3) {
        println("prop_RevRev: *** FAILED *** counterexample xs= (see next)");
        println(cx3)
    } else {
        println("prop_RevRev: OK, passed " + to_string(p3) + " tests")
    }
    // prop_MaxLe
    var p4 = 0;
    var f4 = false;
    var mx = 0;
    var my = 0;
    for (i in 0..100) {
        val size = i + 1;
        val gx = gen_oneof(st, size);
        st = gx.s;
        val gy = gen_oneof(st, size);
        st = gy.s;
        if (prop_max_le(gx.v, gy.v)) {
            p4 += 1
        } else {
            f4 = true;
            mx = gx.v;
            my = gy.v;
            break
        }
    }
    if (f4) {
        println("prop_MaxLe: *** FAILED *** counterexample x=" + to_string(mx) + " y=" + to_string(my))
    } else {
        println("prop_MaxLe: OK, passed " + to_string(p4) + " tests")
    }
    // Broken variant: the runner must catch it.
    var p5 = 0;
    var f5 = false;
    var cx5: Vec<Int32> = vec![];
    var cy5: Vec<Int32> = vec![];
    for (i in 0..100) {
        val size = i + 1;
        val gx = gen_list(st, size);
        st = gx.s;
        val gy = gen_list(st, size);
        st = gy.s;
        if (prop_rev_app_wrong(&gx.v, &gy.v)) {
            p5 += 1
        } else {
            f5 = true;
            cx5 = gx.v.clone();
            cy5 = gy.v.clone();
            break
        }
    }
    if (f5) {
        println("prop_RevAppWrong: *** FAILED as expected *** after " + to_string(p5) + " passed, counterexample:");
        println(cx5);
        println(cy5)
    } else {
        println("prop_RevAppWrong: UNEXPECTEDLY PASSED " + to_string(p5) + " tests")
    }
}
