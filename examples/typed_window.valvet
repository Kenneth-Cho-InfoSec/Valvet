import std::schema::parse_factor_col;
import std::typed_frame::Column;
import std::typed_frame::TypedFrame;
import std::typed_frame::col_strings;
import std::typed_frame::tf_col_at;
import std::typed_frame::tf_kinds;
import std::typed_frame::tf_names;
import std::typed_frame::SortKey;
import std::typed_frame::sort_key;
import std::typed_frame::tf_new;
import std::typed_frame::tf_nrows;
import std::typed_stats::tf_describe;
import std::typed_window::WindowExpr;
import std::typed_window::tf_window_mutate;
import std::typed_window::window_spec;

fun empty_names(): Vec<String> { return vec![]; }
fun empty_cols(): Vec<Column> { return vec![]; }

fun unwrap_tf(r: Result<TypedFrame, String>): TypedFrame {
    match (r) {
        Ok(t) -> t,
        Err(e) -> { println(e); TypedFrame { names: empty_names(), cols: empty_cols(), nrows: 0 as Int64 } },
    }
}

fun show(t: &TypedFrame) {
    println(tf_names(t));
    println(tf_kinds(t));
    println(tf_nrows(t));
    var i = 0 as Int64;
    while (i < tf_names(t).len()) {
        val c = tf_col_at(t, i);
        match (c) { Some(col) -> println(col_strings(col)), None -> println("missing") };
        i = i + (1 as Int64);
    }
}

fun frame(): TypedFrame {
    val i: Vec<Missing<Int64>> = vec![Missing::Present(1 as Int64), Missing::Present(2 as Int64), Missing::Present(3 as Int64)];
    val f: Vec<Missing<Float64>> = vec![Missing::Present(1.5), Missing, Missing::Present(2.5)];
    val b: Vec<Missing<Bool>> = vec![Missing::Present(true), Missing::Present(false), Missing];
    val s: Vec<Missing<String>> = vec![Missing::Present("a".clone()), Missing, Missing::Present("c".clone())];
    val g = parse_factor_col(vec!["x".clone(), "y".clone(), "x".clone()]);
    val cols: Vec<Column> = vec![Column::Int(i), Column::Float(f), Column::Bool(b), Column::Str(s), Column::Factor(g)];
    val names: Vec<String> = vec!["i".clone(), "f".clone(), "b".clone(), "s".clone(), "g".clone()];
    return unwrap_tf(tf_new(names, cols, 3 as Int64));
}

fun main() {
    val t = frame();
    val spec = window_spec(vec!["g".clone()], vec![sort_key("i".clone(), true)]);
    val f1 = unwrap_tf(tf_window_mutate(t, "lag".clone(), spec, WindowExpr::Lag("i".clone(), 1 as Int64)));
    val spec2 = window_spec(vec!["g".clone()], vec![sort_key("i".clone(), true)]);
    val f2 = unwrap_tf(tf_window_mutate(f1, "lead".clone(), spec2, WindowExpr::Lead("i".clone(), 1 as Int64)));
    show(&f2);
}
