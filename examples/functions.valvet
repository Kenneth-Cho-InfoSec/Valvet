fun add(a: Int32, b: Int32): Int32 {
    a + b
}

fun classify(n: Int32): String {
    if (n > 0) { "positive" } else { "non-positive" }
}

fun main() {
    println(add(20, 22))
    println(classify(7))
    var total = 0
    var i = 1
    while (i <= 10) {
        total += i
        i += 1
    }
    println(total)
}
