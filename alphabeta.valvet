// Negamax with alpha-beta pruning (Shannon 1950: minimax with cutoffs)
// ported to Valvet on TIC-TAC-TOE. Full chess move generation is out of
// scope for a first-order port (no user generics, no higher-order
// functions, no objects); the search algorithm itself -- negamax,
// alpha-beta cutoffs, exact terminal scoring -- is Shannon's.
//
// Board: Vec<Int32> length 9 (0 empty, 1 X, 2 O), side to move 1 or 2.
// Score is from the side-to-move's view: +1 win, 0 draw, -1 loss.
// Move order is fixed 0..8; ties keep the first (lowest-index) move,
// so results are deterministic and match papers/alphabeta_ref.py exactly.
//
// Deviations from an in-place engine, all disclosed:
// - No globals and no reborrows exist in Valvet (passing &mut moves it,
//   and `&mut *b` on a parameter is rejected), so each child gets a
//   cloned board instead of make/unmake on one board. Node counts and
//   (value, move) results are unaffected.
// - The visited-node counter is threaded through the Score return struct.

struct Score { value: Int32, mv: Int64, nodes: Int64 }

fun linev(b: &Vec<Int32>, a: Int64, c: Int64, d: Int64): Int32 {
    val x = (*b)[a]
    if (x != 0 && x == (*b)[c] && x == (*b)[d]) { x } else { 0 }
}

fun winner(b: &Vec<Int32>): Int32 {
    var w = linev(b, 0 as Int64, 1 as Int64, 2 as Int64)
    if (w == 0) {
        w = linev(b, 3 as Int64, 4 as Int64, 5 as Int64)
    }
    if (w == 0) {
        w = linev(b, 6 as Int64, 7 as Int64, 8 as Int64)
    }
    if (w == 0) {
        w = linev(b, 0 as Int64, 3 as Int64, 6 as Int64)
    }
    if (w == 0) {
        w = linev(b, 1 as Int64, 4 as Int64, 7 as Int64)
    }
    if (w == 0) {
        w = linev(b, 2 as Int64, 5 as Int64, 8 as Int64)
    }
    if (w == 0) {
        w = linev(b, 0 as Int64, 4 as Int64, 8 as Int64)
    }
    if (w == 0) {
        w = linev(b, 2 as Int64, 4 as Int64, 6 as Int64)
    }
    w
}

fun full(b: &Vec<Int32>): Bool {
    var f = true
    var m = 0 as Int64
    while (m < (9 as Int64)) {
        if ((*b)[m] == 0) {
            f = false
        }
        m += 1 as Int64
    }
    f
}

// Negamax with alpha-beta pruning. Counts 1 node per call.
fun negamax_ab(b: Vec<Int32>, side: Int32, alpha: Int32, beta: Int32): Score {
    val w = winner(&b)
    if (w != 0) {
        if (w == side) {
            Score { value: 1, mv: (0 - 1) as Int64, nodes: 1 as Int64 }
        } else {
            Score { value: 0 - 1, mv: (0 - 1) as Int64, nodes: 1 as Int64 }
        }
    } else if (full(&b)) {
        Score { value: 0, mv: (0 - 1) as Int64, nodes: 1 as Int64 }
    } else {
        var best = 0 - 2
        var bestmv = (0 - 1) as Int64
        var nodes = 1 as Int64
        var a = alpha
        var m = 0 as Int64
        var cutoff = false
        while (m < (9 as Int64) && cutoff == false) {
            if (b[m] == 0) {
                var nb = b.clone()
                nb[m] = side
                val child = negamax_ab(nb, 3 - side, 0 - beta, 0 - a)
                nodes = nodes + child.nodes
                val v = 0 - child.value
                if (v > best) {
                    best = v
                    bestmv = m
                }
                if (best > a) {
                    a = best
                }
                if (a >= beta) {
                    cutoff = true
                }
            }
            m += 1 as Int64
        }
        Score { value: best, mv: bestmv, nodes: nodes }
    }
}

// Plain negamax without pruning (baseline for the node-count test).
fun negamax_full(b: Vec<Int32>, side: Int32): Score {
    val w = winner(&b)
    if (w != 0) {
        if (w == side) {
            Score { value: 1, mv: (0 - 1) as Int64, nodes: 1 as Int64 }
        } else {
            Score { value: 0 - 1, mv: (0 - 1) as Int64, nodes: 1 as Int64 }
        }
    } else if (full(&b)) {
        Score { value: 0, mv: (0 - 1) as Int64, nodes: 1 as Int64 }
    } else {
        var best = 0 - 2
        var bestmv = (0 - 1) as Int64
        var nodes = 1 as Int64
        var m = 0 as Int64
        while (m < (9 as Int64)) {
            if (b[m] == 0) {
                var nb = b.clone()
                nb[m] = side
                val child = negamax_full(nb, 3 - side)
                nodes = nodes + child.nodes
                val v = 0 - child.value
                if (v > best) {
                    best = v
                    bestmv = m
                }
            }
            m += 1 as Int64
        }
        Score { value: best, mv: bestmv, nodes: nodes }
    }
}

// One test position: best-move + value from both searches, node counts,
// and whether the two searches agree.
fun show(tag: String, side: Int32, b: Vec<Int32>) {
    val ab = negamax_ab(b.clone(), side, 0 - 2, 2)
    val fu = negamax_full(b.clone(), side)
    println(tag)
    println(ab.value)
    println(ab.mv)
    println(ab.nodes)
    println(fu.value)
    println(fu.mv)
    println(fu.nodes)
    println(ab.value == fu.value && ab.mv == fu.mv)
}

fun main() {
    show("empty-X-draw", 1, vec![0, 0, 0, 0, 0, 0, 0, 0, 0])
    show("X-wins-in-one", 1, vec![1, 1, 0, 2, 2, 0, 0, 0, 0])
    show("X-must-block", 1, vec![2, 2, 0, 1, 0, 0, 0, 0, 0])
    show("O-wins-in-one", 2, vec![2, 2, 0, 1, 1, 0, 0, 0, 0])
    show("last-move-draw", 1, vec![1, 2, 1, 1, 2, 2, 2, 1, 0])
    show("midgame", 1, vec![1, 0, 2, 0, 1, 0, 0, 0, 0])
    val e = vec![0, 0, 0, 0, 0, 0, 0, 0, 0]
    val eab = negamax_ab(e.clone(), 1, 0 - 2, 2)
    val efu = negamax_full(e.clone(), 1)
    println("empty")
    println(eab.nodes)
    println(efu.nodes)
    println(eab.nodes < efu.nodes)
}
