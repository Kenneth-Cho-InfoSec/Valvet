module shapes;

pub struct Point { x: Int32, y: Int32 }

pub fun origin(): Point {
    Point { x: 3, y: 4 }
}

pub fun stag(): Int32 {
    tag()
}

fun tag(): Int32 {
    2
}

pub enum Shade { Light, Dark }

pub fun shade_n(s: Shade): Int32 {
    match (s) {
        Shade::Light -> 10,
        Shade::Dark -> 20,
    }
}
