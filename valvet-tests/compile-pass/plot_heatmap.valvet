import std::plot::plot_heatmap;
import std::plot::plot_svg;

fun main() {
    val m = match (mat_from_rows(vec![vec![1.0, 2.0, 3.0], vec![4.0, 5.0, 6.0]])) {
        Ok(v) -> v,
        Err(_) -> mat_zeros(0, 0),
    };
    println(match (plot_svg(plot_heatmap(m))) { Ok(s) -> s, Err(e) -> e, });
    println(match (plot_svg(plot_heatmap(mat_identity(3)))) { Ok(s) -> s, Err(e) -> e, });
    println(match (plot_svg(plot_heatmap(mat_zeros(2, 2)))) { Ok(s) -> s, Err(e) -> e, });
}
