import std::missing::add_m;
import std::missing::sub_m;
import std::missing::mul_m;
import std::missing::div_m;
import std::missing::neg_m;
fun go(): Int32 {
println(add_m(Missing::Present(1.0), Missing::Present(2.0)));
println(add_m(Missing::Present(1.0), Missing));
println(sub_m(Missing, Missing::Present(1.0)));
println(mul_m(Missing::Present(2.0), Missing::Present(3.0)));
println(div_m(Missing::Present(1.0), Missing::Present(0.0)));
println(div_m(Missing::Present(1.0), Missing::Present(4.0)));
println(neg_m(Missing::Present(1.5)));
println(neg_m(Missing));
return 0;
}
fun main() {
println(go())
}
