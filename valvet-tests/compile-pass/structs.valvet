struct Point {
    x: Float64,
    y: Float64
}

struct User {
    name: String,
    age: Int32
}

fun origin(): Point {
    Point { x: 0.0, y: 0.0 }
}

fun main() {
    val p = Point { x: 1.5, y: 2.5 }
    println(p.x + p.y)
    val u = User { name: "ada", age: 36 }
    println(u.age)
    println(origin().x)
    var q = p
    q = Point { x: 9.0, y: 9.0 }
    println(q.x)
}
