import std::plot::plot_violin;
import std::plot::plot_svg;

fun main() {
    val data: Vec<Float64> = vec![1.0, 2.0, 2.0, 3.0, 4.0, 8.0];
    println(match (plot_svg(plot_violin(data.clone(), 2.0))) { Ok(s) -> s, Err(e) -> e, });
    println(match (plot_svg(plot_violin(vec![5.0, 5.0], 0.0))) { Ok(s) -> s, Err(e) -> e, });
}
