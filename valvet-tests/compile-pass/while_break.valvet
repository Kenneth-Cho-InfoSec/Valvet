fun main() {
    var x = 5
    while (x > 0) {
        x = x - 1
        if (x == 2) {
            break
        }
    }
    println(x)
    var y = 0
    var s = 0
    while (y < 10) {
        y = y + 1
        if (y % 2 == 0) {
            continue
        }
        s = s + y
    }
    println(s)
}
