fun empty_names(): Vec<String> { return vec![]; }
fun empty_cols(): Vec<Column> { return vec![]; }

fun unwrap_tf(r: Result<TypedFrame, String>): TypedFrame {
    match (r) {
        Ok(t) -> t,
        Err(e) -> { println(e); TypedFrame { names: empty_names(), cols: empty_cols(), nrows: 0 as Int64 } },
    }
}

fun show(t: &TypedFrame) {
    println(tf_names(t));
    println(tf_nrows(t));
    println(tf_kinds(t));
    var i = 0 as Int64;
    while (i < tf_names(t).len()) {
        val c = tf_col_at(t, i);
        match (c) {
            Some(col) -> println(col_strings(col)),
            None -> println("missing"),
        };
        i = i + (1 as Int64);
    }
}

fun show_opt_f(o: Option<Float64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_opt_i(o: Option<Int64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_err(r: Result<TypedFrame, String>) {
    match (r) { Ok(t) -> show(&t), Err(e) -> println(e) };
}

fun suffix_left(): TypedFrame {
    val id: Vec<Missing<Int64>> = vec![Missing::Present(1 as Int64), Missing::Present(2 as Int64)];
    val x: Vec<Missing<String>> = vec![Missing::Present("l1".clone()), Missing::Present("l2".clone())];
    val xr: Vec<Missing<String>> = vec![Missing::Present("lr1".clone()), Missing::Present("lr2".clone())];
    val z: Vec<Missing<String>> = vec![Missing::Present("lz1".clone()), Missing::Present("lz2".clone())];
    val cols: Vec<Column> = vec![Column::Int(id), Column::Str(x), Column::Str(xr), Column::Str(z)];
    val names: Vec<String> = vec!["id".clone(), "x".clone(), "x_right".clone(), "z".clone()];
    return unwrap_tf(tf_new(names, cols, 2 as Int64));
}

fun suffix_right(): TypedFrame {
    val id: Vec<Missing<Int64>> = vec![Missing::Present(1 as Int64), Missing::Present(2 as Int64)];
    val x: Vec<Missing<String>> = vec![Missing::Present("r1".clone()), Missing::Present("r2".clone())];
    val z: Vec<Missing<String>> = vec![Missing::Present("rz1".clone()), Missing::Present("rz2".clone())];
    val cols: Vec<Column> = vec![Column::Int(id), Column::Str(x), Column::Str(z)];
    val names: Vec<String> = vec!["id".clone(), "x".clone(), "z".clone()];
    return unwrap_tf(tf_new(names, cols, 2 as Int64));
}

fun main() {
    val l = suffix_left();
    val r = suffix_right();
    match (tf_join_inner(&l, vec!["id".clone()], &r, vec!["id".clone()])) {
        Ok(j) -> { val f = tf_join_frame(&j); show(&f); },
        Err(e) -> println(e),
    };
}
