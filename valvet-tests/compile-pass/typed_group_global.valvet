fun empty_names(): Vec<String> { return vec![]; }
fun empty_cols(): Vec<Column> { return vec![]; }

fun unwrap_tf(r: Result<TypedFrame, String>): TypedFrame {
    match (r) {
        Ok(t) -> t,
        Err(e) -> { println(e); TypedFrame { names: empty_names(), cols: empty_cols(), nrows: 0 as Int64 } },
    }
}

fun show(t: &TypedFrame) {
    println(tf_names(t));
    println(tf_nrows(t));
    println(tf_kinds(t));
    var i = 0 as Int64;
    while (i < tf_names(t).len()) {
        val c = tf_col_at(t, i);
        match (c) {
            Some(col) -> println(col_strings(col)),
            None -> println("missing"),
        };
        i = i + (1 as Int64);
    }
}

fun show_opt_f(o: Option<Float64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_opt_i(o: Option<Int64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_err(r: Result<TypedFrame, String>) {
    match (r) { Ok(t) -> show(&t), Err(e) -> println(e) };
}

fun base_frame(): TypedFrame {
    val ints: Vec<Missing<Int64>> = vec![Missing::Present(1 as Int64), Missing, Missing::Present(3 as Int64), Missing::Present(4 as Int64)];
    val floats: Vec<Missing<Float64>> = vec![Missing::Present(1.5), Missing, Missing::Present(2.5), Missing::Present(4.0)];
    val bools: Vec<Missing<Bool>> = vec![Missing::Present(true), Missing, Missing::Present(false), Missing::Present(true)];
    val strs: Vec<Missing<String>> = vec![Missing::Present("a".clone()), Missing, Missing::Present("".clone()), Missing::Present("c".clone())];
    val fac = parse_factor_col(vec!["a".clone(), "b".clone(), "a".clone(), "".clone()]);
    val cols: Vec<Column> = vec![Column::Int(ints), Column::Float(floats), Column::Bool(bools), Column::Str(strs), Column::Factor(fac)];
    val names: Vec<String> = vec!["i".clone(), "f".clone(), "b".clone(), "s".clone(), "g".clone()];
    return unwrap_tf(tf_new(names, cols, 4 as Int64));
}

fun group_frame(): TypedFrame {
    val k1: Vec<Missing<String>> = vec![Missing::Present("b".clone()), Missing::Present("a".clone()), Missing::Present("b".clone()), Missing::Present("a".clone()), Missing, Missing::Present("b".clone())];
    val k2: Vec<Missing<Int64>> = vec![Missing::Present(1 as Int64), Missing::Present(1 as Int64), Missing::Present(2 as Int64), Missing::Present(1 as Int64), Missing::Present(1 as Int64), Missing];
    val x: Vec<Missing<Int64>> = vec![Missing::Present(10 as Int64), Missing::Present(20 as Int64), Missing::Present(30 as Int64), Missing::Present(40 as Int64), Missing::Present(50 as Int64), Missing::Present(60 as Int64)];
    val y: Vec<Missing<Float64>> = vec![Missing::Present(1.5), Missing::Present(2.5), Missing::Present(3.5), Missing, Missing::Present(5.5), Missing::Present(6.5)];
    val s: Vec<Missing<String>> = vec![Missing::Present("u".clone()), Missing::Present("v".clone()), Missing::Present("w".clone()), Missing::Present("x".clone()), Missing::Present("y".clone()), Missing::Present("z".clone())];
    val b: Vec<Missing<Bool>> = vec![Missing::Present(true), Missing::Present(false), Missing::Present(true), Missing::Present(false), Missing::Present(true), Missing::Present(false)];
    val cols: Vec<Column> = vec![Column::Str(k1), Column::Int(k2), Column::Int(x), Column::Float(y), Column::Str(s), Column::Bool(b)];
    val names: Vec<String> = vec!["k1".clone(), "k2".clone(), "x".clone(), "y".clone(), "s".clone(), "b".clone()];
    return unwrap_tf(tf_new(names, cols, 6 as Int64));
}

fun empty_grouped(): GroupedFrame {
    val ids: Vec<Int64> = vec![];
    val first: Vec<Int64> = vec![];
    val keys: Vec<String> = vec![];
    return GroupedFrame { frame: group_frame(), keys: keys, index: GroupIndex { ids: ids, first_rows: first, n_groups: 0 as Int64 } };
}

fun unwrap_group(r: Result<GroupedFrame, String>): GroupedFrame {
    match (r) { Ok(g) -> g, Err(e) -> { println(e); empty_grouped() } }
}

fun main() {
    val grp = unwrap_group(tf_group_by(group_frame(), vec![]));
    println(grouped_n_groups(&grp));
    val specs: Vec<AggSpec> = vec![agg_spec("n".clone(), agg_count()), agg_spec("sx".clone(), agg_sum("x".clone()))];
    val out = unwrap_tf(tf_summarise(grp, specs));
    show(&out);
}
