fun empty_names(): Vec<String> { return vec![]; }
fun empty_cols(): Vec<Column> { return vec![]; }

fun unwrap_tf(r: Result<TypedFrame, String>): TypedFrame {
    match (r) {
        Ok(t) -> t,
        Err(e) -> { println(e); TypedFrame { names: empty_names(), cols: empty_cols(), nrows: 0 as Int64 } },
    }
}

fun show(t: &TypedFrame) {
    println(tf_names(t));
    println(tf_nrows(t));
    println(tf_kinds(t));
    var i = 0 as Int64;
    while (i < tf_names(t).len()) {
        val c = tf_col_at(t, i);
        match (c) {
            Some(col) -> println(col_strings(col)),
            None -> println("missing"),
        };
        i = i + (1 as Int64);
    }
}

fun show_opt_f(o: Option<Float64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_opt_i(o: Option<Int64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_err(r: Result<TypedFrame, String>) {
    match (r) { Ok(t) -> show(&t), Err(e) -> println(e) };
}

fun factor_left(): TypedFrame {
    val g = parse_factor_col(vec!["a".clone(), "b".clone(), "a".clone(), "".clone()]);
    val v: Vec<Missing<Int64>> = vec![Missing::Present(10 as Int64), Missing::Present(20 as Int64), Missing::Present(30 as Int64), Missing::Present(40 as Int64)];
    val cols: Vec<Column> = vec![Column::Factor(g), Column::Int(v)];
    val names: Vec<String> = vec!["g".clone(), "v".clone()];
    return unwrap_tf(tf_new(names, cols, 4 as Int64));
}

fun factor_right(): TypedFrame {
    val g = parse_factor_col(vec!["b".clone(), "a".clone(), "c".clone(), "".clone()]);
    val w: Vec<Missing<Int64>> = vec![Missing::Present(200 as Int64), Missing::Present(100 as Int64), Missing::Present(300 as Int64), Missing::Present(400 as Int64)];
    val cols: Vec<Column> = vec![Column::Factor(g), Column::Int(w)];
    val names: Vec<String> = vec!["g".clone(), "w".clone()];
    return unwrap_tf(tf_new(names, cols, 4 as Int64));
}

fun main() {
    val l = factor_left();
    val r = factor_right();
    match (tf_join_inner(&l, vec!["g".clone()], &r, vec!["g".clone()])) {
        Ok(j) -> {
            val f = tf_join_frame(&j);
            show(&f);
            val g = match (tf_factor_col(&f, "g".clone())) { Some(v) -> v, None -> parse_factor_col(vec![]) };
            println(g.levels());
            println(g.codes());
        },
        Err(e) -> println(e),
    };
}
