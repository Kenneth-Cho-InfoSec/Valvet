import std::plot::qq_standardized;
import std::plot::qq_theoretical;

fun main() {
    val d2: Vec<Float64> = vec![-2.5, 0.125, 0.125, 3.75, 10.0, 10.0, 0.5];
    val z = qq_standardized(d2.clone());
    var i = 0 as Int64;
    while (i < z.len()) {
        println(z[i]);
        i = i + (1 as Int64);
    }
    val t = qq_theoretical(7 as Int64);
    var j = 0 as Int64;
    while (j < t.len()) {
        println(t[j]);
        j = j + (1 as Int64);
    }
}
