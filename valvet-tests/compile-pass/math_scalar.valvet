import std::math::abs;
import std::math::min;
import std::math::max;
import std::math::clamp;
import std::math::floor;
import std::math::ceil;
import std::math::trunc;
import std::math::round;
import std::math::eps;
import std::math::sinh;
import std::math::cosh;
import std::math::tanh;
import std::math::asinh;
import std::math::acosh;
import std::math::atanh;
import std::math::pow_int;

fun main() {
    val nz = 0.0 * (0.0 - 1.0);
    println(abs(0.0 - 3.0));
    println(1.0 / abs(nz));
    println(1.0 / min(nz, 0.0));
    println(1.0 / max(nz, 0.0));
    val nan = 0.0 / 0.0;
    println(min(nan, 1.0) != min(nan, 1.0));
    println(clamp(5.0, 0.0, 3.0));
    println(clamp(0.0 - 1.0, 0.0, 3.0));
    println(floor(2.7));
    println(floor(0.0 - 2.1));
    println(ceil(2.1));
    println(1.0 / ceil(0.0 - 0.5));
    println(trunc(2.9));
    println(1.0 / trunc(0.0 - 0.5));
    println(round(2.5));
    println(round(3.5));
    println(1.0 / round(0.0 - 0.5));
    println(eps(1.0));
    println(eps(0.0));
    println(cosh(0.0));
    println(tanh(0.0));
    println(1.0 / asinh(nz));
    println(acosh(1.0));
    println(atanh(0.0));
    println(pow_int(2.0, 10));
    println(pow_int(2.0, 0 - 2));
    val inf = 1.0 / 0.0;
    val big = 4503599627370496.0;
    println(floor(inf) == inf);
    println(ceil(0.0 - inf) == 0.0 - inf);
    println(floor(nan) != floor(nan));
    println(floor(big) == big);
    println(trunc(0.0 - big) == 0.0 - big);
    println(round(0.0 - 2.5));
    println(eps(0.5));
    println(eps(big));
    println(1.0 / sinh(nz));
    println(acosh(inf) == inf);
    println(1.0 / atanh(nz));
    println(abs(sinh(1.0) - 1.1752011936438014) < 0.000000000000001);
    println(abs(atanh(0.5) - 0.5493061443340549) < 0.000000000000001);
}
