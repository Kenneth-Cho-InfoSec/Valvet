import std::csv::CsvTable;
import std::frame::frame_from_table;
import std::model::formula_parse;
import std::model::model_frame;
import std::model::lm;
fun go(): Int32 {
val h = vec!["a", "b", "y"]
val r0 = vec!["1", "1", "9.98"]
val r1 = vec!["1", "2", "17.01"]
val r2 = vec!["1", "3", "23.99"]
val r3 = vec!["2", "1", "16.0"]
val r4 = vec!["2", "2", "26.98"]
val r5 = vec!["2", "3", "38.01"]
val r6 = vec!["3", "1", "22.02"]
val r7 = vec!["3", "2", "37.0"]
val r8 = vec!["3", "3", "51.98"]
val r9 = vec!["4", "1", "27.99"]
val r10 = vec!["4", "2", "47.02"]
val r11 = vec!["4", "3", "66.0"]
val t = frame_from_table(CsvTable { header: h, rows: vec![r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11] })
let Some(fo) = formula_parse("y ~ a*b") else {
return 1
}
let Ok(mf) = model_frame(&t, fo) else {
return 1
}
let Ok(fit) = lm(mf) else {
return 1
}
println(fit.coef)
return 0
}
fun main() {
println(go())
}
