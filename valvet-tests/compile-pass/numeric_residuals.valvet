import std::numeric::zeros;
import std::numeric::rms;
import std::numeric::rms_parts;
import std::numeric::scaled_residual;
import std::numeric::scaled_residual2;

fun main() {
    val empty = zeros(0);
    println(rms(&empty));
    val two = vec![3.0, 4.0];
    println(rms(&two));
    val a1 = vec![3.0];
    val b1 = vec![4.0];
    println(rms_parts(&a1, &b1));
    val a2 = vec![1.0, 2.0];
    val b2 = vec![3.0];
    println(rms_parts(&a2, &b2));
    val x = vec![2.0, 0.0 - 3.0, 4.0];
    val u0 = vec![1.0, 0.0 - 2.0, 0.0];
    val u1 = vec![0.0 - 1.0, 2.0, 3.0];
    val r = scaled_residual(&x, &u0, &u1, 1.0, 2.0);
    println(r[0]);
    println(r[1]);
    println(r[2]);
    val x2 = vec![1.0, 2.0, 3.0, 4.0];
    val a0 = vec![1.0, 0.0 - 1.0];
    val a1v = vec![0.0, 2.0];
    val b0 = vec![3.0, 0.0 - 4.0];
    val b1v = vec![1.0, 0.0 - 1.0];
    val r2 = scaled_residual2(&x2, &a0, &a1v, &b0, &b1v, 2.0, 0.5);
    println(r2[0]);
    println(r2[1]);
    println(r2[2]);
    println(r2[3]);
}
