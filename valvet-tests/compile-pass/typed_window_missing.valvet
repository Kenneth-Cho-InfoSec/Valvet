fun empty_names(): Vec<String> { return vec![]; }
fun empty_cols(): Vec<Column> { return vec![]; }

fun unwrap_tf(r: Result<TypedFrame, String>): TypedFrame {
    match (r) {
        Ok(t) -> t,
        Err(e) -> { println(e); TypedFrame { names: empty_names(), cols: empty_cols(), nrows: 0 as Int64 } },
    }
}

fun show(t: &TypedFrame) {
    println(tf_names(t));
    println(tf_nrows(t));
    println(tf_kinds(t));
    var i = 0 as Int64;
    while (i < tf_names(t).len()) {
        val c = tf_col_at(t, i);
        match (c) {
            Some(col) -> println(col_strings(col)),
            None -> println("missing"),
        };
        i = i + (1 as Int64);
    }
}

fun show_opt_f(o: Option<Float64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_opt_i(o: Option<Int64>) {
    match (o) { Some(v) -> println(v), None -> println("NA") };
}

fun show_err(r: Result<TypedFrame, String>) {
    match (r) { Ok(t) -> show(&t), Err(e) -> println(e) };
}

fun base_frame(): TypedFrame {
    val ints: Vec<Missing<Int64>> = vec![Missing::Present(1 as Int64), Missing, Missing::Present(3 as Int64), Missing::Present(4 as Int64)];
    val floats: Vec<Missing<Float64>> = vec![Missing::Present(1.5), Missing, Missing::Present(2.5), Missing::Present(4.0)];
    val bools: Vec<Missing<Bool>> = vec![Missing::Present(true), Missing, Missing::Present(false), Missing::Present(true)];
    val strs: Vec<Missing<String>> = vec![Missing::Present("a".clone()), Missing, Missing::Present("".clone()), Missing::Present("c".clone())];
    val fac = parse_factor_col(vec!["a".clone(), "b".clone(), "a".clone(), "".clone()]);
    val cols: Vec<Column> = vec![Column::Int(ints), Column::Float(floats), Column::Bool(bools), Column::Str(strs), Column::Factor(fac)];
    val names: Vec<String> = vec!["i".clone(), "f".clone(), "b".clone(), "s".clone(), "g".clone()];
    return unwrap_tf(tf_new(names, cols, 4 as Int64));
}

fun win_frame(): TypedFrame {
    val part: Vec<Missing<String>> = vec![Missing::Present("a".clone()), Missing::Present("a".clone()), Missing::Present("b".clone()), Missing::Present("a".clone()), Missing::Present("b".clone()), Missing::Present("a".clone())];
    val ord: Vec<Missing<Int64>> = vec![Missing::Present(2 as Int64), Missing::Present(1 as Int64), Missing::Present(2 as Int64), Missing::Present(3 as Int64), Missing::Present(1 as Int64), Missing::Present(1 as Int64)];
    val x: Vec<Missing<Int64>> = vec![Missing::Present(20 as Int64), Missing::Present(10 as Int64), Missing::Present(5 as Int64), Missing, Missing::Present(7 as Int64), Missing::Present(30 as Int64)];
    val y: Vec<Missing<Float64>> = vec![Missing::Present(2.0), Missing::Present(1.0), Missing::Present(5.0), Missing, Missing::Present(7.0), Missing::Present(3.0)];
    val cols: Vec<Column> = vec![Column::Str(part), Column::Int(ord), Column::Int(x), Column::Float(y)];
    val names: Vec<String> = vec!["part".clone(), "ord".clone(), "x".clone(), "y".clone()];
    return unwrap_tf(tf_new(names, cols, 6 as Int64));
}

fun tie_frame(): TypedFrame {
    val part: Vec<Missing<String>> = vec![Missing::Present("a".clone()), Missing::Present("a".clone()), Missing::Present("a".clone()), Missing::Present("b".clone()), Missing::Present("b".clone()), Missing, Missing::Present("a".clone())];
    val x: Vec<Missing<Int64>> = vec![Missing::Present(10 as Int64), Missing::Present(10 as Int64), Missing::Present(20 as Int64), Missing::Present(5 as Int64), Missing, Missing::Present(7 as Int64), Missing];
    val cols: Vec<Column> = vec![Column::Str(part), Column::Int(x)];
    val names: Vec<String> = vec!["part".clone(), "x".clone()];
    return unwrap_tf(tf_new(names, cols, 7 as Int64));
}

fun empty_win_frame(): TypedFrame {
    val part: Vec<Missing<String>> = vec![];
    val ord: Vec<Missing<Int64>> = vec![];
    val x: Vec<Missing<Int64>> = vec![];
    val cols: Vec<Column> = vec![Column::Str(part), Column::Int(ord), Column::Int(x)];
    val names: Vec<String> = vec!["part".clone(), "ord".clone(), "x".clone()];
    return unwrap_tf(tf_new(names, cols, 0 as Int64));
}

fun main() {
    val f = tie_frame();
    val spec = window_spec(vec!["part".clone()], vec![sort_key("x".clone(), true)]);
    val f1 = unwrap_tf(tf_window_mutate(f, "rank".clone(), spec, WindowExpr::Rank("x".clone())));
    val spec2 = window_spec(vec!["part".clone()], vec![sort_key("x".clone(), true)]);
    val f2 = unwrap_tf(tf_window_mutate(f1, "lag".clone(), spec2, WindowExpr::Lag("x".clone(), 1 as Int64)));
    show(&f2);
}
