import std::plot::kde_auto_bandwidth;
import std::plot::kde_density;

fun main() {
    val d1: Vec<Float64> = vec![1.0, 2.0, 2.0, 3.0, 4.0, 8.0];
    val d2: Vec<Float64> = vec![-2.5, 0.125, 0.125, 3.75, 10.0, 10.0, 0.5];
    val one: Vec<Float64> = vec![0.1];
    val flat: Vec<Float64> = vec![5.0, 5.0, 5.0];
    println(kde_auto_bandwidth(d1.clone()));
    println(kde_auto_bandwidth(d2.clone()));
    println(kde_auto_bandwidth(one));
    println(kde_auto_bandwidth(flat));
    println(kde_density(d1.clone(), 2.0, 0.0));
    println(kde_density(d1.clone(), 2.0, 2.5));
    println(kde_density(d1.clone(), 2.0, 8.0));
    println(kde_density(d1.clone(), 0.0, 3.0));
    println(kde_density(d2.clone(), 0.0, -1.0));
    println(kde_density(d2.clone(), 0.0 - 3.0, 4.0));
}
