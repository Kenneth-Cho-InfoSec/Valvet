import std::csv::CsvTable;
import std::frame::frame_from_table;
import std::model::formula_parse;
import std::model::model_frame;
import std::model::lm;
fun go(): Int32 {
val h = vec!["g", "x", "y"]
val r0 = vec!["a", "1", "2.0"]
val r1 = vec!["a", "2", "4.1"]
val r2 = vec!["b", "1", "3.0"]
val r3 = vec!["b", "2", "5.2"]
val r4 = vec!["a", "3", "6.0"]
val r5 = vec!["b", "3", "7.1"]
val t = frame_from_table(CsvTable { header: h, rows: vec![r0, r1, r2, r3, r4, r5] })
let Some(fo) = formula_parse("y ~ x + g") else {
return 1
}
let Ok(mf) = model_frame(&t, fo) else {
return 1
}
let Ok(fit) = lm(mf) else {
return 1
}
println(fit.coef)
println(fit.names)
return 0
}
fun main() {
println(go())
}
