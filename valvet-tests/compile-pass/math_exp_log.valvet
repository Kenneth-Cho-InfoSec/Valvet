import std::math::exp;
import std::math::log;
import std::math::pow;

fun close(a: Float64, b: Float64): Bool {
    val d = if (a > b) { a - b } else { b - a }
    val m = if (b > 1.0) { b } else { 1.0 }
    d / m < 0.000000001
}

fun main() {
    println(exp(0.0) == 1.0)
    println(close(exp(1.0), 2.718281828459045))
    println(log(1.0) == 0.0)
    println(close(log(2.718281828459045), 1.0))
    println(close(exp(log(42.0)), 42.0))
    println(close(pow(2.0, 10.0), 1024.0))
    println(pow(5.0, 0.0) == 1.0)
}
