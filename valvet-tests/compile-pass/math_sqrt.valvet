import std::math::sqrt;

fun close(a: Float64, b: Float64): Bool {
    val d = if (a > b) { a - b } else { b - a }
    d < 0.000000001
}

fun main() {
    val s = sqrt(2.0)
    println(close(s * s, 2.0))
    println(sqrt(144.0) == 12.0)
    println(sqrt(0.25) == 0.5)
    println(sqrt(0.0) == 0.0)
    println(sqrt(1.0) == 1.0)
}
