// papers/mbrace_wordcount.valvet
// MBrace cloud workflows (Dzik et al., PLOS ONE 2013; papers/mbrace_cloudworkflows.fs):
// wordcount as a Balanced.reduceCombine-style job — per-partition reduce
// (local word-frequency tables, cf. `reducer`) followed by an ORDERED
// combine of the partition results (cf. `combiner`), mirroring the
// Cloud.Parallel fork/join structure of MBrace.Library.Cloud.
//
// DISCLOSURE: local emulation of Cloud.Parallel (no cluster). Valvet has no
// cluster runtime, so the "fork" below runs the P=4 partition reductions
// sequentially in one process and the "join" merges them in partition-index
// order (deterministic, as Cloud.Parallel's ordered combining). The only
// true parallel primitive used is `par_sum` (fixed blocks + ordered
// combining, bit-identical for every thread count) over the per-partition
// totals. Valvet has no Map type, so frequency tables are Vec<Entry> with
// linear search; Valvet has no Vec sort, so ranking uses a stable
// bubble pass over counts (ties keep first-appearance order).

struct Entry { word: String, count: Int64 }

fun neg1(): Int64 { (0 as Int64) - (1 as Int64) }

fun get_entry(t: &Vec<Entry>, i: Int64): Entry {
    match ((*t).get(i)) {
        Some(e) -> e,
        None -> Entry { word: "", count: 0 as Int64 },
    }
}

fun get_word(words: &Vec<String>, i: Int64): String {
    match ((*words).get(i)) {
        Some(w) -> w,
        None -> "",
    }
}

fun find_in(t: &Vec<Entry>, w: String): Int64 {
    var i = 0 as Int64
    while (i < (*t).len()) {
        val e = get_entry(t, i)
        if (e.word == w) {
            return i
        }
        i = i + (1 as Int64)
    }
    neg1()
}

fun add_count(a: Vec<Entry>, w: String, c: Int64): Vec<Entry> {
    var t = a
    val idx = find_in(&t, w.clone())
    if (idx == neg1()) {
        t.push(Entry { word: w, count: c })
        t
    } else {
        val e = get_entry(&t, idx)
        val old = e.count
        t[idx] = Entry { word: e.word, count: old + c }
        t
    }
}

// Fork phase: reduce one partition (words[s..e]) to a local table.
fun reduce_part(words: &Vec<String>, s: Int64, e: Int64): Vec<Entry> {
    var t: Vec<Entry> = vec![]
    var j = s
    while (j < e) {
        t = add_count(t, get_word(words, j), 1 as Int64)
        j = j + (1 as Int64)
    }
    t
}

// Join phase: ordered combine of one partition table into the total.
fun merge_into(dst: Vec<Entry>, src: &Vec<Entry>): Vec<Entry> {
    var t = dst
    var k = 0 as Int64
    while (k < (*src).len()) {
        val e = get_entry(src, k)
        val c = e.count
        t = add_count(t, e.word, c)
        k = k + (1 as Int64)
    }
    t
}

fun table_total(t: &Vec<Entry>): Int64 {
    var s = 0 as Int64
    var i = 0 as Int64
    while (i < (*t).len()) {
        s = s + get_entry(t, i).count
        i = i + (1 as Int64)
    }
    s
}

fun seq_sum(v: &Vec<Float64>): Float64 {
    var s = 0.0
    var i = 0 as Int64
    while (i < (*v).len()) {
        s = s + (*v)[i]
        i = i + (1 as Int64)
    }
    s
}

// Stable ranking pass: strictly-greater swaps keep first-appearance order.
fun sort_by_count(a: Vec<Entry>): Vec<Entry> {
    var t = a
    val n = t.len()
    var pass = 0 as Int64
    while (pass < n) {
        var i = 1 as Int64
        while (i < n - pass) {
            val x = get_entry(&t, i - (1 as Int64))
            val y = get_entry(&t, i)
            if (y.count > x.count) {
                t[i - (1 as Int64)] = y
                t[i] = x
            }
            i = i + (1 as Int64)
        }
        pass = pass + (1 as Int64)
    }
    t
}

fun main() {
    val text = "the cat sat on the mat and the dog sat on the rug the cat chased the dog and the dog chased the cat back home the mat was flat and the rug was soft the cat naps on the rug while the dog naps on the mat"
    val words = text.split(" ")
    val n = words.len()
    val p = 4 as Int64
    val chunk = (n + p - (1 as Int64)) / p
    // Fork: one local frequency table per partition (P=4).
    var combined: Vec<Entry> = vec![]
    var totals: Vec<Float64> = vec![]
    var pid = 0 as Int64
    while (pid < p) {
        val s = pid * chunk
        val e = if (s + chunk < n) { s + chunk } else { n }
        val local = reduce_part(&words, s, e)
        totals.push(table_total(&local) as Float64)
        // Join: ordered combine in partition-index order.
        combined = merge_into(combined, &local)
        pid = pid + (1 as Int64)
    }
    // Deterministic parallel reduction over per-partition totals.
    val ps = par_sum(totals.clone(), 4 as Int64)
    val ss = seq_sum(&totals)
    println("words=" + to_string(n))
    println("partitions=" + to_string(p))
    println("part0=" + to_string(totals[0]) + " part1=" + to_string(totals[1]) + " part2=" + to_string(totals[2]) + " part3=" + to_string(totals[3]))
    println("distinct=" + to_string(combined.len()))
    println("seq_sum=" + to_string(ss))
    println("par_sum=" + to_string(ps))
    println("sums_equal=" + to_string(ps == ss))
    val ranked = sort_by_count(combined)
    var i = 0 as Int64
    while (i < ranked.len()) {
        val e = get_entry(&ranked, i)
        println(e.word + ": " + to_string(e.count))
        i = i + (1 as Int64)
    }
}
