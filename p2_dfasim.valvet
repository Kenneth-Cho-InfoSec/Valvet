// papers/p2_dfasim.valvet
// Table-driven DFA simulation after Rabin & Scott ("Finite Automata and
// Their Decision Problems", 1959; subset construction turns the NFA into
// the tables below) and Thompson (1968), following papers/p2_dfasim.fs
// (FsLex table driver: state tables, class transitions, accept actions).
//
// Valvet mapping: tables as Vec<Vec<Int64>>; inputs are pre-classified
// Int64 vectors (Valvet strings have no char access, so the
// character→class mapping is done by hand in the test setup — disclosed).
// Recognizer: binary strings over {a=0, b=1, other=2} ending in "ab".
// Mirrored by papers/p2_dfasim_ref.py over identical tables.

// rows = states 0..3; cols = classes a,b,other. -1 = dead (unused here;
// state 3 is the explicit sink).
fun build_dfa(): Vec<Vec<Int64>> {
    var t: Vec<Vec<Int64>> = vec![];
    var s0: Vec<Int64> = vec![(1 as Int64), (0 as Int64), (3 as Int64)];
    var s1: Vec<Int64> = vec![(1 as Int64), (2 as Int64), (3 as Int64)];
    var s2: Vec<Int64> = vec![(1 as Int64), (0 as Int64), (3 as Int64)];
    var s3: Vec<Int64> = vec![(3 as Int64), (3 as Int64), (3 as Int64)];
    t.push(s0);
    t.push(s1);
    t.push(s2);
    t.push(s3);
    t
}

struct SimRes { accept: Bool, final: Int64 }

// -1 in input = end marker is NOT needed; length bounds the run.
fun dfa_run(t: &Vec<Vec<Int64>>, input: Vec<Int64>): SimRes {
    var st = 0 as Int64;
    var i = 0 as Int64;
    while (i < input.len()) {
        val cls = input[i];
        if (cls < (0 as Int64) || cls > (2 as Int64)) {
            st = 3 as Int64;
        } else {
            st = (*t)[st][cls];
        }
        i = i + (1 as Int64);
    }
    SimRes { accept: st == (2 as Int64), final: st }
}

fun run_case(t: &Vec<Vec<Int64>>, input: Vec<Int64>) {
    val r = dfa_run(t, input);
    if (r.accept) {
        println(r.final)
    } else {
        println((0 as Int64) - (100 as Int64) - r.final)
    }
}

fun mkv(a: Int64, b: Int64, c: Int64, d: Int64, e: Int64, n: Int64): Vec<Int64> {
    // fixed 5-cell inputs padded by n (n=0..5 real length via take below)
    var v: Vec<Int64> = vec![];
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v.push(e);
    var out: Vec<Int64> = vec![];
    var i = 0 as Int64;
    while (i < n) {
        out.push(v[i]);
        i = i + (1 as Int64);
    }
    out
}

fun main() {
    val t = build_dfa();
    // classes: a=0 b=1 other=2. accept (final 2) prints 2, else -100-final.
    run_case(&t, mkv(0 as Int64, 1 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 2 as Int64)); // ab -> 2
    run_case(&t, mkv(0 as Int64, 0 as Int64, 1 as Int64, 0 as Int64, 0 as Int64, 3 as Int64)); // aab -> 2
    run_case(&t, mkv(1 as Int64, 0 as Int64, 1 as Int64, 0 as Int64, 0 as Int64, 3 as Int64)); // bab -> 2
    run_case(&t, mkv(0 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 2 as Int64)); // aa -> -101
    run_case(&t, mkv(1 as Int64, 1 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 2 as Int64)); // bb -> -100
    run_case(&t, mkv(0 as Int64, 2 as Int64, 1 as Int64, 0 as Int64, 0 as Int64, 3 as Int64)); // a?b -> -103
    run_case(&t, mkv(1 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 1 as Int64)); // b -> -100
    run_case(&t, mkv(0 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 0 as Int64, 0 as Int64)); // empty -> -100
}
