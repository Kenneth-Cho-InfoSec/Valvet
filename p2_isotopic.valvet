// P2: Isotopic distributions — Rockwood ("Rapid Calculation of Isotope
// Distributions", Anal. Chem. 1995, Fourier-transform method) / Yergey
// ("A General Approach to Calculating Isotopic Distributions", Int. J.
// Mass Spectrom. 1983, multinomial-expansion method). Source read:
// papers/p2_isotopic.fs (BioFSharp IsotopicDistribution, 451 lines),
// which implements the BRAIN recursive algorithm and the MIDA
// polynomial-expansion algorithm whose core weight is the multinomial
// term n!/(n1!..nk!) * p1^n1 * .. * pk^nk (p2_isotopic.fs lines 153-171).
//
// Valvet mapping: first-order multinomial enumeration (no objects/HOFs)
// of methane CH4 with fixed isotope masses/abundances as literals:
//   C-12 12.0 / 0.9893, C-13 13.0033548378 / 0.0107
//   H-1 1.00782503223 / 0.999885, H-2 2.01410177812 / 0.000115
// Nested loops over C-13 count c in 0..=1 and H-2 count h in 0..=4 give
// all 10 mass bins; factorials are literals (fact4), H powers use
// repeated multiplication (pow_n) — +-*/ only. Prints mass then
// probability per bin (20 lines). Top bins: (c=0,h=0) monoisotopic
// ~16.0313 Da p~0.9887; (c=1,h=0) ~17.0347 Da p~0.0107;
// (c=0,h=1) ~17.0376 Da p~0.000455.
fun fact4(n: Int32): Float64 {
    if (n == 0) {
        1.0
    } else {
        if (n == 1) {
            1.0
        } else {
            if (n == 2) {
                2.0
            } else {
                if (n == 3) {
                    6.0
                } else {
                    24.0
                }
            }
        }
    }
}

fun pow_n(base: Float64, n: Int32): Float64 {
    var r = 1.0;
    var k = 0;
    while (k < n) {
        r = r * base;
        k += 1;
    }
    r
}

fun main() {
    val mc12 = 12.0;
    val mc13 = 13.0033548378;
    val mh1 = 1.00782503223;
    val mh2 = 2.01410177812;
    val pc12 = 0.9893;
    val pc13 = 0.0107;
    val ph1 = 0.999885;
    val ph2 = 0.000115;
    for (c in 0..=1) {
        for (h in 0..=4) {
            val cf = c as Float64;
            val hf = h as Float64;
            val mass = (1.0 - cf) * mc12 + cf * mc13 + (4.0 - hf) * mh1 + hf * mh2;
            val pc = if (c == 0) { pc12 } else { pc13 };
            val prob = 24.0 / (fact4(h) * fact4(4 - h)) * pc * pow_n(ph1, 4 - h) * pow_n(ph2, h);
            println(mass);
            println(prob);
        }
    }
}
